---
/**
 * Afsluitend podium met het merklint. Teksten komen van de pagina zelf, zodat
 * iedere pagina haar eigen, inhoudelijke uitnodiging houdt.
 */
import { Image } from 'astro:assets';
import ribbon from '../assets/brand/living-ribbon-wide.png';
import Icon from './Icon.astro';

interface Props {
  title: string;
  text?: string;
  primary: { label: string; href: string; external?: boolean };
  secondary?: { label: string; href: string; external?: boolean };
  /** Kleine geruststelling onder de knoppen (bijv. reactietijd). */
  note?: string;
  id?: string;
  /** Compacte variant zonder minimale hoogte. */
  compact?: boolean;
}
const { title, text, primary, secondary, note, id, compact = false } = Astro.props;
---

<section class="cta-band" aria-labelledby={id ?? 'cta-heading'}>
  <div class:list={['cta-band__stage stage stage--ink reveal-up', compact && 'is-compact']}>
    <Image
      src={ribbon}
      alt=""
      widths={[840, 1280, 1686]}
      sizes="(max-width: 700px) 220vw, 112vw"
      format="webp"
      quality="mid"
      class="cta-band__ribbon"
      aria-hidden="true"
    />
    <div class="cta-band__copy">
      <h2 id={id ?? 'cta-heading'} class="display-lg">{title}</h2>
      {text && <p class="lead">{text}</p>}
      <div class="cta-band__actions">
        <a
          href={primary.href}
          class:list={['btn btn--primary', primary.external && 'btn--up']}
          target={primary.external ? '_blank' : undefined}
          rel={primary.external ? 'noopener' : undefined}
        >
          {primary.label}
          <Icon name={primary.external ? 'arrowUpRight' : 'arrowRight'} size={18} />
        </a>
        {
          secondary && (
            <a
              href={secondary.href}
              class:list={['btn btn--outline-light', secondary.external && 'btn--up']}
              target={secondary.external ? '_blank' : undefined}
              rel={secondary.external ? 'noopener' : undefined}
            >
              {secondary.label}
              <Icon name={secondary.external ? 'arrowUpRight' : 'arrowRight'} size={18} />
            </a>
          )
        }
      </div>
      {note && <p class="cta-band__note">{note}</p>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: 0 var(--spacing-gutter) var(--spacing-gutter);
  }
  .cta-band__stage {
    width: min(100%, 92rem);
    min-height: min(42rem, 76svh);
    margin-inline: auto;
  }
  .cta-band__stage.is-compact {
    min-height: 0;
  }
  .cta-band__stage::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: '';
    background: radial-gradient(60rem 40rem at 10% 100%, var(--vermilion-glow) 0%, transparent 60%);
    opacity: 0.45;
  }
  .cta-band__copy {
    position: relative;
    z-index: 2;
    max-width: 54rem;
    padding: clamp(3.5rem, 8vw, 7.5rem) clamp(1.5rem, 6vw, 6rem);
  }
  .cta-band__copy h2 {
    color: var(--stage-ink);
  }
  .cta-band__copy .lead {
    max-width: 36rem;
    margin-top: 1.75rem;
    color: var(--stage-soft);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .cta-band__note {
    margin-top: 1.1rem;
    color: var(--stage-soft);
    font-size: 0.86rem;
  }
  .cta-band__ribbon {
    position: absolute;
    z-index: 1;
    right: -9%;
    bottom: -40%;
    width: 110%;
    max-width: none;
    transform: rotate(-5deg);
    pointer-events: none;
    opacity: 0.95;
  }
  .is-compact .cta-band__ribbon {
    right: -16%;
    bottom: -58%;
    width: 84%;
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cta-band__ribbon {
        animation: ribbon-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 60%;
      }
    }
  }
  @keyframes ribbon-rise {
    from {
      transform: translate3d(4%, 10%, 0) rotate(-7deg);
    }
    to {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }
  }
  @media (max-width: 700px) {
    .cta-band__stage {
      min-height: 40rem;
    }
    .cta-band__copy {
      padding: 3.25rem 1.5rem;
    }
    .cta-band__actions > a {
      flex: 1 1 12rem;
    }
    .cta-band__ribbon {
      right: -74%;
      bottom: -26%;
      width: 224%;
    }
  }
</style>
