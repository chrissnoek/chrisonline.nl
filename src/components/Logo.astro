---
import { SITE } from '../config/site';
import BrandMark from './BrandMark.astro';

interface Props {
  /** Hoogte van het beeldmerk in pixels; het woordmerk schaalt mee. */
  height?: number;
  class?: string;
  /** Laat het beeldmerk meedraaien met de scrollpositie (alleen in de header). */
  spin?: boolean;
  /** Lichte variant voor donkere vlakken (het woordmerk erft anders de tekstkleur). */
  inverse?: boolean;
}

const { height = 30, class: className, spin = false, inverse = false } = Astro.props;
---

<span
  class:list={['brand-lockup', inverse && 'brand-lockup--inverse', className]}
  style={`--logo-h:${height}px`}
>
  <span class:list={['brand-lockup__mark', spin && 'spin-with-scroll']}>
    <BrandMark size={height} />
  </span>
  <span class="brand-lockup__name">{SITE.brand}</span>
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-h) * 0.3);
    color: inherit;
    font-size: calc(var(--logo-h) * 0.5);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }
  .brand-lockup--inverse {
    color: #fff;
  }
  .brand-lockup__mark {
    display: block;
    flex: none;
    color: var(--vermilion);
  }
</style>
