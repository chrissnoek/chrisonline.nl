---
/**
 * Toegankelijk contactformulier met live validatie en AJAX-submit naar
 * Netlify Forms. Server-gerenderde markup met een klein vanilla-script.
 * Netlify detecteert het formulier bij de build via het blueprint-form in
 * contact.astro (zelfde form-naam "contact").
 */
import Icon from './Icon.astro';
---

<div id="contact-form-root">
  <!-- Succes-status (verborgen tot een geslaagde submit) -->
  <div id="cf-success" class="cf-success" role="status" aria-live="polite" hidden>
    <span class="cf-success__mark enter-pop"><Icon name="check" size={26} /></span>
    <p class="cf-success__title display-sm">Bedankt voor je bericht!</p>
    <p class="muted">Ik neem zo snel mogelijk contact met je op, meestal binnen één werkdag.</p>
    <button type="button" id="cf-again" class="btn btn--line btn--sm">Nog een bericht sturen</button
    >
  </div>

  <form
    id="cf-form"
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="cf-form"
    novalidate
  >
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" id="cf-source-page" name="source_page" value="" />
    <input type="hidden" id="cf-referrer" name="referrer" value="" />
    <input type="hidden" id="cf-utm-source" name="utm_source" value="" />
    <input type="hidden" id="cf-utm-medium" name="utm_medium" value="" />
    <input type="hidden" id="cf-utm-campaign" name="utm_campaign" value="" />
    <input type="hidden" id="cf-utm-term" name="utm_term" value="" />

    <!-- Honeypot: verborgen voor mensen -->
    <p class="visually-hidden" aria-hidden="true">
      <label>Niet invullen: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="field">
      <label for="cf-name">Naam</label>
      <input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        class="input"
        placeholder="Je naam"
      />
      <p id="cf-name-error" class="field__error" hidden></p>
    </div>

    <div class="field">
      <label for="cf-email">E-mailadres</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        class="input"
        placeholder="naam@voorbeeld.nl"
      />
      <p id="cf-email-error" class="field__error" hidden></p>
    </div>

    <div class="field">
      <label for="cf-message">Bericht</label>
      <textarea
        id="cf-message"
        name="message"
        rows="6"
        required
        class="input"
        placeholder="Vertel kort over je assortiment, huidige platform en wat je wilt verbeteren…"
      ></textarea>
      <p id="cf-message-error" class="field__error" hidden></p>
    </div>

    <div class="cf-form__actions">
      <button type="submit" id="cf-submit" class="btn btn--primary">
        Verstuur bericht
        <Icon name="arrowRight" size={18} />
      </button>
      <p class="cf-form__note">Meestal binnen één werkdag een persoonlijke reactie.</p>
      <p id="cf-fail" class="field__error" role="alert" hidden>
        Er ging iets mis. Probeer het later opnieuw of mail direct.
      </p>
    </div>
  </form>
</div>

<script>
  function initContactForm() {
    const form = document.getElementById('cf-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const success = document.getElementById('cf-success')!;
    const again = document.getElementById('cf-again')!;
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
    const submitLabel = submitBtn.innerHTML;
    const fail = document.getElementById('cf-fail')!;

    type Field = 'name' | 'email' | 'message';
    const fields: Field[] = ['name', 'email', 'message'];
    const input = (f: Field) =>
      document.getElementById(`cf-${f}`) as HTMLInputElement | HTMLTextAreaElement;
    const errorEl = (f: Field) => document.getElementById(`cf-${f}-error`)!;
    const touched = new Set<Field>();

    // Een CTA vanaf een dienstpagina mag het gesprek alvast context geven.
    const params = new URLSearchParams(window.location.search);
    const service = params.get('dienst');
    const question = params.get('vraag');
    if (service === 'automatisering' && !input('message').value) {
      input('message').value =
        'Ik wil graag bespreken welke terugkerende taken in mijn bedrijf geautomatiseerd kunnen worden.\n\nDe taak die nu veel tijd kost is: ';
    }
    if (service === 'shopify' && !input('message').value) {
      const prompts: Record<string, string> = {
        migratie:
          'Ik wil een mogelijke migratie naar Shopify bespreken.\n\nHuidig platform: \nAantal producten: \nBelangrijke koppelingen: \nWat ik wil verbeteren: ',
        onderhoud:
          'Ik zoek hulp bij onderhoud en doorontwikkeling van mijn Shopify-webshop.\n\nWebshop-URL: \nHuidig thema: \nWat er nu nodig is: \nGewenste frequentie: ',
        'noord-holland':
          'Ik zoek een Shopify-specialist in Noord-Holland.\n\nMijn bedrijf is gevestigd in: \nHuidig platform: \nWat ik wil laten maken of verbeteren: ',
      };
      input('message').value =
        (question && prompts[question]) ||
        'Ik wil graag mijn Shopify-webshop bespreken.\n\nHuidig platform: \nWat ik verkoop: \nWat ik wil verbeteren: ';
    }

    // Eerste-partij broninformatie wordt alleen met de vrijwillige aanvraag
    // meegestuurd. Er worden hiervoor geen trackingcookies of profielen aangemaakt.
    const setHidden = (id: string, value: string) => {
      const field = document.getElementById(id) as HTMLInputElement | null;
      if (field) field.value = value.slice(0, 500);
    };
    setHidden('cf-source-page', window.location.href);
    setHidden('cf-referrer', document.referrer);
    setHidden('cf-utm-source', params.get('utm_source') || '');
    setHidden('cf-utm-medium', params.get('utm_medium') || '');
    setHidden('cf-utm-campaign', params.get('utm_campaign') || '');
    setHidden('cf-utm-term', params.get('utm_term') || '');

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    function validate(f: Field): string {
      const v = input(f).value;
      if (f === 'name') return v.trim().length < 2 ? 'Vul je naam in.' : '';
      if (f === 'email')
        return !v
          ? 'Vul je e-mailadres in.'
          : !EMAIL_RE.test(v)
            ? 'Vul een geldig e-mailadres in.'
            : '';
      return v.trim().length < 10 ? 'Schrijf een bericht van minimaal 10 tekens.' : '';
    }

    function render(f: Field) {
      const msg = touched.has(f) ? validate(f) : '';
      errorEl(f).textContent = msg;
      errorEl(f).hidden = !msg;
      input(f).setAttribute('aria-invalid', String(!!msg));
      if (msg) input(f).setAttribute('aria-describedby', `cf-${f}-error`);
      else input(f).removeAttribute('aria-describedby');
    }

    for (const f of fields) {
      input(f).addEventListener('blur', () => {
        touched.add(f);
        render(f);
      });
      input(f).addEventListener('input', () => render(f));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fields.forEach((f) => touched.add(f));
      fields.forEach(render);
      const honeypot = form.querySelector<HTMLInputElement>('[name="bot-field"]');
      if (fields.some((f) => validate(f)) || honeypot?.value) {
        const first = fields.find((f) => validate(f));
        if (first) input(first).focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Versturen…';
      fail.hidden = true;

      const data = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        if (key !== 'bot-field' && typeof value === 'string') data.append(key, value);
      }

      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: data.toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        touched.clear();
        fields.forEach(render);
        form.hidden = true;
        success.hidden = false;
        window.dispatchEvent(
          new CustomEvent('co:lead-submitted', { detail: { form_name: 'contact' } }),
        );
      } catch {
        fail.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = submitLabel;
      }
    });

    again.addEventListener('click', () => {
      success.hidden = true;
      form.hidden = false;
      input('name').focus();
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .cf-form {
    display: grid;
    gap: 1.25rem;
  }
  .cf-form[hidden],
  .cf-success[hidden] {
    display: none;
  }
  .cf-form__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cf-form__actions .btn {
    justify-self: start;
  }
  .cf-form__note {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .cf-success {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding: 1rem 0;
  }
  .cf-success__mark {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--vermilion);
    color: #fff;
  }
  .cf-success .btn {
    margin-top: 0.5rem;
  }
  @media (max-width: 600px) {
    .cf-form__actions .btn {
      justify-self: stretch;
    }
  }
</style>
