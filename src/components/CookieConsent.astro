---
import { ANALYTICS } from '../config/analytics';
import type { AppLocale } from '../config/app-locales';
interface Props {
  lang?: AppLocale;
}
const { lang = 'nl' } = Astro.props;
const english = lang === 'en';
---

<!--
  Geen tagmanager-snippet in de <head>: zo is er vóór toestemming ook geen
  verzoek naar Google. Dit is bewust een "basic consent"-implementatie.
-->
<aside
  id="cookie-consent"
  class="cookie-consent"
  aria-label={english ? 'Cookie preferences' : 'Cookievoorkeuren'}
  hidden
>
  <div class="cookie-consent__mark" aria-hidden="true">CO</div>
  <div class="cookie-consent__copy">
    <p class="cookie-consent__title">
      {english ? 'You choose what we measure.' : 'Jij kiest wat we meten.'}
    </p>
    <p>
      {
        english
          ? 'With your permission, we use Google Analytics to understand which pages and enquiries work. Without permission, we do not measure anything.'
          : 'Met jouw toestemming gebruiken we Google Analytics om te zien welke pagina’s en aanvragen werken. Zonder toestemming meten we niets.'
      }
      <a href="/privacy"
        >{
          english
            ? 'Read our privacy and cookie policy (Dutch)'
            : 'Lees ons privacy- en cookiebeleid'
        }</a
      >.
    </p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-consent__decline" data-consent-choice="denied">
      {english ? 'Necessary only' : 'Alleen noodzakelijk'}
    </button>
    <button type="button" class="cookie-consent__accept" data-consent-choice="granted">
      {english ? 'Allow analytics' : 'Analyse toestaan'}
    </button>
  </div>
</aside>

<script
  is:inline
  define:vars={{
    containerId: ANALYTICS.googleTagManagerId,
    cookieName: ANALYTICS.consentCookieName,
    cookieMaxAge: ANALYTICS.consentCookieMaxAge,
  }}
>
  function readConsent() {
    const encoded = document.cookie
      .split('; ')
      .find((part) => part.startsWith(`${cookieName}=`))
      ?.split('=')
      .slice(1)
      .join('=');
    if (!encoded) return null;
    try {
      const stored = JSON.parse(decodeURIComponent(encoded));
      return stored?.analytics === 'granted'
        ? 'granted'
        : stored?.analytics === 'denied'
          ? 'denied'
          : null;
    } catch {
      return null;
    }
  }

  function saveConsent(choice) {
    const value = encodeURIComponent(JSON.stringify({ analytics: choice, version: 1 }));
    document.cookie = `${cookieName}=${value}; Max-Age=${cookieMaxAge}; Path=/; SameSite=Lax; Secure`;
  }

  // Google Consent Mode krijgt altijd eerst de beperkende standaard. De
  // container wordt pas hierna en alleen bij analyse-toestemming geladen.
  window.dataLayer = window.dataLayer || [];
  window.gtag =
    window.gtag ||
    function () {
      // eslint-disable-next-line prefer-rest-params -- GTM verwerkt het native arguments-object.
      window.dataLayer?.push(arguments);
    };
  window.gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
  });

  function loadAnalytics() {
    if (document.querySelector(`script[data-gtm-container="${containerId}"]`)) return;
    window.coAnalyticsGranted = true;
    window.gtag?.('consent', 'update', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    // Zelfde start-event als in het standaard GTM-fragment. Zonder dit event
    // krijgt de "Initialization - All Pages"-trigger geen kans om de GA4-tag
    // te activeren wanneer de container pas na toestemming wordt geladen.
    window.dataLayer?.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    const tag = document.createElement('script');
    tag.async = true;
    tag.dataset.gtmContainer = containerId;
    tag.src = `https://www.googletagmanager.com/gtm.js?id=${containerId}`;
    document.head.appendChild(tag);
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent');
    if (!banner) return;

    // De footer wordt bij Astro View Transitions vervangen. Delegatie houdt de
    // knop "Cookiekeuze" daarom ook na interne navigatie werkend.
    if (!document.documentElement.dataset.cookieSettingsBound) {
      document.documentElement.dataset.cookieSettingsBound = 'true';
      document.addEventListener('click', (event) => {
        const target = event.target.closest('[data-cookie-settings]');
        if (!target) return;
        event.preventDefault();
        window.coOpenCookieSettings?.();
      });
    }

    if (banner.dataset.bound) return;
    banner.dataset.bound = 'true';

    const apply = (choice) => {
      saveConsent(choice);
      if (choice === 'granted') loadAnalytics();
      else window.coAnalyticsGranted = false;
      banner.hidden = true;
    };

    banner.querySelectorAll('[data-consent-choice]').forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.consentChoice));
    });

    window.coOpenCookieSettings = () => {
      banner.hidden = false;
      banner.querySelector('[data-consent-choice="granted"]')?.focus();
    };

    const existing = readConsent();
    if (existing === 'granted') loadAnalytics();
    else if (existing === 'denied') window.coAnalyticsGranted = false;
    else banner.hidden = false;

    window.addEventListener('co:lead-submitted', (event) => {
      if (!window.coAnalyticsGranted) return;
      const detail = event.detail || {};
      window.gtag?.('event', 'generate_lead', {
        form_name: detail.form_name || 'contact',
      });
    });
  }

  document.addEventListener('astro:page-load', initCookieConsent);
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 70;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    max-width: 46rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    margin-inline: auto;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--paper-raised) 94%, transparent);
    box-shadow: var(--shadow-lift);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cookie-consent:not([hidden]) {
      animation: enter-up 0.6s var(--ease-out-soft) both;
      animation-delay: 0.8s;
    }
  }

  .cookie-consent__mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.7rem;
    background: var(--vermilion);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .cookie-consent__copy {
    max-width: 32rem;
  }
  .cookie-consent__copy p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.5;
  }
  .cookie-consent__copy .cookie-consent__title {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 650;
  }
  .cookie-consent__copy a {
    color: var(--vermilion-ink);
    text-underline-offset: 0.15em;
  }
  .cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .cookie-consent__actions button {
    min-height: 2.5rem;
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 180ms ease;
  }
  .cookie-consent__decline {
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .cookie-consent__accept {
    background: var(--ink);
    color: var(--paper);
  }
  .cookie-consent__accept:hover {
    background: var(--vermilion);
    color: #fff;
  }

  @media (max-width: 680px) {
    .cookie-consent {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .cookie-consent__actions {
      grid-column: 1 / -1;
      justify-content: flex-end;
    }
  }

  @media (max-width: 380px) {
    .cookie-consent__actions {
      align-items: stretch;
      flex-direction: column-reverse;
    }
  }
</style>
