---
/**
 * Beeldmerk: vier stroken die elkaar in het midden kruisen — een ster, een
 * kompas, een kruispunt van design, development en onderhoud. Tekent met
 * currentColor zodat het op papier én op donkere podia werkt.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="4.2"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path d="M24 4v40M4 24h40M9.86 9.86l28.28 28.28M38.14 9.86 9.86 38.14"></path>
</svg>

<style>
  .brand-mark {
    display: block;
    flex: none;
    overflow: visible;
    transform-origin: 50% 50%;
  }
</style>
