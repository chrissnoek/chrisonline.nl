---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Optioneel adresbalk-label (bijv. een domein). */
  url?: string;
  /** Laad eager voor above-the-fold beelden. */
  eager?: boolean;
}

const { src, alt, url, eager = false } = Astro.props;
---

<figure class="browser-frame frame">
  <div class="browser-frame__chrome" aria-hidden="true">
    <span class="browser-frame__dots"><i></i><i></i><i></i></span>
    {url && <span class="browser-frame__url">{url}</span>}
  </div>
  <div class="browser-frame__screen">
    <Image
      src={src}
      alt={alt}
      widths={[420, 640, 840]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 420px"
      format="avif"
      quality="mid"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <figcaption class="visually-hidden">{alt}</figcaption>
</figure>

<style>
  .browser-frame {
    margin: 0;
    background: var(--paper-raised);
    transition: box-shadow 300ms var(--ease-out-soft);
  }
  .browser-frame:hover {
    box-shadow: var(--shadow-soft);
  }
  .browser-frame__chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .browser-frame__dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .browser-frame__dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .browser-frame__url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 0.2rem 0.75rem;
    border-radius: 0.4rem;
    background: var(--paper-raised);
    color: var(--ink-soft);
    font-size: 0.75rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser-frame__screen {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #fff;
  }
  .browser-frame__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: object-position 1400ms var(--ease-in-out-soft);
  }
  .browser-frame:hover .browser-frame__screen img {
    object-position: bottom;
  }
  @media (max-width: 480px) {
    .browser-frame__url {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .browser-frame__screen img {
      transition: none;
    }
  }
</style>
