---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHeading from '../SectionHeading.astro';
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';
import { SITE } from '../../config/site';
import { breadcrumbLd, faqLd } from '../../lib/seo';

interface ContentItem {
  title: string;
  text: string;
}

interface CaseItem extends ContentItem {
  href: string;
  linkLabel: string;
}

interface RelatedItem {
  title: string;
  text: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  meta: string;
  headline: string;
  lead: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  signalsTitle: string;
  signals: string[];
  introTitle: string;
  introText: string;
  fit: ContentItem[];
  deliverablesTitle: string;
  deliverablesIntro: string;
  deliverables: ContentItem[];
  processTitle?: string;
  processIntro?: string;
  process: ContentItem[];
  cases?: CaseItem[];
  faqs: { question: string; answer: string }[];
  related: RelatedItem[];
  serviceName: string;
  serviceType: string;
  areaServed?: string | string[];
}

const {
  title,
  description,
  meta,
  headline,
  lead,
  primaryLabel = 'Bespreek je Shopify-project',
  primaryHref = '/contact?dienst=shopify#contactformulier',
  secondaryLabel = 'Bekijk relevante ervaring',
  secondaryHref = '/#werk',
  signalsTitle,
  signals,
  introTitle,
  introText,
  fit,
  deliverablesTitle,
  deliverablesIntro,
  deliverables,
  processTitle = 'Van eerste vraag naar een beheersbare livegang.',
  processIntro = 'Je weet steeds welke keuze voorligt, wat ik oplever en wat de volgende stap is. Zo blijft een maatwerktraject overzichtelijk.',
  process,
  cases = [],
  faqs,
  related,
  serviceName,
  serviceType,
  areaServed = 'Nederland',
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const normalizedAreas = (Array.isArray(areaServed) ? areaServed : [areaServed]).map((name) => ({
  '@type': name === 'Nederland' ? 'Country' : 'AdministrativeArea',
  name,
}));

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: serviceName,
  serviceType,
  description,
  url: pageUrl,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: normalizedAreas,
};

const crumbs = [{ label: 'Home', href: '/' }, { label: title }];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[serviceLd, faqLd(faqs), breadcrumbLd(crumbs, Astro.url.pathname)]}
>
  <article class="landing">
    <section class="landing-hero" aria-labelledby="shopify-page-title">
      <div class="shell shell--wide">
        <div class="landing-hero__stage stage">
          <span class="sun" aria-hidden="true"></span>

          <div class="landing-hero__copy">
            <Breadcrumbs items={crumbs} class="landing-hero__crumbs enter-up" />
            <p class="kicker enter-up" style="--enter-delay: 0.06s">{meta}</p>
            <h1 id="shopify-page-title" class="display-xl enter-up" style="--enter-delay: 0.12s">
              {headline}
            </h1>
            <p class="lead enter-up" style="--enter-delay: 0.2s">{lead}</p>
            <div class="landing-hero__actions enter-up" style="--enter-delay: 0.28s">
              <a href={primaryHref} class="btn btn--primary">
                {primaryLabel}
                <Icon name="arrowRight" size={18} />
              </a>
              <a href={secondaryHref} class="btn btn--line">
                {secondaryLabel}
              </a>
            </div>
            <p class="landing-hero__response meta enter-up" style="--enter-delay: 0.34s">
              Meestal binnen één werkdag een persoonlijke reactie.
            </p>
          </div>

          <aside
            class="route-panel enter-up"
            style="--enter-delay: 0.22s"
            aria-labelledby="route-panel-title"
          >
            <h2 id="route-panel-title">{signalsTitle}</h2>
            <ul class="route-panel__signals">
              {
                signals.map((signal) => (
                  <li>
                    <Icon name="check" size={17} />
                    <span>{signal}</span>
                  </li>
                ))
              }
            </ul>
            <p class="route-panel__path" aria-hidden="true">
              <span>Verhaal</span>
              <Icon name="arrowRight" size={14} />
              <span>Kooproute</span>
              <Icon name="arrowRight" size={14} />
              <span>Techniek</span>
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="section landing-intro" aria-labelledby="intro-title">
      <div class="shell landing-intro__grid">
        <h2 id="intro-title" class="display-md lift-in">{introTitle}</h2>
        <div class="reveal-up">
          <p class="lead">{introText}</p>
          <div class="fit-list">
            {
              fit.map((item) => (
                <section class="fit-list__item">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="landing-deliverables" aria-labelledby="deliverables-title">
      <div class="shell shell--wide">
        <div class="stage stage--ink landing-deliverables__stage">
          <SectionHeading
            id="deliverables-title"
            title={deliverablesTitle}
            lead={deliverablesIntro}
            tone="stage"
            split
          />
          <div class="deliverable-grid reveal-up">
            {
              deliverables.map((item) => (
                <section class="deliverable">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </section>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      cases.length > 0 && (
        <section class="section" aria-labelledby="proof-title">
          <div class="shell">
            <SectionHeading
              id="proof-title"
              title="Relevant werk, geen losse beloftes."
              lead="Bekijk hoe merkverhaal, complexe keuzeprocessen en frontend-development in echte projecten samenkomen."
              split
            />
            <div class="case-list rows reveal-up">
              {cases.map((item) => (
                <a href={item.href} class="case-link">
                  <span class="case-link__copy">
                    <strong class="display-sm">{item.title}</strong>
                    <span>{item.text}</span>
                  </span>
                  <span class="case-link__action link-arrow link-arrow--up link-arrow--accent">
                    {item.linkLabel}
                    <Icon name="arrowUpRight" size={18} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="section section--deep" aria-labelledby="process-title">
      <div class="shell">
        <SectionHeading id="process-title" title={processTitle} lead={processIntro} split />
        <ol class="process-steps reveal-up">
          {
            process.map((item) => (
              <li class="process-step">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="shell landing-faq">
        <div class="landing-faq__intro lift-in">
          <h2 id="faq-title" class="display-md">
            Vragen die vaak vóór een goed Shopify-traject komen.
          </h2>
          <p class="lead">
            Staat je vraag er niet bij? Stel hem op de homepage aan de Shopify-assistent of stuur
            hem direct mee in je aanvraag.
          </p>
        </div>
        <div class="reveal-up">
          <Faq items={faqs} />
        </div>
      </div>
    </section>

    <section class="section landing-related" aria-labelledby="related-title">
      <div class="shell">
        <h2 id="related-title" class="display-md lift-in">Kies de route die bij je vraag past.</h2>
        <div class="related-grid reveal-up">
          {
            related.map((item) => (
              <a href={item.href} class="related-link surface surface--deep">
                <strong>{item.title}</strong>
                <span>{item.text}</span>
                <Icon name="arrowRight" size={18} />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      id="shopify-cta-title"
      title="Vertel waar je webshop nu vastloopt."
      text="Je hoeft de oplossing nog niet te kennen. Beschrijf je assortiment, huidige platform en ambitie; ik help de juiste eerste stap afbakenen."
      primary={{ label: primaryLabel, href: primaryHref }}
      note="Meestal binnen één werkdag een persoonlijke reactie."
      compact
    />
  </article>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .landing-hero {
    padding: 0.5rem 0 0;
  }
  .landing-hero__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 5vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .landing-hero__copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }
  .landing-hero__crumbs {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .landing-hero__copy .kicker {
    margin-bottom: 1.25rem;
  }
  .landing-hero__copy h1 {
    max-width: 19ch;
    color: var(--ink);
    font-size: clamp(2.8rem, 1rem + 4.3vw, 5.8rem);
  }
  .landing-hero__copy .lead {
    max-width: 40rem;
    margin-top: 1.75rem;
  }
  .landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .landing-hero__response {
    margin-top: 1rem;
  }

  /* Routepaneel: welke situaties dit traject past, en de route erachter. */
  .route-panel {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-radius: var(--radius-card);
    background: var(--paper-raised);
    box-shadow: var(--shadow-soft);
  }
  .route-panel h2 {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .route-panel__signals {
    display: grid;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }
  .route-panel__signals li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .route-panel__signals li :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--vermilion-ink);
  }
  .route-panel__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .route-panel__path :global(svg) {
    color: var(--vermilion);
  }

  /* ── Intro + fit ────────────────────────────────────────────────────────── */
  .landing-intro__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
  }
  .landing-intro__grid h2 {
    max-width: 14ch;
  }
  .fit-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2.5rem;
    margin-top: 2.75rem;
  }
  .fit-list__item h3 {
    font-size: 1.12rem;
  }
  .fit-list__item p,
  .deliverable p,
  .process-step p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  /* ── Opleveringen (donker podium) ───────────────────────────────────────── */
  .landing-deliverables {
    padding: 0 0 var(--spacing-section);
  }
  .landing-deliverables__stage {
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 5vw, 5.5rem);
  }
  .deliverable-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .deliverable {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-card);
    background: var(--stage-raised);
  }
  .deliverable h3 {
    color: var(--stage-ink);
    font-size: 1.15rem;
  }
  .deliverable p {
    max-width: 32rem;
    color: var(--stage-soft);
  }

  /* ── Cases ──────────────────────────────────────────────────────────────── */
  .case-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .case-link {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    color: var(--ink);
    text-decoration: none;
  }
  .case-link__copy {
    display: grid;
    gap: 0.6rem;
  }
  .case-link__copy strong {
    font-weight: 400;
    transition: color 200ms ease;
  }
  .case-link__copy > span {
    max-width: 44rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .case-link__action {
    flex: none;
  }
  .case-link:hover strong,
  .case-link:focus-visible strong {
    color: var(--vermilion-ink);
  }

  /* ── Proces: stappen in leesvolgorde, zonder nummerornament ─────────────── */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .process-step {
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  .process-step h3 {
    font-size: 1.12rem;
  }

  /* ── FAQ ────────────────────────────────────────────────────────────────── */
  .landing-faq {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
  }
  .landing-faq__intro h2 {
    max-width: 14ch;
  }
  .landing-faq__intro .lead {
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }

  /* ── Gerelateerde routes ────────────────────────────────────────────────── */
  .landing-related {
    padding-top: 0;
  }
  .landing-related h2 {
    max-width: 14ch;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .related-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    gap: 0.6rem 1rem;
    min-height: 12rem;
    padding: 1.5rem;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 220ms var(--ease-out-soft),
      background-color 220ms ease;
  }
  .related-link strong {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .related-link > span {
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .related-link :global(svg) {
    grid-row: 1 / 3;
    grid-column: 2;
    transition: transform 240ms var(--ease-out-soft);
  }
  .related-link:hover,
  .related-link:focus-visible {
    background: var(--paper-raised);
    transform: translateY(-3px);
  }
  .related-link:hover :global(svg),
  .related-link:focus-visible :global(svg) {
    color: var(--vermilion-ink);
    transform: translateX(4px);
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .landing-hero__stage {
      grid-template-columns: 1fr;
    }
    .route-panel {
      max-width: 36rem;
    }
    .landing-intro__grid,
    .landing-faq {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .process-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .related-link {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .landing-hero__stage {
      padding: 1.5rem 1.25rem 1.5rem;
    }
    .landing-hero__copy h1 {
      font-size: clamp(2.5rem, 10.5vw, 3.7rem);
    }
    .landing-hero__actions > a {
      width: 100%;
    }
    .fit-list,
    .deliverable-grid,
    .process-steps {
      grid-template-columns: 1fr;
    }
    .landing-deliverables__stage {
      padding: 2.5rem 1.25rem;
    }
    .case-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
