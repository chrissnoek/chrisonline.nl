---
import { Image } from 'astro:assets';
import ribbon from '../../assets/brand/living-ribbon.png';
import Icon from '../Icon.astro';

const phases = [
  {
    id: 'design',
    title: 'Design',
    heading: 'Eerst het verhaal. Dan pas het scherm.',
    text: 'Ik ontrafel wat je merk bijzonder maakt en vertaal dat naar een heldere structuur, een onderscheidend visueel systeem en interacties die betekenis hebben.',
    details: ['Strategie en positionering', 'UX, UI en prototypes', 'Een schaalbaar designsysteem'],
  },
  {
    id: 'develop',
    title: 'Develop',
    heading: 'Een frontend die niet stil blijft staan.',
    text: 'Het ontwerp komt tot leven in schone, toegankelijke code. Snel op ieder scherm, soepel in beweging en praktisch te beheren.',
    details: ['Maatwerk frontend', 'Performance en toegankelijkheid', 'CMS en slimme koppelingen'],
  },
  {
    id: 'maintain',
    title: 'Maintain',
    heading: 'Na de livegang begint het echte leren.',
    text: 'Ik blijf betrokken. We meten wat er gebeurt, verbeteren wat beter kan en laten de ervaring meegroeien met je merk en je organisatie.',
    details: ['Doorontwikkeling', 'Optimalisatie en analytics', 'Persoonlijk technisch beheer'],
  },
];
---

<section id="werkwijze" class="process-section scroll-mt-24" aria-labelledby="process-heading">
  <div class="process-shell">
    <div class="process-intro reveal-up">
      <p>Van idee tot blijvende voorsprong.</p>
      <h2 id="process-heading">Design. Develop. Maintain.</h2>
      <p>
        Geen overdrachten tussen afdelingen. Je werkt rechtstreeks met mij—met één lijn van het
        eerste gesprek tot de volgende verbetering.
      </p>
    </div>

    <div class="process-layout">
      <nav class="process-tabs" aria-label="Fasen van mijn werkwijze">
        {
          phases.map((phase, index) => (
            <a
              href={`#process-panel-${phase.id}`}
              class:list={['process-tab', index === 0 && 'is-active']}
              data-process-tab={phase.id}
              aria-current={index === 0 ? 'step' : undefined}
            >
              <span>{phase.title}</span>
              <Icon name="arrowDown" size={18} />
            </a>
          ))
        }
      </nav>

      <div class="process-panels">
        {
          phases.map((phase, index) => (
            <article
              id={`process-panel-${phase.id}`}
              class:list={['process-panel', index === 0 && 'is-active']}
              data-process-panel={phase.id}
            >
              <div>
                <h3>{phase.heading}</h3>
                <p>{phase.text}</p>
                <ul>
                  {phase.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </div>
              <div class="process-object" aria-hidden="true">
                <Image
                  src={ribbon}
                  alt=""
                  widths={[520, 760, 1040]}
                  sizes="(max-width: 767px) 90vw, 43vw"
                  format="webp"
                  quality="mid"
                />
                <div class="object-grid" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  let processAbort: AbortController | undefined;
  let processObserver: IntersectionObserver | undefined;

  function initProcess() {
    processAbort?.abort();
    processObserver?.disconnect();
    processAbort = new AbortController();
    const { signal } = processAbort;
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-process-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-process-panel]'));
    if (!tabs.length || !panels.length) return;

    const activate = (id: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.processTab === id;
        tab.classList.toggle('is-active', active);
        if (active) tab.setAttribute('aria-current', 'step');
        else tab.removeAttribute('aria-current');
      });
      panels.forEach((panel) => {
        const active = panel.dataset.processPanel === id;
        panel.classList.toggle('is-active', active);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.processTab || ''), { signal });
    });

    processObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const id = (visible?.target as HTMLElement | undefined)?.dataset.processPanel;
        if (id) activate(id);
      },
      { rootMargin: '-18% 0px -52% 0px', threshold: [0, 0.25, 0.5, 0.75] },
    );
    panels.forEach((panel) => processObserver?.observe(panel));
  }

  document.addEventListener('astro:page-load', initProcess);
</script>

<style>
  .process-section {
    padding: 1rem;
    background: #ffffff;
  }

  .process-shell {
    width: min(100%, 88rem);
    margin-inline: auto;
    overflow: clip;
    border-radius: 2rem;
    background: #0d0d0f;
    color: #ffffff;
  }

  .process-intro {
    display: grid;
    padding: clamp(3rem, 5vw, 5rem);
    grid-template-columns: 0.7fr 1.5fr 0.8fr;
    align-items: end;
    gap: 2.5rem;
  }

  .process-intro > p:first-child {
    color: #ff7048;
    font-weight: 600;
  }

  .process-intro h2 {
    max-width: 12ch;
    font-size: clamp(3rem, 6.4vw, 6.9rem);
    font-weight: 540;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .process-intro > p:last-child {
    color: #b8b8b4;
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .process-layout {
    display: grid;
    margin: 0 clamp(1.25rem, 3.5vw, 3.5rem) clamp(1.25rem, 3.5vw, 3.5rem);
    grid-template-columns: minmax(12rem, 0.27fr) 1fr;
    align-items: start;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .process-tabs {
    position: sticky;
    top: 7.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #333337;
    border-radius: 1rem;
    background: #121215;
  }

  .process-tab {
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    color: #9e9e9b;
    font-size: 1.05rem;
    font-weight: 590;
    text-align: left;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .process-tab + .process-tab {
    border-top: 1px solid #333337;
  }

  .process-tab:hover,
  .process-tab:focus-visible,
  .process-tab.is-active {
    background: #1b1b1e;
    color: #ffffff;
  }

  .process-tab.is-active :global(svg) {
    color: #ff633c;
    transform: translateY(3px);
  }

  .process-panels {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  .process-panel {
    display: grid;
    min-height: clamp(32rem, calc(100svh - 8.5rem), 44rem);
    grid-template-columns: minmax(18rem, 0.8fr) 1.2fr;
    overflow: hidden;
    scroll-margin-top: 7rem;
    border: 1px solid #333337;
    border-radius: 1.4rem;
    background: #111114;
  }

  .process-panel > div:first-child {
    align-self: center;
    padding: clamp(2rem, 4vw, 4rem);
  }

  .process-panel h3 {
    max-width: 13ch;
    font-size: clamp(2rem, 3.3vw, 3.5rem);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 1;
    text-wrap: balance;
  }

  .process-panel p {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: #b8b8b4;
    line-height: 1.65;
  }

  .process-panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.8rem;
  }

  .process-panel li {
    padding: 0.5rem 0.7rem;
    border: 1px solid #3d3d41;
    border-radius: 0.45rem;
    color: #dfdfdc;
    font-size: 0.78rem;
  }

  .process-object {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: #111114;
    isolation: isolate;
  }

  .process-object img {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: 145%;
    max-width: none;
    opacity: 0.72;
    transform: translate(-49%, -47%) rotate(-8deg) scale(0.96);
    transition:
      opacity 600ms ease,
      transform 750ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .object-grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
    background-size: 25% 25%;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .process-panel.is-active .process-object img {
    opacity: 1;
    transform: translate(-49%, -47%) rotate(-8deg) scale(1);
  }

  @media (max-width: 900px) {
    .process-section {
      min-height: auto;
    }

    .process-shell {
      overflow: hidden;
    }

    .process-intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .process-intro h2 {
      max-width: 10ch;
    }

    .process-intro > p:last-child {
      max-width: 34rem;
    }

    .process-layout {
      grid-template-columns: 1fr;
    }

    .process-tabs {
      position: relative;
      top: auto;
      flex-direction: row;
    }

    .process-tab {
      min-height: 4.5rem;
      flex: 1;
    }

    .process-tab + .process-tab {
      border-top: 0;
      border-left: 1px solid #333337;
    }

    .process-tab :global(svg) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .process-section {
      padding: 0.5rem;
    }

    .process-shell {
      border-radius: 1.35rem;
    }

    .process-intro {
      padding: 3rem 1.25rem 2rem;
    }

    .process-layout {
      margin: 0 0.65rem 0.65rem;
      border-radius: 0.9rem;
    }

    .process-tabs {
      overflow-x: auto;
    }

    .process-tab {
      min-width: 8.5rem;
      padding-inline: 1rem;
    }

    .process-panel {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .process-panel > div:first-child {
      padding: 2rem 1.25rem 1.5rem;
    }

    .process-object {
      min-height: 18rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-object img {
      transition: none;
    }
  }
</style>
