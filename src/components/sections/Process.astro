---
import Icon from '../Icon.astro';

const phases = [
  {
    id: 'design',
    title: 'Design',
    heading: 'Eerst je merk en klant. Dan pas het thema.',
    text: 'Ik breng scherp waarom klanten juist bij jou kopen en vertaal dat naar een herkenbare merkwereld, heldere productstructuur en kooproute zonder onnodige twijfel.',
    details: ['Merk- en webshopstrategie', 'UX, UI en prototypes', 'Shopify-designsysteem'],
  },
  {
    id: 'develop',
    title: 'Develop',
    heading: 'Shopify zonder de uitstraling van een standaardthema.',
    text: 'Ik bouw het ontwerp als snelle, toegankelijke Shopify-frontend. Met flexibele secties voor je team, doordachte productpagina’s en interacties die je verhaal ondersteunen.',
    details: [
      'Maatwerk Shopify-thema',
      'Performance en toegankelijkheid',
      'Apps en slimme koppelingen',
    ],
  },
  {
    id: 'maintain',
    title: 'Maintain',
    heading: 'Na de livegang begint je webshop pas te leren.',
    text: 'Ik blijf betrokken bij nieuwe campagnes, collectiepagina’s en technische verbeteringen. We gebruiken gedrag en data om frictie te vinden en je webshop gericht door te ontwikkelen.',
    details: ['Shopify-doorontwikkeling', 'CRO en analytics', 'Persoonlijk technisch beheer'],
  },
];
---

<section id="werkwijze" class="process" aria-labelledby="process-heading">
  <div class="process__shell stage stage--ink">
    <div class="process__intro lift-in">
      <p class="kicker">Van merkverhaal tot dagelijkse verkoop.</p>
      <h2 id="process-heading" class="display-xl">Design. Develop. Maintain.</h2>
      <p class="lead">
        Geen overdracht tussen ontwerp, development en optimalisatie. Je werkt rechtstreeks met
        mij—van de eerste klantreis tot de volgende Shopify-release.
      </p>
    </div>

    <div class="process__layout">
      <nav class="process__tabs" aria-label="Fasen van mijn werkwijze">
        {
          phases.map((phase, index) => (
            <a
              href={`#process-panel-${phase.id}`}
              class:list={['process__tab', index === 0 && 'is-active']}
              data-process-tab={phase.id}
              aria-current={index === 0 ? 'step' : undefined}
            >
              <span>{phase.title}</span>
              <Icon name="arrowDown" size={18} />
            </a>
          ))
        }
      </nav>

      <div class="process__panels">
        {
          phases.map((phase, index) => (
            <article
              id={`process-panel-${phase.id}`}
              class:list={['process__panel', index === 0 && 'is-active']}
              data-process-panel={phase.id}
            >
              <div class="process__text">
                <h3 class="display-md">{phase.heading}</h3>
                <p>{phase.text}</p>
                <ul>
                  {phase.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </div>
              <button
                type="button"
                class="process__object"
                data-living-visual={phase.id}
                aria-label={`Beïnvloed de levende ${phase.title}-vorm met je aanwijzer of een tik`}
              >
                <span class="living-surface" data-visual-host aria-hidden="true">
                  <span class:list={['living-fallback', `living-fallback--${phase.id}`]} />
                </span>
                <span class="process__hint" aria-hidden="true">
                  <span class="process__hint-dot" />
                  <span class="process__hint-pointer">Beweeg</span>
                  <span class="process__hint-touch">Tik</span>
                </span>
              </button>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initProcessLivingVisuals } from '../../scripts/process-living-visuals';

  let processAbort: AbortController | undefined;
  let cleanupProcessVisuals: (() => void) | undefined;

  function initProcess() {
    processAbort?.abort();
    cleanupProcessVisuals?.();
    processAbort = new AbortController();
    const { signal } = processAbort;
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-process-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-process-panel]'));
    if (!tabs.length || !panels.length) return;

    const activate = (id: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.processTab === id;
        tab.classList.toggle('is-active', active);
        if (active) tab.setAttribute('aria-current', 'step');
        else tab.removeAttribute('aria-current');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.processPanel === id);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.processTab || ''), { signal });
    });

    let scrollFrame = 0;
    const updateActivePhase = () => {
      scrollFrame = 0;
      const focusLine = Math.min(window.innerHeight * 0.34, 320);
      const closest = panels.reduce<{ panel: HTMLElement; distance: number } | undefined>(
        (current, panel) => {
          const bounds = panel.getBoundingClientRect();
          if (bounds.bottom < 96 || bounds.top > window.innerHeight * 0.82) return current;
          const distance = Math.abs(bounds.top - focusLine);
          return !current || distance < current.distance ? { panel, distance } : current;
        },
        undefined,
      );
      const id = closest?.panel.dataset.processPanel;
      if (id) activate(id);
    };
    const queueActivePhase = () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(updateActivePhase);
    };
    window.addEventListener('scroll', queueActivePhase, { signal, passive: true });
    window.addEventListener('resize', queueActivePhase, { signal, passive: true });
    signal.addEventListener('abort', () => cancelAnimationFrame(scrollFrame), { once: true });
    queueActivePhase();

    cleanupProcessVisuals = initProcessLivingVisuals(document);
    signal.addEventListener('abort', () => cleanupProcessVisuals?.(), { once: true });
  }

  document.addEventListener('astro:page-load', initProcess);
  document.addEventListener('astro:before-swap', () => processAbort?.abort());
</script>

<style>
  .process {
    padding: 0 var(--spacing-gutter);
  }

  .process__shell {
    width: min(100%, 92rem);
    margin-inline: auto;
    overflow: clip;
  }

  .process__intro {
    display: grid;
    padding: clamp(3rem, 5vw, 5.5rem) clamp(1.5rem, 4vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 0.7fr 1.5fr 0.8fr;
    align-items: end;
    gap: 2.5rem;
  }
  .process__intro .kicker {
    color: #ff8d69;
  }
  .process__intro h2 {
    max-width: 11ch;
    color: var(--stage-ink);
  }
  .process__intro .lead {
    color: var(--stage-soft);
    font-size: 1rem;
  }

  .process__layout {
    display: grid;
    margin: 0 clamp(1rem, 3vw, 3rem) clamp(1rem, 3vw, 3rem);
    grid-template-columns: minmax(12rem, 0.27fr) 1fr;
    align-items: start;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .process__tabs {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--stage-line);
    border-radius: var(--radius-card);
    background: var(--stage-raised);
  }
  .process__tab {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    color: var(--stage-soft);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }
  .process__tab + .process__tab {
    border-top: 1px solid var(--stage-line);
  }
  .process__tab :global(svg) {
    transition: transform 240ms var(--ease-out-soft);
  }
  .process__tab:hover,
  .process__tab:focus-visible,
  .process__tab.is-active {
    background: var(--stage);
    color: var(--stage-ink);
  }
  .process__tab.is-active :global(svg) {
    color: var(--vermilion);
    transform: translateY(3px);
  }

  .process__panels {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  .process__panel {
    display: grid;
    min-height: clamp(30rem, calc(100svh - 9rem), 44rem);
    grid-template-columns: minmax(18rem, 0.8fr) 1.2fr;
    overflow: hidden;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    border: 1px solid var(--stage-line);
    border-radius: var(--radius-stage);
    background: var(--stage-raised);
  }

  .process__text {
    align-self: center;
    padding: clamp(2rem, 4vw, 4rem);
  }
  .process__text h3 {
    max-width: 13ch;
    color: var(--stage-ink);
  }
  .process__text p {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--stage-soft);
    line-height: 1.65;
  }
  .process__text ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.8rem;
    list-style: none;
    padding: 0;
  }
  .process__text li {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--stage-line);
    border-radius: 999px;
    color: var(--stage-ink);
    font-size: 0.8rem;
  }

  .process__object {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--stage-raised);
    color: inherit;
    cursor: crosshair;
    isolation: isolate;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .process__object:focus-visible {
    outline: 3px solid var(--vermilion);
    outline-offset: -4px;
  }

  .living-surface {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    background: var(--stage-raised);
  }
  .living-surface :global(canvas) {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .living-surface[data-ready='true'] :global(canvas) {
    opacity: 1;
  }
  .process__object[data-engine='webgl'] .living-surface {
    filter: saturate(1.08) contrast(1.04);
  }

  .living-fallback {
    position: absolute;
    z-index: 1;
    inset: 12%;
    opacity: 0.9;
    transition: opacity 500ms ease;
  }
  .living-surface[data-ready='true'] .living-fallback {
    opacity: 0;
  }
  .living-fallback::before,
  .living-fallback::after {
    position: absolute;
    content: '';
  }
  .living-fallback--design::before {
    inset: 18% 2% 16% 6%;
    border-radius: 58% 42% 63% 37% / 46% 64% 36% 54%;
    background:
      radial-gradient(circle at 28% 18%, #ffd1ad 0 8%, transparent 25%),
      radial-gradient(ellipse at 64% 58%, #ff7043 0 20%, #9b210f 64%, transparent 72%);
    filter: blur(1px) drop-shadow(0 2rem 3rem rgba(238, 67, 31, 0.28));
    transform: rotate(-13deg);
  }
  .living-fallback--design::after {
    inset: 36% 10% 30% 22%;
    border: 2px solid rgba(255, 196, 153, 0.75);
    border-radius: 50%;
    transform: rotate(20deg) skewX(-18deg);
  }
  .living-fallback--develop {
    background-image:
      radial-gradient(circle at 26% 28%, #ffb17d 0 0.7rem, transparent 0.8rem),
      radial-gradient(circle at 67% 21%, #ff7043 0 0.8rem, transparent 0.9rem),
      radial-gradient(circle at 54% 66%, #f04a24 0 1rem, transparent 1.1rem),
      radial-gradient(circle at 82% 72%, #ff9b69 0 0.65rem, transparent 0.75rem),
      repeating-radial-gradient(
        ellipse at 55% 48%,
        transparent 0 8%,
        rgba(240, 74, 36, 0.5) 9% 9.5%,
        transparent 11% 16%
      );
    filter: drop-shadow(0 0 2rem rgba(240, 74, 36, 0.35));
  }
  .living-fallback--maintain::before {
    inset: 10%;
    border: clamp(1.2rem, 3vw, 2.4rem) solid #ee431f;
    border-top-color: #ffd0a6;
    border-right-color: #ff7545;
    border-radius: 50%;
    filter: drop-shadow(0 0 2.8rem rgba(240, 74, 36, 0.28));
    transform: rotate(-20deg) scaleX(1.08);
  }

  .process__hint {
    position: absolute;
    z-index: 3;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(12, 12, 10, 0.7);
    color: #e6e6e2;
    font-size: 0.72rem;
    font-weight: 600;
    pointer-events: none;
  }
  .process__hint-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--vermilion);
    box-shadow: 0 0 0.75rem rgba(255, 112, 72, 0.8);
  }
  .process__hint-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .process__hint-pointer {
      display: none;
    }
    .process__hint-touch {
      display: inline;
    }
  }

  @media (max-width: 900px) {
    .process__intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .process__intro h2 {
      max-width: 10ch;
    }
    .process__intro .lead {
      max-width: 34rem;
    }
    .process__layout {
      grid-template-columns: 1fr;
    }
    .process__tabs {
      position: relative;
      top: auto;
      flex-direction: row;
    }
    .process__tab {
      min-height: 4.25rem;
      flex: 1;
      font-size: 1.25rem;
    }
    .process__tab + .process__tab {
      border-top: 0;
      border-left: 1px solid var(--stage-line);
    }
    .process__tab :global(svg) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .process {
      padding: 0 0.5rem;
    }
    .process__intro {
      padding: 3rem 1.25rem 2rem;
    }
    .process__layout {
      margin: 0 0.65rem 0.65rem;
    }
    .process__tabs {
      overflow-x: auto;
    }
    .process__tab {
      min-width: 8rem;
      padding-inline: 1rem;
    }
    .process__panel {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .process__text {
      padding: 2rem 1.25rem 1.5rem;
    }
    .process__object {
      min-height: 18rem;
      cursor: pointer;
    }
    .process__hint-pointer {
      display: none;
    }
    .process__hint-touch {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .living-surface :global(canvas),
    .living-fallback {
      transition: none;
    }
  }
</style>
