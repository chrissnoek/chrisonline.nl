---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="werk" class="work-section scroll-mt-24" aria-labelledby="work-heading">
  <div class="work-heading-row reveal-up">
    <div>
      <h2 id="work-heading">Ervaring die verder gaat dan een thema</h2>
      <p>
        Een premium Shopify-webshop en geselecteerde digitale platforms waarin merkverhaal,
        gebruiksgemak en snelle frontends samenkomen.
      </p>
    </div>
    <div class="carousel-controls" role="group" aria-label="Bediening projectcarrousel">
      <button type="button" data-project-prev aria-label="Vorige projecten">
        <Icon name="arrowLeft" size={19} />
      </button>
      <button type="button" data-project-next aria-label="Volgende projecten">
        <Icon name="arrowRight" size={19} />
      </button>
    </div>
  </div>

  <div class="project-viewport">
    <div class="project-track" data-project-track tabindex="0" role="region" aria-label="Projecten">
      {
        projects.map((project, index) => (
          <article class="project-slide reveal">
            <a href={`/werk/${project.id}`} aria-label={`Bekijk project: ${project.data.title}`}>
              <div class="project-media" style={`--project-accent:${project.data.accent}`}>
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  widths={[560, 840, 1120]}
                  sizes="(max-width: 767px) 86vw, (max-width: 1200px) 58vw, 46vw"
                  format="avif"
                  quality="mid"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  class="project-image"
                />
              </div>
              <div class="project-meta">
                <div>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.role}</p>
                </div>
                <span aria-hidden="true">
                  <Icon name="arrowUpRight" size={22} />
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  let projectsAbort: AbortController | undefined;

  function initProjects() {
    projectsAbort?.abort();
    projectsAbort = new AbortController();
    const { signal } = projectsAbort;
    const track = document.querySelector<HTMLElement>('[data-project-track]');
    const previous = document.querySelector<HTMLButtonElement>('[data-project-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-project-next]');
    if (!track || !previous || !next) return;

    const getStep = () => {
      const slide = track.querySelector<HTMLElement>('.project-slide');
      return slide ? slide.offsetWidth + 24 : track.clientWidth * 0.75;
    };

    previous.addEventListener(
      'click',
      () => track.scrollBy({ left: -getStep(), behavior: 'smooth' }),
      {
        signal,
      },
    );
    next.addEventListener('click', () => track.scrollBy({ left: getStep(), behavior: 'smooth' }), {
      signal,
    });
  }

  document.addEventListener('astro:page-load', initProjects);
</script>

<style>
  .work-section {
    padding: 0 0 clamp(7rem, 11vw, 11rem);
    overflow: hidden;
    background: #ffffff;
  }

  .work-heading-row {
    display: flex;
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  h2 {
    color: #111111;
    font-size: clamp(2.4rem, 4.7vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .work-heading-row p {
    max-width: 35rem;
    margin-top: 1rem;
    color: #62625e;
    font-size: 1.05rem;
  }

  .carousel-controls {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }

  .carousel-controls button {
    display: grid;
    width: 3.1rem;
    height: 3.1rem;
    place-items: center;
    border: 1px solid #cecec8;
    border-radius: 50%;
    color: #111111;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .carousel-controls button:hover,
  .carousel-controls button:focus-visible {
    background: #111111;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .project-viewport {
    width: 100%;
    margin-top: 3rem;
  }

  .project-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 0 max(1.5rem, calc((100vw - 78rem) / 2)) 1.5rem;
    scroll-padding-inline: max(1.5rem, calc((100vw - 78rem) / 2));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .project-track::-webkit-scrollbar {
    display: none;
  }

  .project-slide {
    width: min(46rem, 58vw);
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .project-slide a {
    display: block;
    color: #111111;
  }

  .project-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 1.4rem;
    background: color-mix(in srgb, var(--project-accent) 17%, #f0f0ec);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-slide a:hover .project-image,
  .project-slide a:focus-visible .project-image {
    transform: scale(1.035);
  }

  .project-meta {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0.15rem 0;
  }

  .project-meta h3 {
    font-size: clamp(1.35rem, 2.2vw, 2.1rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .project-meta p {
    margin-top: 0.35rem;
    color: #70706b;
    font-size: 0.88rem;
  }

  .project-meta > span {
    display: grid;
    width: 2.85rem;
    height: 2.85rem;
    flex: none;
    place-items: center;
    border: 1px solid #cecec8;
    border-radius: 50%;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .project-slide a:hover .project-meta > span,
  .project-slide a:focus-visible .project-meta > span {
    background: #ee4b24;
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .work-heading-row {
      width: min(100% - 2.5rem, 35rem);
      align-items: end;
    }

    .work-heading-row p {
      max-width: 24rem;
      font-size: 0.95rem;
    }

    .project-track {
      gap: 0.9rem;
      padding-inline: 1.25rem;
      scroll-padding-inline: 1.25rem;
    }

    .project-slide {
      width: min(86vw, 32rem);
    }

    .project-media {
      border-radius: 1rem;
    }

    .carousel-controls button {
      width: 2.9rem;
      height: 2.9rem;
    }
  }

  @media (max-width: 520px) {
    .work-heading-row {
      align-items: flex-end;
    }

    .carousel-controls button:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-track {
      scroll-behavior: auto;
    }

    .project-image,
    .carousel-controls button {
      transition: none;
    }
  }
</style>
