---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';

const projects = (
  await getCollection(
    'projects',
    ({ data }) => data.projectType === 'client-project' && !data.placeholder,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<section id="werk" class="work" aria-labelledby="work-heading">
  <div class="shell work__head lift-in">
    <div>
      <h2 id="work-heading" class="display-lg">
        Websites en webshops.<br />Gebouwd voor het merk.
      </h2>
      <p class="lead">
        Een selectie van mijn werk voor merken en bureaus. Van premium Shopify-webshops tot
        reisplatforms, boekingsflows en campagnes.
      </p>
    </div>
    <div class="work__controls" role="group" aria-label="Bediening projectcarrousel">
      <button type="button" data-project-prev aria-label="Vorige projecten">
        <Icon name="arrowLeft" size={19} />
      </button>
      <button type="button" data-project-next aria-label="Volgende projecten">
        <Icon name="arrowRight" size={19} />
      </button>
    </div>
  </div>

  <div class="work__viewport">
    <div class="work__track" data-project-track tabindex="0" role="region" aria-label="Projecten">
      {
        projects.map((project, index) => (
          <article class="work__slide">
            <a href={`/werk/${project.id}`} aria-label={`Bekijk project: ${project.data.title}`}>
              <div class="work__media" style={`--project-accent:${project.data.accent}`}>
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  widths={[560, 840, 1120]}
                  sizes="(max-width: 767px) 86vw, (max-width: 1200px) 58vw, 46vw"
                  format="avif"
                  quality="mid"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  transition:name={`cover-${project.id}`}
                />
              </div>
              <div class="work__meta">
                <div>
                  <h3 class="display-sm">{project.data.title}</h3>
                  <p>{project.data.role}</p>
                </div>
                <span class="work__go" aria-hidden="true">
                  <Icon name="arrowUpRight" size={20} />
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
    <div class="shell work__progress" aria-hidden="true">
      <span data-project-progress></span>
    </div>
  </div>
</section>

<script>
  let projectsAbort: AbortController | undefined;

  function initProjects() {
    projectsAbort?.abort();
    projectsAbort = new AbortController();
    const { signal } = projectsAbort;
    const track = document.querySelector<HTMLElement>('[data-project-track]');
    const previous = document.querySelector<HTMLButtonElement>('[data-project-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-project-next]');
    const progress = document.querySelector<HTMLElement>('[data-project-progress]');
    if (!track || !previous || !next) return;

    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const getStep = () => {
      const slide = track.querySelector<HTMLElement>('.work__slide');
      return slide
        ? slide.offsetWidth + parseFloat(getComputedStyle(track).gap)
        : track.clientWidth * 0.75;
    };
    const scroll = (dir: 1 | -1) =>
      track.scrollBy({ left: dir * getStep(), behavior: reduce() ? 'instant' : 'smooth' });

    previous.addEventListener('click', () => scroll(-1), { signal });
    next.addEventListener('click', () => scroll(1), { signal });
    track.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'ArrowRight') scroll(1);
        if (e.key === 'ArrowLeft') scroll(-1);
      },
      { signal },
    );

    // Voortgang + knopstatus volgen de scrollpositie.
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const ratio = max > 0 ? track.scrollLeft / max : 0;
      progress?.style.setProperty('--progress', String(ratio));
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };
    update();
    track.addEventListener('scroll', update, { passive: true, signal });
    window.addEventListener('resize', update, { passive: true, signal });
  }

  document.addEventListener('astro:page-load', initProjects);
  initProjects();
</script>

<style>
  .work {
    padding: 0 0 clamp(4rem, 7vw, 7rem);
    overflow: hidden;
  }

  .work__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .work__head h2 {
    max-width: 16ch;
  }
  .work__head .lead {
    max-width: 34rem;
    margin-top: 1.25rem;
  }

  .work__controls {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }
  .work__controls button {
    display: grid;
    width: 3.1rem;
    height: 3.1rem;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease,
      opacity 180ms ease;
  }
  .work__controls button:hover:not(:disabled),
  .work__controls button:focus-visible {
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-2px);
  }
  .work__controls button:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .work__viewport {
    width: 100%;
    margin-top: 3rem;
  }

  .work__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 0.5rem max(var(--spacing-gutter), calc((100vw - 84rem) / 2)) 1.5rem;
    scroll-padding-inline: max(var(--spacing-gutter), calc((100vw - 84rem) / 2));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .work__track::-webkit-scrollbar {
    display: none;
  }
  .work__track:focus-visible {
    outline-offset: -3px;
  }

  .work__slide {
    width: min(46rem, 58vw);
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  .work__slide a {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .work__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-stage);
    background: color-mix(in srgb, var(--project-accent) 18%, var(--paper-deep));
  }
  .work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-soft);
  }
  .work__slide a:hover img,
  .work__slide a:focus-visible img {
    transform: scale(1.035);
  }

  .work__meta {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0.15rem 0;
  }
  .work__meta p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .work__go {
    display: grid;
    width: 2.85rem;
    height: 2.85rem;
    flex: none;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      border-color 220ms ease,
      transform 300ms var(--ease-out-soft);
  }
  .work__slide a:hover .work__go,
  .work__slide a:focus-visible .work__go {
    background: var(--vermilion);
    border-color: var(--vermilion);
    color: #fff;
    transform: rotate(45deg);
  }

  .work__progress {
    height: 2px;
    margin-top: 0.5rem;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .work__progress span {
    display: block;
    width: 22%;
    height: 100%;
    background: var(--vermilion);
    transform: translateX(calc(var(--progress, 0) * (100% / 0.22 - 100%)));
    transition: transform 120ms linear;
  }

  @media (max-width: 767px) {
    .work__head {
      align-items: end;
    }
    .work__head .lead {
      max-width: 24rem;
      font-size: 1rem;
    }
    .work__track {
      gap: 0.9rem;
    }
    .work__slide {
      width: min(86vw, 32rem);
    }
    .work__media {
      border-radius: 1.1rem;
    }
    .work__controls button {
      width: 2.9rem;
      height: 2.9rem;
    }
  }
  @media (max-width: 520px) {
    .work__controls button:first-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work__track {
      scroll-behavior: auto;
    }
    .work__media img,
    .work__controls button,
    .work__go {
      transition: none;
    }
  }
</style>
