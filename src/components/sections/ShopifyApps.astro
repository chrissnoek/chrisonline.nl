---
import ShopifyAppGrid from '../ShopifyAppGrid.astro';
import Icon from '../Icon.astro';
import { getShopifyApps } from '../../lib/shopify-apps';
const apps = await getShopifyApps();
---

<section id="shopify-apps" class="apps section section--deep" aria-labelledby="apps-heading">
  <div class="shell">
    <div class="apps__head lift-in">
      <div>
        <h2 id="apps-heading" class="display-lg">
          Eigen Shopify Apps.<br />Een probleem. Een oplossing.
        </h2>
        <p class="lead">
          Naast websites en webshops bouw ik eigen producten. Kleine, gerichte apps die een concreet
          probleem in je Shopify-webshop oplossen, van productdata tot bezorgverwachtingen.
        </p>
      </div>
      <a href="/shopify-apps" class="link-arrow link-arrow--accent">
        Bekijk alle Shopify Apps <Icon name="arrowRight" size={19} />
      </a>
    </div>
    <ShopifyAppGrid apps={apps} />
  </div>
</section>

<style>
  .apps__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: 3.5rem;
  }
  .apps__head h2 {
    max-width: 16ch;
  }
  .apps__head .lead {
    max-width: 38rem;
    margin-top: 1.25rem;
  }
  .apps__head > a {
    flex: none;
  }
  @media (max-width: 767px) {
    .apps__head {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 2.5rem;
    }
  }
</style>
