---
import ShopifyAppGrid from '../ShopifyAppGrid.astro';
import Icon from '../Icon.astro';
import { getShopifyApps } from '../../lib/shopify-apps';
const apps = await getShopifyApps();
---

<section id="shopify-apps" class="apps-section scroll-mt-24" aria-labelledby="apps-heading">
  <div class="apps-container">
    <div class="apps-heading reveal-up">
      <h2 id="apps-heading">Eigen Shopify Apps.<br />Een probleem. Een oplossing.</h2>
      <p>
        Naast websites en webshops bouw ik eigen producten. Kleine, gerichte apps die een concreet
        probleem in je Shopify-webshop oplossen, van productdata tot bezorgverwachtingen.
      </p>
      <a href="/shopify-apps" class="apps-overview"
        >Bekijk alle Shopify Apps <Icon name="arrowRight" size={19} /></a
      >
    </div>
    <ShopifyAppGrid apps={apps} />
  </div>
</section>

<style>
  .apps-section {
    padding: clamp(4rem, 7vw, 7rem) 0 clamp(5rem, 8vw, 8rem);
    background: #f5f5f2;
  }
  .apps-container {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }
  .apps-heading {
    margin-bottom: 3rem;
  }
  h2 {
    color: #111;
    font-size: clamp(2.4rem, 4.7vw, 4.8rem);
    font-weight: 580;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }
  .apps-heading p {
    max-width: 39rem;
    margin-top: 1.1rem;
    color: #62625e;
    font-size: 1.05rem;
  }
  .apps-overview {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.8rem;
    margin-top: 1rem;
    color: var(--accent-text);
    font-size: 0.95rem;
    font-weight: 620;
  }
  .apps-overview:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 767px) {
    .apps-container {
      width: min(100% - 2.5rem, 35rem);
    }
    .apps-heading p {
      font-size: 0.95rem;
    }
    h2 {
      font-size: clamp(2.05rem, 7.5vw, 3.6rem);
    }
  }
</style>
