---
import { SERVICES } from '../../config/services';
import Icon from '../Icon.astro';

const order = [
  'Shopify-webshop van A tot Z',
  'Shopify-webshopdesign',
  'Shopify-thema op maat',
  'Shopify-analyse & optimalisatie',
  'Branding & visuele identiteit',
  'Procesautomatisering & AI',
  'High-impact display advertising',
];
const orderedServices = order
  .map((title) => SERVICES.find((service) => service.title === title))
  .filter((service): service is (typeof SERVICES)[number] => Boolean(service));
---

<section id="diensten" class="services section" aria-labelledby="services-heading">
  <div class="shell services__shell">
    <div class="services__intro lift-in">
      <h2 id="services-heading" class="display-lg">Alles rond een webshop die blijft presteren.</h2>
      <p class="lead">
        Mijn kern is Shopify-strategie, design, development en onderhoud. Branding, analytics,
        automatisering en campagnes sluit ik aan wanneer ze je winkelervaring aantoonbaar sterker
        maken.
      </p>
    </div>

    <div class="services__list reveal-up">
      {
        orderedServices.map((service, index) => (
          <details class="disclosure service" open={index === 0 ? true : undefined}>
            <summary>
              <span class="service__title">
                {service.title}
                {service.badge && <span class="service__badge">{service.badge}</span>}
              </span>
              <span class="disclosure__icon" aria-hidden="true">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <div class="disclosure__body">
              <p>{service.intro}</p>
              <ul class="service__points">
                {service.points.slice(0, 3).map((point) => (
                  <li>
                    <strong>{point.lead}</strong>
                    <span>{point.text}</span>
                  </li>
                ))}
              </ul>
              {service.href && (
                <a href={service.href} class="link-arrow link-arrow--accent">
                  Bekijk automatisering <Icon name="arrowRight" size={17} />
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services__shell {
    display: grid;
    grid-template-columns: minmax(17rem, 0.7fr) 1.3fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .services__intro {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
  }
  .services__intro h2 {
    max-width: 14ch;
  }
  .services__intro .lead {
    max-width: 28rem;
    margin-top: 1.5rem;
    font-size: 1.05rem;
  }

  .service > summary {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.2rem + 1.2vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.012em;
  }
  .service__title {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
  }
  .service__badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--vermilion-soft);
    color: var(--vermilion-ink);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .service .disclosure__body > p {
    max-width: 44rem;
    color: var(--ink-soft);
  }
  .service__points {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.4rem;
    padding: 0;
    list-style: none;
  }
  .service__points li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.92rem;
  }
  .service__points strong {
    color: var(--ink);
    font-weight: 600;
  }
  .service__points span {
    color: var(--ink-soft);
  }
  .service .link-arrow {
    margin-top: 1.25rem;
  }

  @media (max-width: 820px) {
    .services__shell {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .services__intro {
      position: static;
    }
  }
</style>
