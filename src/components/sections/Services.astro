---
import { SERVICES } from '../../config/services';
import Icon from '../Icon.astro';

const orderedServices = [
  ...SERVICES.filter((service) => service.title === 'Website-ontwerp & UI/UX'),
  ...SERVICES.filter((service) => service.title === 'Maatwerk website-development'),
  ...SERVICES.filter((service) => service.title === 'Branding & visuele identiteit'),
  ...SERVICES.filter((service) => service.title === 'Procesautomatisering & AI'),
  ...SERVICES.filter((service) => service.title === 'High-impact display advertising'),
  ...SERVICES.filter((service) => service.title === 'Tracking, analytics & performance'),
  ...SERVICES.filter((service) => service.title === 'Shopify webshop-development'),
];
---

<section id="diensten" class="services-section scroll-mt-24" aria-labelledby="services-heading">
  <div class="services-shell">
    <div class="services-intro reveal-up">
      <h2 id="services-heading">Wat ik voor je kan maken.</h2>
      <p>
        Mijn kern is design, development en onderhoud. Voor het grotere digitale plaatje werk ik met
        vaste specialisten en sluit ik automatisering, branding en analytics aan waar dat echt
        waarde toevoegt.
      </p>
    </div>

    <ul class="service-list">
      {
        orderedServices.map((service, index) => (
          <li class="service-item reveal">
            <button
              type="button"
              class="service-trigger"
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`service-${index}`}
              data-service-trigger
            >
              <span>
                {service.title.replace('Shopify webshop-development', 'Webshop-development')}
              </span>
              <Icon name={index === 0 ? 'close' : 'plus'} size={20} class="service-icon" />
            </button>
            <div id={`service-${index}`} class="service-detail" hidden={index !== 0}>
              <p>{service.intro}</p>
              <ul>
                {service.points.slice(0, 3).map((point) => (
                  <li>
                    <strong>{point.lead}</strong> — {point.text}
                  </li>
                ))}
              </ul>
              {service.href && (
                <a href={service.href}>
                  Bekijk automatisering <Icon name="arrowRight" size={17} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  let servicesAbort: AbortController | undefined;

  function initServices() {
    servicesAbort?.abort();
    servicesAbort = new AbortController();
    const { signal } = servicesAbort;
    document.querySelectorAll<HTMLButtonElement>('[data-service-trigger]').forEach((trigger) => {
      trigger.addEventListener(
        'click',
        () => {
          const panel = document.getElementById(trigger.getAttribute('aria-controls') || '');
          if (!panel) return;
          const open = trigger.getAttribute('aria-expanded') === 'true';
          trigger.setAttribute('aria-expanded', String(!open));
          panel.hidden = open;
          const icon = trigger.querySelector<SVGElement>('.service-icon');
          if (icon) {
            icon.innerHTML = !open
              ? '<line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line>'
              : '<line x1="12" x2="12" y1="5" y2="19"></line><line x1="5" x2="19" y1="12" y2="12"></line>';
          }
        },
        { signal },
      );
    });
  }

  document.addEventListener('astro:page-load', initServices);
</script>

<style>
  .services-section {
    padding: clamp(7rem, 12vw, 12rem) 1.25rem;
    background: #ffffff;
  }

  .services-shell {
    display: grid;
    max-width: 78rem;
    margin-inline: auto;
    grid-template-columns: minmax(17rem, 0.68fr) 1.32fr;
    gap: clamp(4rem, 8vw, 8rem);
  }

  .services-intro {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .services-intro h2 {
    color: #111111;
    font-size: clamp(2.7rem, 5vw, 5.4rem);
    font-weight: 570;
    letter-spacing: -0.06em;
    line-height: 0.97;
  }

  .services-intro p {
    max-width: 28rem;
    margin-top: 1.5rem;
    color: #656560;
    line-height: 1.65;
  }

  .service-list {
    border-top: 1px solid #cecec9;
  }

  .service-item {
    border-bottom: 1px solid #cecec9;
  }

  .service-trigger {
    display: flex;
    width: 100%;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 0.25rem;
    color: #111111;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    font-weight: 590;
    letter-spacing: -0.025em;
    text-align: left;
  }

  .service-trigger :global(svg) {
    flex: none;
  }

  .service-detail {
    padding: 0 3rem 2.25rem 0.25rem;
  }

  .service-detail p {
    max-width: 43rem;
    color: #5e5e59;
    font-size: 1rem;
    line-height: 1.65;
  }

  .service-detail ul {
    display: grid;
    margin-top: 1.25rem;
    gap: 0.65rem;
    color: #777771;
    font-size: 0.88rem;
  }

  .service-detail strong {
    color: #30302d;
    font-weight: 650;
  }

  .service-detail > a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    color: #c93618;
    font-weight: 650;
  }

  @media (max-width: 780px) {
    .services-shell {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .services-intro {
      position: static;
    }
  }

  @media (max-width: 540px) {
    .services-section {
      padding-inline: 1.25rem;
    }

    .service-detail {
      padding-right: 0.25rem;
    }
  }
</style>
