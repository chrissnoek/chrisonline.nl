---
import CtaBand from '../CtaBand.astro';
import { CONTACT } from '../../config/site';
---

<CtaBand
  id="cta-heading"
  title="Klaar voor een Shopify-webshop die als jouw merk voelt?"
  text="Vertel me waar je webshop nu staat en waar je naartoe wilt. In een eerste gesprek kijken we naar je merk, assortiment, kooproute en wat er technisch nodig is."
  primary={{ label: 'Bespreek je Shopify-webshop', href: '/contact?dienst=shopify' }}
  secondary={{ label: 'Plan 30 minuten', href: CONTACT.bookingUrl, external: true }}
  note="Meestal binnen één werkdag een persoonlijke reactie."
/>
