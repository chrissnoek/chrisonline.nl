---
import { Image } from 'astro:assets';
import ribbon from '../../assets/brand/living-ribbon.png';
import { CONTACT } from '../../config/site';
import Icon from '../Icon.astro';
---

<section class="contact-section" aria-labelledby="cta-heading">
  <div class="contact-stage reveal-up">
    <Image
      src={ribbon}
      alt=""
      widths={[720, 1080, 1500]}
      sizes="100vw"
      format="webp"
      quality="mid"
      class="contact-ribbon"
      aria-hidden="true"
    />
    <div class="contact-copy">
      <h2 id="cta-heading">Zullen we iets maken dat blijft bewegen?</h2>
      <p>
        Vertel me waar je merk naartoe wil. Ik denk graag mee over het verhaal, de ervaring en de
        techniek die daarbij passen.
      </p>
      <div>
        <a href="/contact" class="contact-primary">
          Start een project
          <Icon name="arrowRight" size={18} />
        </a>
        <a href={CONTACT.bookingUrl} target="_blank" rel="noopener" class="contact-secondary">
          Plan een gesprek
          <Icon name="arrowUpRight" size={18} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 0 1rem 1rem;
    background: #ffffff;
  }

  .contact-stage {
    position: relative;
    width: min(100%, 88rem);
    min-height: min(44rem, 78svh);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 2rem;
    background: #0d0d0f;
    color: #ffffff;
    isolation: isolate;
  }

  .contact-stage::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 7rem 7rem;
    content: '';
    mask-image: linear-gradient(to right, transparent, #000 55%);
  }

  .contact-copy {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    padding: clamp(4rem, 9vw, 8rem);
  }

  h2 {
    font-size: clamp(3rem, 6.5vw, 6.7rem);
    font-weight: 540;
    letter-spacing: -0.065em;
    line-height: 0.93;
    text-wrap: balance;
  }

  .contact-copy > p {
    max-width: 37rem;
    margin-top: 2rem;
    color: #c2c2be;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
  }

  .contact-copy > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.4rem;
  }

  .contact-primary,
  .contact-secondary {
    display: inline-flex;
    min-height: 3.3rem;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.85rem 1.25rem;
    border-radius: 0.75rem;
    font-size: 0.92rem;
    font-weight: 650;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .contact-primary {
    background: #ee4b24;
    color: #ffffff;
  }

  .contact-secondary {
    border: 1px solid #515155;
    color: #ffffff;
  }

  .contact-primary:hover,
  .contact-primary:focus-visible,
  .contact-secondary:hover,
  .contact-secondary:focus-visible {
    transform: translateY(-2px);
  }

  .contact-secondary:hover,
  .contact-secondary:focus-visible {
    background: #1c1c20;
  }

  .contact-ribbon {
    position: absolute;
    z-index: 1;
    right: -22%;
    bottom: -27%;
    width: 90%;
    max-width: none;
    transform: rotate(-8deg);
    pointer-events: none;
  }

  @media (max-width: 700px) {
    .contact-section {
      padding-inline: 0.5rem;
    }

    .contact-stage {
      min-height: 43rem;
      border-radius: 1.35rem;
    }

    .contact-copy {
      padding: 3.5rem 1.25rem;
    }

    .contact-copy > div a {
      flex: 1 1 10rem;
    }

    .contact-ribbon {
      right: -65%;
      bottom: -4%;
      width: 170%;
    }
  }
</style>
