---
import { CONTACT } from '../../config/site';
import Icon from '../Icon.astro';
---

<section class="chapter-shell contact-stage" aria-labelledby="cta-heading">
  <aside class="contact-rail chapter-rail" aria-hidden="true">
    <div class="chapter-rail__index">
      <span>06</span>
      <i class="chapter-rail__line"></i>
    </div>
  </aside>

  <div class="contact-main">
    <div class="contact-copy">
      <h2 id="cta-heading">Klaar om je winkel in beweging te zetten?</h2>
      <div class="contact-actions">
        <a class="industrial-button" href="/contact">
          Start een project
          <Icon name="arrowUpRight" size={19} />
        </a>
        <a class="industrial-button" href={CONTACT.bookingUrl} target="_blank" rel="noopener">
          Plan een gesprek
          <Icon name="arrowUpRight" size={19} />
        </a>
        <a class="contact-mail" href={`mailto:${CONTACT.email}`}>
          {CONTACT.email}
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
    </div>

    <svg class="shop-drawing" viewBox="0 0 670 270" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M30 226h610M77 226V91l76-42h377l69 42v135M153 49v177M530 49v177"></path>
        <path d="M94 112h42M94 133h42M94 154h42M94 175h42"></path>
        <path d="M176 79h329v147H176zM190 95h144v131H190zM348 95h143v131H348z"></path>
        <path d="M239 226v-54h46v54M390 226v-70h60v70M419 156v-32"></path>
        <path class="dash" d="M30 242h610M77 70h522M64 91h548M176 63v-31M505 63v-31"></path>
        <path d="M384 123h70M204 121h116M204 139h82"></path>
      </g>
      <g fill="currentColor">
        <rect x="147" y="43" width="12" height="12"></rect>
        <rect x="524" y="43" width="12" height="12"></rect>
        <rect x="71" y="220" width="12" height="12"></rect>
        <rect x="593" y="220" width="12" height="12"></rect>
      </g>
    </svg>
  </div>
</section>

<style>
  .contact-stage,
  .contact-rail,
  .contact-main {
    background: var(--signal);
    color: var(--ink);
  }

  .contact-main {
    position: relative;
    display: grid;
    min-height: 26rem;
    grid-template-columns: minmax(28rem, 1.2fr) minmax(24rem, 0.8fr);
    align-items: center;
    gap: 3rem;
    padding: clamp(4rem, 7vw, 7rem) var(--page-gutter);
    overflow: hidden;
  }

  .contact-copy {
    position: relative;
    z-index: 2;
  }

  h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(4rem, 6.3vw, 7.5rem);
    line-height: 0.86;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.75rem;
  }

  .contact-actions .industrial-button:hover,
  .contact-actions .industrial-button:focus-visible {
    background: var(--ink);
    color: var(--signal);
  }

  .contact-mail {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    gap: 1.25rem;
    margin-left: 1rem;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 650;
    text-underline-offset: 0.35rem;
  }

  .shop-drawing {
    width: min(100%, 46rem);
    opacity: 0.45;
  }

  .shop-drawing .dash {
    stroke-dasharray: 5 7;
  }

  @media (max-width: 73.99rem) {
    .contact-main {
      grid-template-columns: minmax(0, 1fr);
      padding: 5rem var(--mobile-gutter) 0;
    }

    .shop-drawing {
      justify-self: end;
      width: min(100%, 40rem);
    }
  }

  @media (max-width: 39.99rem) {
    .contact-main {
      padding-top: 4rem;
    }

    h2 {
      font-size: clamp(3.4rem, 15vw, 4.8rem);
    }

    .contact-actions {
      display: grid;
    }

    .contact-mail {
      margin-left: 0;
    }
  }
</style>
