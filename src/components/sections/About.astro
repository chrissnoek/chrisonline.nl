---
import { Image } from 'astro:assets';
import chris from '../../assets/me/chris-snoek.jpg';
import { CONTACT, SITE } from '../../config/site';
import Stats from '../Stats.astro';

const principles = [
  ['Technisch sterk', 'Schone, schaalbare code zonder onnodige ballast.'],
  ['Razendsnel', 'Performance als uitgangspunt, omdat snelheid converteert.'],
  ['Conversiegericht', 'Heldere flows die bezoek naar keuze en aanvraag leiden.'],
] as const;
---

<section id="over" class="chapter-shell about-section" aria-labelledby="about-heading">
  <aside class="about-rail chapter-rail" aria-hidden="true">
    <p>CHRIS—ONLINE</p>
    <div class="chapter-rail__index">
      <span>04</span>
      <i class="chapter-rail__line"></i>
    </div>
  </aside>

  <div class="about-main">
    <div class="about-copy">
      <p class="technical-label">Over Chris</p>
      <h2 id="about-heading">Eén maker. Eén lijn. Geen overdrachtsverlies.</h2>
      <div class="about-body">
        <p>
          Als webdeveloper en designer help ik merken aan websites en webshops die niet alleen mooi
          zijn, maar ook werken: snel, vindbaar en gericht op resultaat. Van het eerste ontwerp in
          Figma tot een pixel-perfecte, technisch nette livegang.
        </p>
        <p>
          Ik denk mee over het grotere geheel en blijf ook na livegang betrokken. Zo blijven merk,
          techniek en doorontwikkeling één verhaal, zonder overdrachten die tijd of kwaliteit
          kosten.
        </p>
      </div>
      <Stats />
      <a class="about-mail" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </div>

    <div class="about-portrait">
      <Image
        src={chris}
        alt={`Portretfoto van ${SITE.author}`}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 1184px) 100vw, 52vw"
        format="avif"
        quality="high"
      />
      <span class="portrait-marker technical-label">Designer / Developer</span>
    </div>

    <ul class="about-principles">
      {
        principles.map(([title, text], index) => (
          <li>
            <span>0{index + 1}</span>
            <strong>{title}</strong>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-section {
    background: var(--ink);
    color: var(--paper);
  }

  .about-rail {
    border-color: var(--ink);
    background: var(--signal);
    color: var(--ink);
  }

  .about-rail > p {
    position: absolute;
    top: 2rem;
    left: 50%;
    margin: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transform: translateX(-50%) rotate(180deg);
    writing-mode: vertical-rl;
  }

  .about-main {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(27rem, 0.9fr) minmax(28rem, 1.1fr);
  }

  .about-copy {
    align-self: center;
    padding: clamp(6rem, 9vw, 9rem) clamp(2rem, 5vw, 6rem) clamp(4rem, 7vw, 7rem) var(--page-gutter);
  }

  .about-copy h2 {
    max-width: 10ch;
    margin: 1.3rem 0 0;
    font-size: clamp(4rem, 5.9vw, 7rem);
    hyphens: auto;
    line-height: 0.87;
    overflow-wrap: normal;
  }

  .about-body {
    display: grid;
    max-width: 42rem;
    margin-top: 2.25rem;
    gap: 1rem;
    color: var(--graphite-light);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
  }

  .about-body p {
    margin: 0;
  }

  .about-copy :global([data-stats]) {
    max-width: 42rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--graphite-dark);
  }

  .about-copy :global(.stat-num) {
    color: var(--signal);
    font-family: var(--font-display, Georgia, serif);
    font-weight: 400;
  }

  .about-mail {
    display: inline-block;
    min-height: 44px;
    margin-top: 2.25rem;
    color: var(--paper);
    font-size: 0.82rem;
    font-weight: 650;
    text-underline-offset: 0.35rem;
  }

  .about-portrait {
    position: relative;
    min-height: 48rem;
    overflow: hidden;
    border-left: 1px solid var(--graphite-dark);
    background: #343532;
  }

  .about-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: grayscale(1) contrast(1.02);
  }

  .portrait-marker {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    padding: 0.65rem 0.8rem;
    background: var(--signal);
    color: var(--ink);
  }

  .about-principles {
    display: grid;
    grid-column: 1 / -1;
    margin: 0;
    padding: 0 var(--page-gutter);
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    border-top: 1px solid var(--graphite-dark);
  }

  .about-principles li {
    display: grid;
    min-height: 11rem;
    align-content: center;
    padding: 1.5rem 2rem;
    border-right: 1px solid var(--graphite-dark);
  }

  .about-principles li:first-child {
    padding-left: 0;
  }

  .about-principles li:last-child {
    border-right: 0;
  }

  .about-principles span {
    color: var(--signal);
    font-size: 0.65rem;
  }

  .about-principles strong {
    margin-top: 0.7rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1;
  }

  .about-principles p {
    max-width: 24rem;
    margin: 0.65rem 0 0;
    color: var(--graphite-light);
    font-size: 0.78rem;
  }

  @media (max-width: 73.99rem) {
    .about-main {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-copy {
      padding: 5rem var(--mobile-gutter);
    }

    .about-portrait {
      min-height: min(120vw, 46rem);
      border-top: 1px solid var(--graphite-dark);
      border-left: 0;
    }

    .about-principles {
      padding-inline: var(--mobile-gutter);
    }
  }

  @media (max-width: 39.99rem) {
    .about-copy {
      padding-block: 4rem;
    }

    .about-copy h2 {
      font-size: clamp(3.4rem, 15vw, 4.8rem);
    }

    .about-copy :global([data-stats]) {
      gap: 0.65rem;
    }

    .about-principles {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-principles li,
    .about-principles li:first-child {
      min-height: 8.5rem;
      padding: 1.25rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--graphite-dark);
    }

    .about-principles li:last-child {
      border-bottom: 0;
    }
  }
</style>
