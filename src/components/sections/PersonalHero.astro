---
import { Image } from 'astro:assets';
import chris from '../../assets/me/chris-snoek.jpg';
import ribbon from '../../assets/brand/living-ribbon-wide.png';
import Icon from '../Icon.astro';
import { CONTACT, SITE } from '../../config/site';

const phases = [
  {
    title: 'Design',
    text: 'Een merkverhaal en kooproute die eigen voelen.',
  },
  {
    title: 'Develop',
    text: 'Een snelle Shopify-frontend die je merk laat leven.',
  },
  {
    title: 'Maintain',
    text: 'Blijven testen, verbeteren en doorontwikkelen.',
  },
];
---

<section id="over" class="hero" aria-labelledby="hero-heading">
  <div class="shell shell--wide">
    <div class="hero__stage stage">
      <span class="sun hero__sun enter-fade" aria-hidden="true"></span>

      <div class="hero__copy">
        <p class="hero__intro kicker enter-up">Hoi, ik ben Chris—Shopify-designer en developer.</p>
        <h1 id="hero-heading" class="display-xl enter-lines" style="--enter-delay: 0.1s">
          <span class="line" style="--i:0"><span>Premium Shopify-webshops</span></span>
          <span class="line" style="--i:1"><span>die merken laten groeien.</span></span>
        </h1>
        <p class="hero__lead lead enter-up" style="--enter-delay: 0.38s">
          Geen ingekleurd thema, maar een eigen winkelervaring waarin verhaal, koopgemak en techniek
          elkaar versterken. Eén betrokken maker, van eerste concept tot ver na de livegang.
        </p>
        <div class="hero__actions enter-up" style="--enter-delay: 0.5s">
          <a href="#werk" class="btn btn--ink">
            Bekijk mijn ervaring
            <Icon name="arrowDown" size={18} />
          </a>
          <a
            href={CONTACT.bookingUrl}
            target="_blank"
            rel="noopener"
            class="btn btn--primary btn--up"
          >
            Bespreek je webshop
            <Icon name="arrowUpRight" size={18} />
          </a>
        </div>
      </div>

      <figure
        class="hero__person enter-unveil"
        style="--enter-delay: 0.25s; --unveil-radius: 1.5rem"
      >
        <div class="hero__portrait">
          <Image
            src={chris}
            alt={`Portret van ${SITE.author}`}
            widths={[420, 640, 840]}
            sizes="(max-width: 767px) 70vw, 32vw"
            format="avif"
            quality="high"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>

      <Image
        src={ribbon}
        alt=""
        widths={[840, 1280, 1686]}
        sizes="(max-width: 767px) 190vw, 105vw"
        format="webp"
        quality="high"
        class="hero__ribbon enter-fade"
        style="--enter-delay: 0.15s"
        loading="eager"
        aria-hidden="true"
      />
    </div>

    <nav class="hero__phases enter-up" style="--enter-delay: 0.65s" aria-label="Mijn werkwijze">
      {
        phases.map((phase) => (
          <a href="#werkwijze" class="hero__phase">
            <span class="hero__phase-title display-sm">{phase.title}</span>
            <span class="hero__phase-text">{phase.text}</span>
            <Icon name="arrowDown" size={18} />
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .hero {
    padding: 0.5rem 0 0;
  }

  .hero__stage {
    min-height: min(46rem, calc(100svh - var(--header-h) - 2rem));
  }

  .hero__sun {
    animation-duration: 1.8s;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    width: min(64%, 56rem);
    padding: clamp(3rem, 6vw, 5.5rem) 0 11rem clamp(1.5rem, 5vw, 5.5rem);
  }

  .hero__intro {
    margin-bottom: 1.5rem;
  }

  .hero__copy h1 {
    color: var(--ink);
    font-size: clamp(2.9rem, 1rem + 4.1vw, 5.6rem);
  }

  .hero__lead {
    max-width: 38rem;
    margin-top: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__person {
    position: absolute;
    z-index: 2;
    right: clamp(1.5rem, 5vw, 5rem);
    bottom: 2rem;
    width: min(32vw, 26rem);
    margin: 0;
  }

  .hero__portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 1.5rem clamp(5rem, 10vw, 8.5rem) 1.5rem 1.5rem;
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }
  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 40%;
    transform: scale(1.02);
  }

  .hero__ribbon {
    position: absolute;
    z-index: 1;
    right: -3%;
    bottom: -24%;
    width: 96%;
    max-width: none;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      transparent 21%,
      #000 43%,
      #000 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, transparent 21%, #000 43%, #000 100%);
    pointer-events: none;
    transform: rotate(-2deg);
    transform-origin: 72% 70%;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__ribbon {
        animation: ribbon-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 55rem;
      }
      .hero__sun {
        animation: sun-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 60rem;
      }
    }
  }
  @keyframes ribbon-drift {
    from {
      transform: translate3d(0, 0, 0) rotate(-1deg) scale(1);
    }
    to {
      transform: translate3d(3%, 2%, 0) rotate(1deg) scale(1.025);
    }
  }
  @keyframes sun-drift {
    from {
      transform: translate(-50%, -50%);
    }
    to {
      transform: translate(-50%, -20%) scale(1.15);
    }
  }

  /* Drie fases als rustige rij onder het podium; de pijlen wijzen naar de werkwijze. */
  .hero__phases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: min(100%, 78rem);
    margin: 2rem auto 0;
    padding: 0 clamp(0rem, 2vw, 1.5rem);
  }
  .hero__phase {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 0.9rem 3rem 0.9rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .hero__phase-title {
    transition: color 200ms ease;
  }
  .hero__phase-text {
    max-width: 19rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .hero__phase :global(svg) {
    position: absolute;
    top: 1.1rem;
    right: 0.5rem;
    color: var(--ink-soft);
    transition:
      transform 240ms var(--ease-out-soft),
      color 200ms ease;
  }
  .hero__phase:hover .hero__phase-title,
  .hero__phase:focus-visible .hero__phase-title {
    color: var(--vermilion-ink);
  }
  .hero__phase:hover :global(svg),
  .hero__phase:focus-visible :global(svg) {
    color: var(--vermilion-ink);
    transform: translateY(4px);
  }

  @media (max-width: 960px) {
    .hero__copy {
      width: 64%;
      padding-left: 2.25rem;
    }
    .hero__person {
      right: 1.75rem;
      bottom: 1.75rem;
      width: 31vw;
    }
    .hero__ribbon {
      right: -15%;
      bottom: -20%;
      width: 128%;
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0%,
        transparent 30%,
        #000 52%,
        #000 100%
      );
      mask-image: linear-gradient(90deg, transparent 0%, transparent 30%, #000 52%, #000 100%);
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 0.25rem;
    }
    .hero__stage {
      min-height: 0;
    }
    .hero__copy {
      width: 100%;
      padding: 2.75rem 1.25rem 19rem;
    }
    .hero__copy h1 {
      font-size: clamp(2.6rem, 11.5vw, 4rem);
    }
    .hero__lead {
      max-width: 31rem;
      margin-top: 1.4rem;
      font-size: 1.02rem;
    }
    .hero__actions {
      margin-top: 1.5rem;
    }
    .hero__actions > a {
      flex: 1 1 10rem;
    }
    .hero__person {
      right: 1rem;
      bottom: 1.25rem;
      width: min(56vw, 14.5rem);
    }
    .hero__portrait {
      border-radius: 1.1rem 4.75rem 1.1rem 1.1rem;
    }
    .hero__ribbon {
      right: -55%;
      bottom: -4%;
      width: 232%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__phases {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 1rem;
      padding: 0 0.25rem;
    }
    .hero__phase {
      padding: 1rem 3rem 1rem 0;
      border-bottom: 1px solid var(--line);
    }
    .hero__phase:last-child {
      border-bottom: 0;
    }
  }
</style>
