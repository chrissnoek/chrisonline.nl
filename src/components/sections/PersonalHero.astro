---
import { Image } from 'astro:assets';
import chris from '../../assets/me/chris-snoek.jpg';
import ribbon from '../../assets/brand/living-ribbon.png';
import Icon from '../Icon.astro';
import { CONTACT, SITE } from '../../config/site';

const phases = [
  {
    title: 'Design',
    text: 'Een helder verhaal en een visueel systeem dat eigen voelt.',
  },
  {
    title: 'Develop',
    text: 'Een levende frontend, snel gebouwd en toegankelijk voor iedereen.',
  },
  {
    title: 'Maintain',
    text: 'Blijven verbeteren op basis van gebruik, data en nieuwe ambities.',
  },
];
---

<section id="over" class="personal-hero scroll-mt-24" aria-labelledby="hero-heading">
  <div class="container-wide">
    <div class="hero-stage">
      <div class="hero-copy">
        <p class="hero-intro">Hoi, ik ben Chris—designer en developer.</p>
        <h1 id="hero-heading">Ik ontwerp digitale ervaringen die merken laten groeien.</h1>
        <p class="hero-lead">
          Van een sterk verhaal en onderscheidend ontwerp tot een levende frontend die blijft
          presteren. Eén betrokken maker, van eerste idee tot ver na de livegang.
        </p>
        <div class="hero-actions">
          <a href="#werk" class="button button--dark">
            Bekijk mijn werk
            <Icon name="arrowDown" size={18} />
          </a>
          <a href={CONTACT.bookingUrl} target="_blank" rel="noopener" class="button button--line">
            Plan een gesprek
            <Icon name="arrowUpRight" size={18} />
          </a>
        </div>
      </div>

      <div class="hero-person">
        <div class="portrait-frame">
          <Image
            src={chris}
            alt={`Portret van ${SITE.author}`}
            widths={[420, 640, 840]}
            sizes="(max-width: 767px) 76vw, 34vw"
            format="avif"
            quality="high"
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        </div>
        <p><strong>{SITE.author}</strong><span>{SITE.jobTitle}</span></p>
      </div>

      <Image
        src={ribbon}
        alt=""
        widths={[720, 1080, 1500]}
        sizes="(max-width: 767px) 150vw, 90vw"
        format="webp"
        quality="high"
        class="hero-ribbon"
        aria-hidden="true"
      />
    </div>

    <nav class="phase-dock" aria-label="Mijn werkwijze">
      {
        phases.map((phase) => (
          <a href="#werkwijze" class="phase-link">
            <span>{phase.title}</span>
            <p>{phase.text}</p>
            <Icon name="arrowDown" size={17} />
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .personal-hero {
    padding: 1rem 0 0;
  }

  .container-wide {
    width: min(100% - 2rem, 88rem);
    margin-inline: auto;
  }

  .hero-stage {
    position: relative;
    min-height: min(44rem, calc(100svh - 8rem));
    overflow: hidden;
    border: 1px solid #deded9;
    border-radius: 2rem;
    background: #f5f5f2;
    isolation: isolate;
  }

  .hero-stage::before {
    content: none;
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    width: min(58%, 49rem);
    padding: clamp(3rem, 6vw, 5rem) 0 11.5rem clamp(1.5rem, 5vw, 5.5rem);
  }

  .hero-intro {
    margin-bottom: 1.4rem;
    color: #cf3717;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 650;
  }

  h1 {
    max-width: 15ch;
    color: #111111;
    font-size: clamp(3rem, 5.3vw, 5.3rem);
    font-weight: 570;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 39rem;
    margin-top: 2rem;
    color: #4b4b48;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.8rem 1.25rem;
    border-radius: 0.8rem;
    font-size: 0.94rem;
    font-weight: 650;
    line-height: 1;
    transition:
      transform 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button--dark {
    background: #111111;
    color: #ffffff;
  }

  .button--line {
    border: 1px solid #a8a8a3;
    color: #111111;
  }

  .button--line:hover,
  .button--line:focus-visible {
    background: #ffffff;
  }

  .hero-person {
    position: absolute;
    z-index: 2;
    right: clamp(1.5rem, 5vw, 5rem);
    bottom: 4.5rem;
    width: min(33vw, 27rem);
  }

  .portrait-frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 0.45rem solid rgba(255, 255, 255, 0.9);
    border-radius: 48% 48% 1.4rem 1.4rem;
    background: #e6e6e1;
    box-shadow: 0 2rem 5rem rgba(17, 17, 17, 0.13);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 42%;
    transform: scale(1.025);
  }

  .hero-person > p {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    color: #333331;
    font-size: 0.85rem;
  }

  .hero-person strong {
    color: #111111;
    font-weight: 680;
  }

  .hero-person span {
    text-align: right;
  }

  .hero-ribbon {
    position: absolute;
    z-index: 1;
    right: -7%;
    bottom: -35%;
    width: 73%;
    max-width: none;
    pointer-events: none;
    transform: rotate(-1deg);
    transform-origin: 72% 70%;
  }

  .phase-dock {
    position: relative;
    z-index: 5;
    display: grid;
    width: min(74rem, calc(100% - 5rem));
    margin: -4.35rem auto 0;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 1px solid #dcdcd7;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 1.2rem 3.8rem rgba(17, 17, 17, 0.1);
    backdrop-filter: blur(18px);
  }

  .phase-link {
    position: relative;
    min-height: 8.6rem;
    padding: 1.45rem 3.2rem 1.45rem 1.65rem;
    color: #111111;
    transition: background-color 180ms ease;
  }

  .phase-link + .phase-link {
    box-shadow: -1px 0 0 #deded9;
  }

  .phase-link:hover,
  .phase-link:focus-visible {
    background: #f4f4f0;
  }

  .phase-link > span {
    display: block;
    font-size: 1.1rem;
    font-weight: 680;
  }

  .phase-link p {
    max-width: 19rem;
    margin-top: 0.5rem;
    color: #64645f;
    font-size: 0.83rem;
    line-height: 1.45;
  }

  .phase-link :global(svg) {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    transition: transform 180ms ease;
  }

  .phase-link:hover :global(svg),
  .phase-link:focus-visible :global(svg) {
    transform: translateY(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-ribbon {
        animation: ribbon-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 55rem;
      }
    }
  }

  @keyframes ribbon-drift {
    from {
      transform: translate3d(0, 0, 0) rotate(-1deg) scale(1);
    }
    to {
      transform: translate3d(4%, 9%, 0) rotate(2deg) scale(1.035);
    }
  }

  @media (max-width: 960px) {
    .hero-copy {
      width: 63%;
      padding-left: 2.5rem;
    }

    .hero-person {
      right: 2rem;
      width: 31vw;
    }

    .hero-person > p span {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .personal-hero {
      padding-top: 0.5rem;
    }

    .container-wide {
      width: min(100% - 1rem, 35rem);
    }

    .hero-stage {
      min-height: 57rem;
      border-radius: 1.35rem;
    }

    .hero-copy {
      width: 100%;
      padding: 3rem 1.25rem 18.5rem;
    }

    .hero-intro {
      margin-bottom: 1rem;
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(2.8rem, 14.7vw, 4rem);
      line-height: 0.97;
    }

    .hero-lead {
      max-width: 31rem;
      margin-top: 1.4rem;
      font-size: 1rem;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .button {
      flex: 1 1 10rem;
    }

    .hero-person {
      right: 1.25rem;
      bottom: 1.8rem;
      width: min(46vw, 12rem);
    }

    .portrait-frame {
      border-width: 0.3rem;
      border-radius: 48% 48% 1rem 1rem;
    }

    .hero-person > p {
      display: none;
    }

    .hero-ribbon {
      right: auto;
      bottom: -5%;
      left: -50%;
      width: 196%;
    }

    .phase-dock {
      width: calc(100% - 1rem);
      margin-top: -1rem;
      grid-template-columns: 1fr;
      border-radius: 1rem;
    }

    .phase-link {
      min-height: 0;
      padding: 1.25rem 3.1rem 1.25rem 1.25rem;
    }

    .phase-link + .phase-link {
      border-top: 1px solid #deded9;
      box-shadow: none;
    }
  }
</style>
