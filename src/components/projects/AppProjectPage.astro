---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { withUtm } from '../../utils/utm';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
  jsonLd: Record<string, unknown>;
}

const { entry, prev, next, jsonLd } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const dateLabel = data.pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={data.title} description={data.summary} type="article" jsonLd={[jsonLd]}>
  <article class="app-project">
    <div class="app-project-container">
      <a href="/#werk" class="back-link enter-up">
        <Icon name="arrowLeft" size={17} />
        Terug naar werk
      </a>

      <header class="app-project-hero">
        <div class="app-project-copy">
          <h1 class="enter-up" style="--enter-delay: 0.08s">{data.heroTitle ?? data.title}</h1>
          <p class="app-project-summary enter-up" style="--enter-delay: 0.16s">
            {data.summary}
          </p>
          <div class="app-project-actions enter-up" style="--enter-delay: 0.24s">
            {
              data.url && (
                <a href={withUtm(data.url)} target="_blank" rel="noopener" class="store-link">
                  {data.urlLabel}
                  <Icon name="arrowUpRight" size={18} />
                </a>
              )
            }
            <span>Live sinds {dateLabel}</span>
          </div>
        </div>

        <figure class="app-project-cover enter-up" style="--enter-delay: 0.18s">
          <Image
            src={data.cover}
            alt={data.coverAlt}
            widths={[720, 1080, 1440, data.cover.width]}
            sizes="(max-width: 899px) 100vw, 58vw"
            format="avif"
            quality="high"
            priority
            transition:name={`cover-${entry.id}`}
          />
          <figcaption>{data.coverAlt}</figcaption>
        </figure>
      </header>

      {
        data.highlights.length > 0 && (
          <section class="app-project-highlights" aria-label="Project in het kort">
            {data.highlights.map((highlight) => (
              <div class="reveal-up">
                <h2>{highlight.title}</h2>
                <p>{highlight.description}</p>
              </div>
            ))}
          </section>
        )
      }

      <div class="app-project-content prose-project reveal-up">
        <Content />
      </div>

      {
        data.gallery.length > 0 && (
          <section class="app-project-gallery" aria-labelledby="app-gallery-heading">
            <div class="gallery-heading reveal-up">
              <h2 id="app-gallery-heading">Van beheer naar zichtbaar resultaat</h2>
              <p>Echte schermen uit de gepubliceerde app en de Shopify-omgeving.</p>
            </div>
            <div class="gallery-grid">
              {data.gallery.map((shot, index) => (
                <figure class:list={['reveal-up', index === 0 && 'gallery-featured']}>
                  <div class="gallery-image-wrap">
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[640, 960, 1280, shot.src.width]}
                      sizes={
                        index === 0
                          ? '(max-width: 899px) 100vw, 74vw'
                          : '(max-width: 899px) 100vw, 46vw'
                      }
                      format="avif"
                      quality="high"
                      loading={index < 2 ? 'eager' : 'lazy'}
                    />
                  </div>
                  <figcaption>
                    <span>{shot.url}</span>
                    <p>{shot.alt}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        data.relatedKnowledge.length > 0 && (
          <section class="related-knowledge" aria-labelledby="related-heading">
            <div>
              <h2 id="related-heading">De gedachte achter het product</h2>
              <p>Praktische gidsen over het klantprobleem waarop deze app is gericht.</p>
            </div>
            <nav aria-label="Gerelateerde kennisartikelen">
              {data.relatedKnowledge.map((item) => (
                <a href={item.href}>
                  <span>{item.title}</span>
                  <Icon name="arrowRight" size={19} />
                </a>
              ))}
            </nav>
          </section>
        )
      }

      {
        (prev || next) && (
          <nav class="project-neighbours" aria-label="Meer projecten">
            {prev ? (
              <a href={`/werk/${prev.id}`}>
                <Icon name="arrowLeft" size={18} />
                <span>
                  <small>Vorig project</small>
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={`/werk/${next.id}`} class="next-project">
                <span>
                  <small>Volgend project</small>
                  {next.data.title}
                </span>
                <Icon name="arrowRight" size={18} />
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>

  <section class="app-project-cta">
    <div>
      <h2>Een specifiek Shopify-probleem dat om een eigen oplossing vraagt?</h2>
      <p>
        Ik denk mee over de kleinste app, extensie of themewijziging die het probleem echt oplost.
      </p>
      <a href="/contact?dienst=shopify">
        Bespreek je idee
        <Icon name="arrowRight" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .app-project {
    padding: clamp(2.25rem, 4vw, 4rem) 0 clamp(6rem, 10vw, 10rem);
    background: #fff;
    color: #111;
  }

  .app-project-container,
  .app-project-cta > div {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #686863;
    font-size: 0.88rem;
    font-weight: 560;
    transition: color 180ms ease;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: #111;
  }

  .app-project-hero {
    display: grid;
    min-height: 31rem;
    margin-top: 2rem;
    align-items: center;
    grid-template-columns: minmax(22rem, 0.9fr) minmax(30rem, 1.1fr);
    gap: clamp(2.5rem, 4vw, 4rem);
  }

  .app-project-copy h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 4.8vw, 5.2rem);
    font-weight: 640;
    letter-spacing: -0.06em;
    line-height: 0.95;
    overflow-wrap: normal;
    word-break: normal;
  }

  .app-project-summary {
    max-width: 34rem;
    margin-top: 1.6rem;
    color: #565652;
    font-size: clamp(1.08rem, 1.35vw, 1.3rem);
    line-height: 1.55;
  }

  .app-project-actions {
    display: flex;
    margin-top: 2rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.3rem;
  }

  .store-link,
  .app-project-cta a {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.8rem 1.2rem;
    border-radius: 0.65rem;
    background: #111;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 650;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .store-link:hover,
  .store-link:focus-visible,
  .app-project-cta a:hover,
  .app-project-cta a:focus-visible {
    background: #ee4b24;
    transform: translateY(-2px);
  }

  .app-project-actions > span {
    color: #71716b;
    font-size: 0.83rem;
  }

  .app-project-cover {
    min-width: 0;
  }

  .app-project-cover img,
  .gallery-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
  }

  .app-project-cover img {
    border: 1px solid #dadad5;
    border-radius: 1.4rem;
    box-shadow: 0 24px 70px -46px rgba(17, 17, 17, 0.55);
  }

  .app-project-cover figcaption {
    max-width: 42rem;
    margin-top: 0.8rem;
    color: #777771;
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .app-project-highlights {
    display: grid;
    margin-top: clamp(3rem, 5vw, 5rem);
    border-block: 1px solid #deded9;
    grid-template-columns: repeat(3, 1fr);
  }

  .app-project-highlights > div {
    padding: 2rem clamp(1.25rem, 3vw, 2.5rem) 2.2rem 0;
  }

  .app-project-highlights > div + div {
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid #deded9;
  }

  .app-project-highlights h2 {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .app-project-highlights p {
    margin-top: 0.65rem;
    color: #62625d;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .app-project-content {
    max-width: 47rem;
    margin: clamp(5rem, 9vw, 9rem) auto 0;
  }

  .app-project-gallery {
    margin-top: clamp(6rem, 10vw, 10rem);
  }

  .gallery-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .gallery-heading h2,
  .related-knowledge h2,
  .app-project-cta h2 {
    max-width: 14ch;
    font-size: clamp(2.25rem, 4.4vw, 4.3rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .gallery-heading p,
  .related-knowledge > div > p {
    max-width: 29rem;
    color: #686863;
  }

  .gallery-grid {
    display: grid;
    margin-top: 2.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 1.5rem;
  }

  .gallery-featured {
    grid-column: 1 / -1;
  }

  .gallery-image-wrap {
    overflow: hidden;
    border: 1px solid #deded9;
    border-radius: 1rem;
    background: #f5f5f2;
  }

  .gallery-grid figcaption {
    padding: 0.9rem 0.1rem 0;
  }

  .gallery-grid figcaption span {
    color: #111;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .gallery-grid figcaption p {
    max-width: 44rem;
    margin-top: 0.3rem;
    color: #70706b;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .related-knowledge {
    display: grid;
    margin-top: clamp(6rem, 10vw, 10rem);
    padding: clamp(2rem, 4vw, 4rem) 0;
    border-block: 1px solid #deded9;
    grid-template-columns: 0.78fr 1.22fr;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .related-knowledge nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid #deded9;
    color: #111;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
    transition: color 180ms ease;
  }

  .related-knowledge nav a:first-child {
    border-top: 1px solid #deded9;
  }

  .related-knowledge nav a:hover,
  .related-knowledge nav a:focus-visible {
    color: #d23d1d;
  }

  .project-neighbours {
    display: grid;
    margin-top: 4rem;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-neighbours a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: #111;
    font-size: 0.95rem;
    font-weight: 620;
  }

  .project-neighbours .next-project {
    justify-content: flex-end;
    text-align: right;
  }

  .project-neighbours small {
    display: block;
    margin-bottom: 0.15rem;
    color: #767670;
    font-size: 0.72rem;
    font-weight: 520;
  }

  .app-project-cta {
    padding: clamp(5rem, 8vw, 8rem) 0;
    background: #101011;
    color: #fff;
  }

  .app-project-cta > div {
    display: grid;
    align-items: end;
    grid-template-columns: 1.2fr 0.75fr auto;
    gap: 2rem;
  }

  .app-project-cta p {
    color: #b9b9b3;
    line-height: 1.6;
  }

  @media (max-width: 899px) {
    .app-project-container,
    .app-project-cta > div {
      width: min(100% - 2.5rem, 42rem);
    }

    .app-project-hero,
    .related-knowledge,
    .app-project-cta > div {
      grid-template-columns: 1fr;
    }

    .app-project-hero {
      min-height: 0;
      gap: 2.5rem;
    }

    .app-project-copy h1 {
      max-width: 12ch;
    }

    .app-project-highlights {
      grid-template-columns: 1fr;
    }

    .app-project-highlights > div,
    .app-project-highlights > div + div {
      padding: 1.5rem 0;
      border-left: 0;
    }

    .app-project-highlights > div + div {
      border-top: 1px solid #deded9;
    }

    .gallery-heading {
      display: block;
    }

    .gallery-heading p {
      margin-top: 1rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 2.6rem;
    }

    .gallery-featured {
      grid-column: auto;
    }
  }

  @media (max-width: 560px) {
    .app-project-copy h1 {
      font-size: clamp(2.65rem, 13vw, 4.2rem);
    }

    .project-neighbours {
      grid-template-columns: 1fr;
    }

    .project-neighbours .next-project {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
