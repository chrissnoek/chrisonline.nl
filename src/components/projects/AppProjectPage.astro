---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import { withUtm } from '../../utils/utm';
import { appName } from '../../lib/shopify-apps';
import { breadcrumbLd } from '../../lib/seo';
import { SITE } from '../../config/site';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
  jsonLd: Record<string, unknown>;
}

const { entry, prev, next, jsonLd } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const dateLabel = data.pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Shopify Apps', href: '/shopify-apps/' },
  { label: appName(entry) },
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  type="article"
  jsonLd={[
    jsonLd,
    breadcrumbLd(crumbs, `/werk/${entry.id}/`),
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      url: `${SITE.url}/werk/${entry.id}/`,
      name: data.title,
      description: data.summary,
      inLanguage: 'nl',
      mainEntity: { '@id': `${SITE.url}/werk/${entry.id}/#software` },
      ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
    },
  ]}
  markdown={`/werk/${entry.id}.md`}
>
  <article class="app">
    <div class="shell">
      <Breadcrumbs items={crumbs} class="enter-up" />

      <header class="app__hero">
        <div class="app__copy">
          <h1 class="display-lg enter-up" style="--enter-delay: 0.08s">
            {data.heroTitle ?? data.title}
          </h1>
          <p class="lead enter-up" style="--enter-delay: 0.16s">{data.summary}</p>
          <div class="app__actions enter-up" style="--enter-delay: 0.24s">
            {
              data.url && (
                <a
                  href={withUtm(data.url)}
                  target="_blank"
                  rel="noopener"
                  class="btn btn--ink btn--up"
                >
                  {data.urlLabel}
                  <Icon name="arrowUpRight" size={18} />
                </a>
              )
            }
            <span class="meta">Live sinds {dateLabel}</span>
          </div>
        </div>

        <figure
          class="app__cover enter-unveil"
          style="--enter-delay: 0.2s; --unveil-radius: var(--radius-stage)"
        >
          <div class="frame frame--lift">
            <Image
              src={data.cover}
              alt={data.coverAlt}
              widths={[720, 1080, 1440, data.cover.width]}
              sizes="(max-width: 899px) 100vw, 58vw"
              format="avif"
              quality="high"
              priority
              transition:name={`cover-${entry.id}`}
            />
          </div>
          <figcaption class="meta">{data.coverAlt}</figcaption>
        </figure>
      </header>

      {
        data.application && (
          <section
            class="app__facts surface surface--deep reveal-up"
            aria-labelledby="app-facts-heading"
          >
            <div>
              <h2 id="app-facts-heading" class="display-sm">
                Wat doet {appName(entry)}?
              </h2>
              <ul>
                {data.application.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
            <dl>
              <div>
                <dt>Voor wie</dt>
                <dd>{data.application.audience}</dd>
              </div>
              <div>
                <dt>App-talen</dt>
                <dd>{data.application.languages.join(' en ')}</dd>
              </div>
              <div>
                <dt>Maker</dt>
                <dd>Chris Snoek, Chris Online</dd>
              </div>
            </dl>
          </section>
        )
      }

      {
        data.highlights.length > 0 && (
          <section class="app__highlights reveal-up" aria-label="Project in het kort">
            {data.highlights.map((highlight) => (
              <div>
                <h2>{highlight.title}</h2>
                <p>{highlight.description}</p>
              </div>
            ))}
          </section>
        )
      }
    </div>

    <div class="shell shell--read app__content">
      <div class="prose reveal-up">
        {
          data.updatedDate && (
            <p class="meta">
              Productinformatie bijgewerkt op{' '}
              <time datetime={data.updatedDate.toISOString().split('T')[0]}>
                {data.updatedDate.toLocaleDateString('nl-NL', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
              .
            </p>
          )
        }
        <Content />
      </div>
    </div>

    <div class="shell">
      {
        data.gallery.length > 0 && (
          <section class="app__gallery" aria-labelledby="app-gallery-heading">
            <div class="app__gallery-head lift-in">
              <h2 id="app-gallery-heading" class="display-md">
                Van beheer naar zichtbaar resultaat
              </h2>
              <p class="lead">Echte schermen uit de gepubliceerde app en de Shopify-omgeving.</p>
            </div>
            <div class="app__gallery-grid">
              {data.gallery.map((shot, index) => (
                <figure class:list={['reveal-up', index === 0 && 'app__gallery-featured']}>
                  <div class="frame">
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[640, 960, 1280, shot.src.width]}
                      sizes={
                        index === 0
                          ? '(max-width: 899px) 100vw, 74vw'
                          : '(max-width: 899px) 100vw, 46vw'
                      }
                      format="avif"
                      quality="high"
                      loading={index < 2 ? 'eager' : 'lazy'}
                    />
                  </div>
                  <figcaption>
                    <span>{shot.url}</span>
                    <p class="meta">{shot.alt}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        data.relatedKnowledge.length > 0 && (
          <section class="app__related reveal-up" aria-labelledby="related-heading">
            <div>
              <h2 id="related-heading" class="display-md">
                De gedachte achter het product
              </h2>
              <p class="lead">
                Praktische gidsen over het klantprobleem waarop deze app is gericht.
              </p>
            </div>
            <nav class="rows" aria-label="Gerelateerde kennisartikelen">
              {data.relatedKnowledge.map((item) => (
                <a href={item.href} class="app__related-link">
                  <span>{item.title}</span>
                  <Icon name="arrowRight" size={19} />
                </a>
              ))}
            </nav>
          </section>
        )
      }

      {
        (prev || next) && (
          <nav class="app__neighbours reveal-up" aria-label="Meer Shopify Apps">
            {prev ? (
              <a href={`/werk/${prev.id}`} class="app__neighbour">
                <Icon name="arrowLeft" size={18} />
                <span>
                  <span class="meta">Vorige app</span>
                  <span class="app__neighbour-title">{prev.data.title}</span>
                </span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={`/werk/${next.id}`} class="app__neighbour app__neighbour--next">
                <span>
                  <span class="meta">Volgende app</span>
                  <span class="app__neighbour-title">{next.data.title}</span>
                </span>
                <Icon name="arrowRight" size={18} />
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>

  <CtaBand
    id="app-cta-heading"
    compact
    title="Een specifiek Shopify-probleem dat om een eigen oplossing vraagt?"
    text="Ik denk mee over de kleinste app, extensie of themewijziging die het probleem echt oplost."
    primary={{ label: 'Bespreek je idee', href: '/contact?dienst=shopify' }}
  />
</BaseLayout>

<style>
  .app {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 8vw, 7rem);
  }

  .app__hero {
    display: grid;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .app__copy h1 {
    overflow-wrap: anywhere;
  }
  .app__copy .lead {
    max-width: 34rem;
    margin-top: 1.5rem;
  }
  .app__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.3rem;
    margin-top: 2rem;
  }

  .app__cover {
    min-width: 0;
    margin: 0;
  }
  .app__cover .frame {
    border-radius: var(--radius-stage);
    background: var(--paper-raised);
  }
  .app__cover img {
    width: 100%;
    height: auto;
  }
  .app__cover figcaption {
    max-width: 42rem;
    margin-top: 0.8rem;
    font-size: 0.78rem;
  }

  .app__facts {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding: clamp(1.5rem, 3vw, 2.75rem);
  }
  .app__facts ul {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.2rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-soft);
  }
  .app__facts li::marker {
    color: var(--vermilion-ink);
  }
  .app__facts dl {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .app__facts dt {
    font-weight: 600;
  }
  .app__facts dd {
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }

  .app__highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .app__highlights h2 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .app__highlights p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .app__content {
    margin-top: clamp(4rem, 7vw, 6.5rem);
  }

  .app__gallery {
    margin-top: clamp(4.5rem, 8vw, 7rem);
  }
  .app__gallery-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .app__gallery-head h2 {
    max-width: 14ch;
  }
  .app__gallery-head .lead {
    max-width: 28rem;
    font-size: 1rem;
  }
  .app__gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 1.5rem;
    margin-top: 2.5rem;
  }
  .app__gallery-grid figure {
    margin: 0;
  }
  .app__gallery-featured {
    grid-column: 1 / -1;
  }
  .app__gallery-grid img {
    width: 100%;
    height: auto;
  }
  .app__gallery-grid figcaption {
    padding: 0.9rem 0.1rem 0;
  }
  .app__gallery-grid figcaption span {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .app__gallery-grid figcaption p {
    max-width: 44rem;
    margin-top: 0.25rem;
    font-size: 0.82rem;
  }

  .app__related {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: clamp(4.5rem, 8vw, 7rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .app__related h2 {
    max-width: 14ch;
  }
  .app__related .lead {
    max-width: 28rem;
    margin-top: 1rem;
    font-size: 1rem;
  }
  .app__related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.25rem 0;
    color: var(--ink);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .app__related-link :global(svg) {
    flex: none;
    transition: transform 240ms var(--ease-out-soft);
  }
  .app__related-link:hover,
  .app__related-link:focus-visible {
    color: var(--vermilion-ink);
  }
  .app__related-link:hover :global(svg) {
    transform: translateX(4px);
  }

  .app__neighbours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .app__neighbour {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  .app__neighbour > span {
    display: grid;
    gap: 0.15rem;
  }
  .app__neighbour-title {
    font-weight: 600;
    line-height: 1.3;
    transition: color 180ms ease;
  }
  .app__neighbour :global(svg) {
    flex: none;
    transition: transform 240ms var(--ease-out-soft);
  }
  .app__neighbour:hover .app__neighbour-title,
  .app__neighbour:focus-visible .app__neighbour-title {
    color: var(--vermilion-ink);
  }
  .app__neighbour:hover :global(svg) {
    transform: translateX(-4px);
  }
  .app__neighbour--next {
    justify-content: flex-end;
    text-align: right;
  }
  .app__neighbour--next:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 899px) {
    .app__hero,
    .app__related {
      grid-template-columns: 1fr;
    }
    .app__hero {
      gap: 2rem;
    }
    .app__facts {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .app__highlights {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .app__gallery-head {
      display: block;
    }
    .app__gallery-head .lead {
      margin-top: 1rem;
    }
    .app__gallery-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .app__gallery-featured {
      grid-column: auto;
    }
  }
  @media (max-width: 560px) {
    .app__neighbours {
      grid-template-columns: 1fr;
    }
    .app__neighbour--next {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
