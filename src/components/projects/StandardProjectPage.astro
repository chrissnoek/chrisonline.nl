---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import BrowserFrame from '../BrowserFrame.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import { SITE } from '../../config/site';
import { withUtm } from '../../utils/utm';
import { breadcrumbLd } from '../../lib/seo';

interface Props {
  entry: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const dateLabel = data.pubDate.toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  headline: data.title,
  description: data.summary,
  url: pageUrl,
  about: data.skills.join(', '),
  dateCreated: data.pubDate.toISOString().split('T')[0],
  image: new URL(data.cover.src, Astro.site).href,
  creator: { '@id': `${origin}/#person` },
  ...(data.url ? { sameAs: [data.url] } : {}),
};

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Ervaring', href: '/#werk' },
  { label: data.title },
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  type="article"
  jsonLd={[creativeWorkLd, breadcrumbLd(crumbs, Astro.url.pathname)]}
>
  <article class="case">
    <div class="shell">
      <Breadcrumbs items={crumbs} class="enter-up" />

      <header class="case__header">
        <p class="case__meta meta enter-up" style="--enter-delay: 0.05s">
          <span class="case__role">{data.role}</span>
          <time datetime={data.pubDate.toISOString()}>{dateLabel}</time>
          {
            data.opdrachtgever && (
              <span>
                In opdracht van{' '}
                {data.opdrachtgever.url ? (
                  <a
                    href={withUtm(data.opdrachtgever.url)}
                    target="_blank"
                    rel="noopener"
                    class="text-link"
                  >
                    {data.opdrachtgever.name}
                  </a>
                ) : (
                  <strong>{data.opdrachtgever.name}</strong>
                )}
              </span>
            )
          }
          {data.placeholder && <span class="chip">placeholder-content</span>}
        </p>
        <h1 class="display-lg enter-up" style="--enter-delay: 0.12s">{data.title}</h1>
        <p class="lead enter-up" style="--enter-delay: 0.2s">{data.summary}</p>

        <div class="case__skills enter-up" style="--enter-delay: 0.28s">
          {data.skills.map((skill) => <span class="chip">{skill}</span>)}
        </div>

        {
          data.url && (
            <div class="case__live enter-up" style="--enter-delay: 0.34s">
              <a
                href={withUtm(data.url)}
                target="_blank"
                rel="noopener"
                class="btn btn--ink btn--up"
              >
                {data.urlLabel}
                <Icon name="arrowUpRight" size={18} />
              </a>
              {data.demoPassword && (
                <span class="case__password meta">
                  Wachtwoord: <code>{data.demoPassword}</code>
                </span>
              )}
            </div>
          )
        }
      </header>

      <figure
        class="case__cover frame enter-unveil"
        style={`--enter-delay: 0.3s; --unveil-radius: var(--radius-stage); --case-accent:${data.accent}`}
      >
        <Image
          src={data.cover}
          alt={data.coverAlt}
          widths={[640, 960, 1280, data.cover.width]}
          sizes="(max-width: 900px) 100vw, 1280px"
          format="avif"
          quality="high"
          priority
          transition:name={`cover-${entry.id}`}
        />
        <figcaption class="visually-hidden">{data.coverAlt}</figcaption>
      </figure>
    </div>

    <div class="shell shell--read case__body">
      <div class="prose">
        <Content />
      </div>

      {
        data.externalLinks.length > 0 && (
          <section class="case__external reveal-up" aria-labelledby="live-heading">
            <h2 id="live-heading" class="display-sm">
              Bekijk live
            </h2>
            <div class="case__external-links">
              {data.externalLinks.map((link) => (
                <a
                  href={withUtm(link.url)}
                  target="_blank"
                  rel="noopener"
                  class="link-arrow link-arrow--up"
                >
                  {link.label}
                  <Icon name="arrowUpRight" size={17} />
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>

    {
      data.gallery.length > 0 && (
        <section class="shell case__gallery" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="display-md lift-in">
            Uit het ontwerp
          </h2>
          <ul
            class:list={[
              'case__gallery-grid reveal-up',
              data.gallery.length % 2 === 1 && 'case__gallery-grid--odd',
            ]}
          >
            {data.gallery.map((shot, i) => (
              <li>
                <BrowserFrame src={shot.src} alt={shot.alt} url={shot.url} eager={i < 2} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav class="shell case__neighbours reveal-up" aria-label="Meer projecten">
          {prev ? (
            <a href={`/werk/${prev.id}`} class="case__neighbour">
              <Icon name="arrowLeft" size={18} />
              <span>
                <span class="meta">Vorige</span>
                <span class="case__neighbour-title">{prev.data.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={`/werk/${next.id}`} class="case__neighbour case__neighbour--next">
              <span>
                <span class="meta">Volgende</span>
                <span class="case__neighbour-title">{next.data.title}</span>
              </span>
              <Icon name="arrowRight" size={18} />
            </a>
          )}
        </nav>
      )
    }
  </article>

  <CtaBand
    id="case-cta-heading"
    compact
    title="Zoiets voor jouw merk?"
    text={`Laten we bespreken hoe ik ${SITE.brand} kan inzetten voor jouw project.`}
    primary={{ label: 'Neem contact op', href: '/contact' }}
  />
</BaseLayout>

<style>
  .case {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 8vw, 7rem);
  }

  .case__header {
    max-width: 52rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
  }
  .case__role {
    color: var(--vermilion-ink);
    font-weight: 600;
  }
  .case__meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  .case__header h1 {
    margin-top: 1rem;
  }
  .case__header .lead {
    max-width: 44rem;
    margin-top: 1.5rem;
  }
  .case__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .case__live {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }
  .case__password code {
    padding: 0.15em 0.45em;
    border-radius: 0.35em;
    background: var(--paper-deep);
    color: var(--ink);
    font-weight: 600;
  }

  .case__cover {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-radius: var(--radius-stage);
    background:
      radial-gradient(
        120% 120% at 80% 0%,
        color-mix(in srgb, var(--case-accent) 18%, transparent),
        transparent 60%
      ),
      var(--paper-deep);
  }
  .case__cover img {
    width: 100%;
    height: auto;
  }

  .case__body {
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .case__external {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .case__external-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin-top: 0.75rem;
  }

  .case__gallery {
    margin-top: clamp(4rem, 7vw, 6rem);
  }
  .case__gallery-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .case__gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case__gallery-grid--odd > li:last-child {
      grid-column: 1 / -1;
      width: calc(50% - 0.75rem);
      margin-inline: auto;
    }
  }

  .case__neighbours {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .case__neighbour {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  .case__neighbour > span {
    display: grid;
    gap: 0.15rem;
  }
  .case__neighbour-title {
    font-weight: 600;
    line-height: 1.3;
    transition: color 180ms ease;
  }
  .case__neighbour :global(svg) {
    flex: none;
    transition: transform 240ms var(--ease-out-soft);
  }
  .case__neighbour:hover .case__neighbour-title,
  .case__neighbour:focus-visible .case__neighbour-title {
    color: var(--vermilion-ink);
  }
  .case__neighbour:hover :global(svg) {
    transform: translateX(-4px);
  }
  .case__neighbour--next {
    justify-content: flex-end;
    text-align: right;
  }
  .case__neighbour--next:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 560px) {
    .case__neighbours {
      grid-template-columns: 1fr;
    }
    .case__neighbour--next {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
