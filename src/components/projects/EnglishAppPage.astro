---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { type EnglishApp, englishAppPath, englishAppStructuredData } from '../../lib/english-apps';
import { appName } from '../../lib/shopify-apps';
import { SITE, CONTACT } from '../../config/site';
import { withUtm } from '../../utils/utm';

interface Props {
  app: EnglishApp;
  relatedApp: EnglishApp | null;
}
const { app, relatedApp } = Astro.props;
const { project, translation } = app;
const { data } = translation;
const { Content } = await render(translation);
const guide = await getEntry('englishGuides', data.relatedGuide);
const url = `${SITE.url}${englishAppPath(project.id)}`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Shopify Apps',
      item: `${SITE.url}/en/shopify-apps/`,
    },
    { '@type': 'ListItem', position: 2, name: appName(project), item: url },
  ],
};
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#page`,
  name: data.title,
  description: data.description,
  url,
  inLanguage: 'en',
  dateModified: data.updatedDate.toISOString(),
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@id': `${SITE.url}/werk/${project.id}/#software` },
};
---

<BaseLayout
  lang="en"
  title={data.title}
  description={data.description}
  jsonLd={[englishAppStructuredData(app), pageLd, breadcrumbLd]}
  markdown={`/en/shopify-apps/${project.id}.md`}
>
  <article class="english-app">
    <div class="app-container">
      <nav class="app-breadcrumbs" aria-label="Breadcrumb">
        <a href="/en/shopify-apps/">Shopify Apps</a><span aria-hidden="true">/</span><span
          >{appName(project)}</span
        >
      </nav>
      <header class="app-hero">
        <div class="app-hero-copy">
          <h1 class="enter-up">{data.heroTitle}</h1>
          <p class="app-intro enter-up">{data.intro}</p>
          {
            project.data.url && (
              <a
                class="store-cta enter-up"
                href={withUtm(project.data.url)}
                target="_blank"
                rel="noopener"
                aria-label={`View ${appName(project)} in the Shopify App Store (new tab)`}
              >
                View in App Store <Icon name="arrowUpRight" size={18} />
              </a>
            )
          }
        </div>
        <figure class="app-hero-image enter-up">
          <Image
            src={project.data.cover}
            alt={data.coverAlt}
            widths={[640, 960, 1440]}
            sizes="(max-width: 899px) 100vw, 50vw"
            format="avif"
            quality="high"
            priority
          />
          <figcaption>{data.coverAlt}</figcaption>
        </figure>
      </header>

      <section class="app-facts" aria-labelledby="app-features-heading">
        <div>
          <h2 id="app-features-heading">What {appName(project)} does</h2>
          <ul>{data.features.map((feature) => <li>{feature}</li>)}</ul>
        </div>
        <dl>
          <div><dt>For your team</dt><dd>{data.audience}</dd></div>
          <div><dt>App interface</dt><dd>English</dd></div>
          <div><dt>Developed by</dt><dd>Chris Snoek, Chris Online</dd></div>
        </dl>
      </section>

      <div class="app-body prose-project">
        <p class="app-updated">
          Product information updated {
            data.updatedDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }.
        </p>
        <Content />
        {
          guide && (
            <aside class="app-guide">
              <>
                <h2>Try the practical workflow.</h2>
                <p>{guide.data.intro}</p>
                <a href={`/en/guides/${guide.id}/`}>
                  {guide.data.title} <Icon name="arrowRight" size={18} />
                </a>
              </>
            </aside>
          )
        }
      </div>

      <section class="app-gallery" aria-labelledby="screens-heading">
        <h2 id="screens-heading">See the checks in context.</h2>
        <p>Real app screens from a Shopify test store.</p>
        <div class="screens-grid">
          {
            project.data.gallery.map((shot, index) => (
              <figure>
                <div class="screen-image">
                  <Image
                    src={shot.src}
                    alt={data.galleryAlts[index]}
                    widths={[480, 720, 1080]}
                    sizes="(max-width: 767px) 100vw, 50vw"
                    format="avif"
                    quality="high"
                    loading="lazy"
                  />
                </div>
                <figcaption>{data.galleryAlts[index]}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="app-support" aria-labelledby="support-heading">
        <div>
          <h2 id="support-heading">Talk to the person who built it.</h2>
          <p>
            Have a question about setup, supported checks or whether {appName(project)} fits your store?
          </p>
          <a href={`mailto:${CONTACT.email}`}
            >Contact app support <Icon name="arrowRight" size={18} /></a
          >
        </div>
        {
          relatedApp && (
            <div class="related-app">
              <h3>Also from Chris Online</h3>
              <p>{relatedApp.translation.data.tagline}</p>
              <a href={englishAppPath(relatedApp.project.id)}>
                Explore {appName(relatedApp.project)} <Icon name="arrowRight" size={18} />
              </a>
            </div>
          )
        }
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .english-app {
    padding: clamp(2rem, 4vw, 4rem) 0 clamp(5rem, 8vw, 8rem);
    background: #fff;
    color: #111;
  }
  .app-container {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }
  .app-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: #62625e;
    font-size: 0.88rem;
  }
  .app-breadcrumbs a:hover {
    text-decoration: underline;
  }
  .app-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: 3rem 0;
  }
  h1 {
    font-size: clamp(2.5rem, 3.8vw, 4.2rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }
  .app-intro {
    max-width: 32rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.2rem;
    color: #565652;
    line-height: 1.55;
  }
  .store-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.15rem;
    padding: 0.8rem 1.2rem;
    border-radius: 0.75rem;
    background: #111;
    color: #fff;
    font-weight: 650;
    font-size: 0.9rem;
  }
  .store-cta:hover {
    background: #343430;
  }
  .app-hero-image {
    min-width: 0;
  }
  .app-hero-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    border: 1px solid #deded9;
  }
  figcaption {
    margin-top: 0.8rem;
    color: #62625e;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .app-facts {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #f5f5f2;
    border-radius: 1.25rem;
  }
  .app-facts h2 {
    font-size: 1.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .app-facts ul {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.2rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: #62625e;
  }
  .app-facts dl {
    display: grid;
    gap: 1.2rem;
    align-content: start;
  }
  dt {
    font-weight: 650;
  }
  dd {
    margin-top: 0.25rem;
    color: #62625e;
  }
  .app-body {
    max-width: 48rem;
    margin: clamp(4rem, 7vw, 7rem) auto;
  }
  .app-updated {
    color: #62625e;
    font-size: 0.85rem;
  }
  .app-guide {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #deded9;
  }
  .app-guide a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .app-gallery h2,
  .app-support h2 {
    font-size: clamp(2rem, 3.4vw, 3.3rem);
    line-height: 1.1;
    font-weight: 580;
    letter-spacing: -0.045em;
  }
  .app-gallery > p {
    margin-top: 1rem;
    color: #62625e;
  }
  .screens-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .screen-image {
    display: flex;
    align-items: center;
    aspect-ratio: 16 / 10;
    padding: 1rem;
    border-radius: 1.25rem;
    background: #f5f5f2;
  }
  .screen-image :global(img) {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  .app-support {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(4rem, 7vw, 7rem);
  }
  .app-support p {
    max-width: 36rem;
    margin-top: 1rem;
    color: #62625e;
  }
  .app-support a {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    gap: 0.6rem;
    margin-top: 1rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .related-app {
    padding: 2rem;
    background: #f5f5f2;
    border-radius: 1.25rem;
    align-self: start;
  }
  .related-app h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 620;
    letter-spacing: -0.035em;
  }
  @media (max-width: 899px) {
    .app-hero {
      grid-template-columns: 1fr;
    }
    .app-hero-copy {
      max-width: 38rem;
    }
  }
  @media (max-width: 767px) {
    .app-container {
      width: min(100% - 2.5rem, 35rem);
    }
    .app-facts,
    .screens-grid,
    .app-support {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .app-hero {
      padding-top: 2rem;
    }
    .app-intro {
      font-size: 1.05rem;
    }
  }
</style>
