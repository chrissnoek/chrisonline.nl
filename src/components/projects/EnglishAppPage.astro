---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { type EnglishApp, englishAppPath, englishAppStructuredData } from '../../lib/english-apps';
import { appName } from '../../lib/shopify-apps';
import { breadcrumbLd } from '../../lib/seo';
import { SITE, CONTACT } from '../../config/site';
import { withUtm } from '../../utils/utm';

interface Props {
  app: EnglishApp;
  relatedApp: EnglishApp | null;
}
const { app, relatedApp } = Astro.props;
const { project, translation } = app;
const { data } = translation;
const { Content } = await render(translation);
const guide = await getEntry('englishGuides', data.relatedGuide);
const url = `${SITE.url}${englishAppPath(project.id)}`;
const crumbs = [{ label: 'Shopify Apps', href: '/en/shopify-apps/' }, { label: appName(project) }];
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#page`,
  name: data.title,
  description: data.description,
  url,
  inLanguage: 'en',
  dateModified: data.updatedDate.toISOString(),
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@id': `${SITE.url}/werk/${project.id}/#software` },
};
---

<BaseLayout
  lang="en"
  title={data.title}
  description={data.description}
  jsonLd={[englishAppStructuredData(app), pageLd, breadcrumbLd(crumbs, englishAppPath(project.id))]}
  markdown={`/en/shopify-apps/${project.id}.md`}
>
  <article class="app">
    <div class="shell">
      <Breadcrumbs items={crumbs} lang="en" class="enter-up" />

      <header class="app__hero">
        <div class="app__copy">
          <h1 class="display-lg enter-up" style="--enter-delay: 0.08s">{data.heroTitle}</h1>
          <p class="lead enter-up" style="--enter-delay: 0.16s">{data.intro}</p>
          {
            project.data.url && (
              <div class="app__actions enter-up" style="--enter-delay: 0.24s">
                <a
                  class="btn btn--ink btn--up"
                  href={withUtm(project.data.url)}
                  target="_blank"
                  rel="noopener"
                  aria-label={`View ${appName(project)} in the Shopify App Store (new tab)`}
                >
                  View in App Store <Icon name="arrowUpRight" size={18} />
                </a>
              </div>
            )
          }
        </div>
        <figure
          class="app__cover enter-unveil"
          style="--enter-delay: 0.2s; --unveil-radius: var(--radius-stage)"
        >
          <div class="frame frame--lift">
            <Image
              src={project.data.cover}
              alt={data.coverAlt}
              widths={[640, 960, 1440]}
              sizes="(max-width: 899px) 100vw, 50vw"
              format="avif"
              quality="high"
              priority
            />
          </div>
          <figcaption class="meta">{data.coverAlt}</figcaption>
        </figure>
      </header>

      <section
        class="app__facts surface surface--deep reveal-up"
        aria-labelledby="app-features-heading"
      >
        <div>
          <h2 id="app-features-heading" class="display-sm">What {appName(project)} does</h2>
          <ul>{data.features.map((feature) => <li>{feature}</li>)}</ul>
        </div>
        <dl>
          <div><dt>For your team</dt><dd>{data.audience}</dd></div>
          <div><dt>App interface</dt><dd>English</dd></div>
          <div><dt>Developed by</dt><dd>Chris Snoek, Chris Online</dd></div>
        </dl>
      </section>
    </div>

    <div class="shell shell--read app__content">
      <div class="prose reveal-up">
        <p class="meta">
          Product information updated {
            data.updatedDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }.
        </p>
        <Content />
      </div>
      {
        guide && (
          <aside class="app__guide surface surface--deep reveal-up" aria-labelledby="guide-heading">
            <h2 id="guide-heading" class="display-sm">
              Try the practical workflow.
            </h2>
            <p>{guide.data.intro}</p>
            <a href={`/en/guides/${guide.id}/`} class="link-arrow link-arrow--accent">
              {guide.data.title} <Icon name="arrowRight" size={18} />
            </a>
          </aside>
        )
      }
    </div>

    <div class="shell">
      <section class="app__gallery" aria-labelledby="screens-heading">
        <div class="app__gallery-head lift-in">
          <h2 id="screens-heading" class="display-md">See the checks in context.</h2>
          <p class="lead">Real app screens from a Shopify test store.</p>
        </div>
        <div class="app__gallery-grid">
          {
            project.data.gallery.map((shot, index) => (
              <figure class="reveal-up">
                <div class="frame app__screen">
                  <Image
                    src={shot.src}
                    alt={data.galleryAlts[index]}
                    widths={[480, 720, 1080]}
                    sizes="(max-width: 767px) 100vw, 50vw"
                    format="avif"
                    quality="high"
                    loading="lazy"
                  />
                </div>
                <figcaption class="meta">{data.galleryAlts[index]}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="app__support reveal-up" aria-labelledby="support-heading">
        <div class="app__support-block surface surface--deep">
          <h2 id="support-heading" class="display-sm">Talk to the person who built it.</h2>
          <p>
            Have a question about setup, supported checks or whether {appName(project)} fits your store?
          </p>
          <a href={`mailto:${CONTACT.email}`} class="btn btn--ink"
            >Contact app support <Icon name="arrowRight" size={18} /></a
          >
        </div>
        {
          relatedApp && (
            <div class="app__support-block surface surface--deep">
              <h3 class="display-sm">Also from Chris Online</h3>
              <p>{relatedApp.translation.data.tagline}</p>
              <a href={englishAppPath(relatedApp.project.id)} class="link-arrow link-arrow--accent">
                Explore {appName(relatedApp.project)} <Icon name="arrowRight" size={18} />
              </a>
            </div>
          )
        }
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .app {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 8vw, 7rem);
  }

  .app__hero {
    display: grid;
    grid-template-columns: minmax(20rem, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .app__copy h1 {
    overflow-wrap: anywhere;
  }
  .app__copy .lead {
    max-width: 32rem;
    margin-top: 1.5rem;
  }
  .app__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .app__cover {
    min-width: 0;
    margin: 0;
  }
  .app__cover .frame {
    border-radius: var(--radius-stage);
    background: var(--paper-raised);
  }
  .app__cover img {
    width: 100%;
    height: auto;
  }
  .app__cover figcaption {
    max-width: 42rem;
    margin-top: 0.8rem;
    font-size: 0.78rem;
  }

  .app__facts {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding: clamp(1.5rem, 3vw, 2.75rem);
  }
  .app__facts ul {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.2rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-soft);
  }
  .app__facts li::marker {
    color: var(--vermilion-ink);
  }
  .app__facts dl {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .app__facts dt {
    font-weight: 600;
  }
  .app__facts dd {
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }

  .app__content {
    margin-top: clamp(4rem, 7vw, 6.5rem);
  }
  .app__guide {
    margin-top: 3rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .app__guide p {
    max-width: 40rem;
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .app__guide .link-arrow {
    margin-top: 0.75rem;
  }

  .app__gallery {
    margin-top: clamp(4.5rem, 8vw, 7rem);
  }
  .app__gallery-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .app__gallery-head h2 {
    max-width: 14ch;
  }
  .app__gallery-head .lead {
    max-width: 28rem;
    font-size: 1rem;
  }
  .app__gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    margin-top: 2.5rem;
  }
  .app__gallery-grid figure {
    margin: 0;
  }
  .app__screen {
    display: flex;
    align-items: center;
    aspect-ratio: 16 / 10;
    padding: 1rem;
    background: var(--paper-deep);
  }
  .app__screen img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  .app__gallery-grid figcaption {
    margin-top: 0.8rem;
    font-size: 0.82rem;
  }

  .app__support {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    margin-top: clamp(4rem, 7vw, 6rem);
  }
  .app__support-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .app__support-block h3 {
    font-weight: 400;
  }
  .app__support-block p {
    max-width: 36rem;
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .app__support-block .btn,
  .app__support-block .link-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .app__support-block .btn {
    margin-top: 1.5rem;
    padding-top: 0.85rem;
  }

  @media (max-width: 899px) {
    .app__hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .app__facts,
    .app__support {
      grid-template-columns: 1fr;
    }
    .app__facts {
      gap: 2rem;
    }
    .app__gallery-head {
      display: block;
    }
    .app__gallery-head .lead {
      margin-top: 1rem;
    }
  }
  @media (max-width: 640px) {
    .app__gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
