---
import { BUSINESS, SITE, SEO, SOCIALS, CONTACT } from '../config/site';
import { Font } from 'astro:assets';
import type { AppLocale } from '../config/app-locales';
import Daylight from './Daylight.astro';

interface Props {
  title?: string;
  description?: string;
  /** Site-relatief pad naar de social-share-afbeelding, bijv. '/og/og-default.png'. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD nodes (bijv. CreativeWork op projectpagina's). */
  jsonLd?: Record<string, unknown>[];
  /** Voorkom indexering van deze pagina (bijv. de bedankt-pagina). */
  noindex?: boolean;
  markdown?: string;
  lang?: AppLocale;
  alternates?: { lang: AppLocale; href: string }[];
  /** Dag-/avondstand volgen (uit voor pagina's met een eigen vaste stand). */
  daylight?: boolean;
}

const {
  title,
  description = SEO.defaultDescription,
  image = SEO.defaultOgImage,
  type = 'website',
  jsonLd = [],
  noindex = false,
  markdown,
  lang = 'nl',
  alternates = [],
  daylight = true,
} = Astro.props;

const pageTitle = title ? SEO.titleTemplate.replace('%s', title) : SEO.defaultTitle;

// Absolute, query-vrije canonical.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const origin = Astro.site!.origin;
const logoURL = new URL('/logo/chrisonline-mark.svg', Astro.site).href;

// Site-brede JSON-LD: Person + ProfessionalService + WebSite. Per-pagina nodes worden toegevoegd.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${origin}/#person`,
  name: SITE.author,
  jobTitle: lang === 'en' ? 'Shopify designer and frontend developer' : SITE.jobTitle,
  url: origin,
  image: new URL('/og/og-default.png', Astro.site).href,
  sameAs: SOCIALS.filter((s) => s.url.startsWith('http')).map((s) => s.url),
  worksFor: { '@id': `${origin}/#business` },
  homeLocation: {
    '@type': 'Place',
    name: 'Volendam, Noord-Holland',
  },
  knowsLanguage: ['nl', 'en'],
  knowsAbout: [
    'Shopify',
    'Shopify Liquid',
    'Webshopdesign',
    'Frontenddevelopment',
    'E-commerce',
    'Web performance',
    'Shopify-appontwikkeling',
    'SpecFinch',
    'Delivery Promise NL',
    'PromoFinch',
  ],
};

const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${origin}/#business`,
  name: BUSINESS.name,
  legalName: BUSINESS.name,
  url: origin,
  logo: logoURL,
  email: CONTACT.email,
  description:
    lang === 'en'
      ? 'Chris Snoek designs, builds and maintains premium Shopify stores and develops focused Shopify apps.'
      : SEO.defaultDescription,
  image: new URL('/og/og-default.png', Astro.site).href,
  founder: { '@id': `${origin}/#person` },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'KvK',
    value: BUSINESS.kvkNumber,
  },
  address: {
    '@type': 'PostalAddress',
    ...BUSINESS.address,
  },
  areaServed: [
    { '@type': 'City', name: 'Volendam' },
    { '@type': 'AdministrativeArea', name: 'Noord-Holland' },
    { '@type': 'Country', name: 'Nederland' },
  ],
  knowsAbout: ['Shopify', 'Shopify Liquid', 'Webshopdesign', 'Frontenddevelopment', 'E-commerce'],
  sameAs: SOCIALS.filter((s) => s.url.startsWith('http')).map((s) => s.url),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  name: `${SITE.author} | ${SITE.brand}`,
  url: origin,
  inLanguage: ['nl', 'en'],
  publisher: { '@id': `${origin}/#business` },
};

const allJsonLd = [personLd, businessLd, websiteLd, ...jsonLd];
const defaultAlternate = alternates.find((alternate) => alternate.lang === 'nl');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={daylight ? '#f4f4ef' : '#121311'} />
{daylight && <Daylight />}

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
  ))
}
{
  defaultAlternate && (
    <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, Astro.site)} />
  )
}
{
  markdown && (
    <link
      rel="alternate"
      type="text/markdown"
      href={new URL(markdown, Astro.site)}
      title={lang === 'en' ? 'This page in Markdown' : 'Deze pagina in Markdown'}
    />
  )
}
<link
  rel="alternate"
  type="text/plain"
  href="/llms.txt"
  title={lang === 'en'
    ? 'Public site information for AI clients'
    : 'Publieke site-informatie voor AI-clients'}
/>
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}
<meta name="author" content={SITE.author} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : SITE.ogLocale} />
{
  alternates
    .filter((alternate) => alternate.lang !== lang)
    .map((alternate) => (
      <meta
        property="og:locale:alternate"
        content={alternate.lang === 'en' ? 'en_US' : SITE.ogLocale}
      />
    ))
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- Favicons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Fonts: Astro Fonts API injecteert preload + fallback-metrics (zero CLS). -->
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-display" preload />

<!-- Structured data -->
{
  allJsonLd.map((node) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
  ))
}
