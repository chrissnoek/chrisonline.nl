---
import { CONTACT, NAV, SITE, SOCIALS } from '../config/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="chapter-shell site-footer" aria-label="Sitevoettekst">
  <div class="footer-rail" aria-hidden="true"></div>
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-wordmark" href="/" aria-label={`${SITE.brand}, naar de homepage`}>
        CHRIS—ONLINE
      </a>
      <p>{SITE.tagline}</p>
      <small>© {year} {SITE.author}</small>
    </div>

    <nav class="footer-nav" aria-label="Footernavigatie">
      {
        NAV.map((item) => (
          <a href={item.href}>
            {item.label}
            <Icon name="arrowRight" size={16} />
          </a>
        ))
      }
    </nav>

    <div class="footer-contact">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a href={CONTACT.bookingUrl} target="_blank" rel="noopener">Plan een gesprek</a>
      {
        SOCIALS.filter((social) => social.url.startsWith('http')).map((social) => (
          <a href={social.url} target="_blank" rel="me noopener">
            {social.name}
            <Icon name="arrowUpRight" size={16} />
          </a>
        ))
      }
    </div>

    <svg class="footer-drawing" viewBox="0 0 480 210" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M15 180h450M42 180V81l55-33h278l55 33v99M97 48v132M375 48v132"></path>
        <path d="M117 75h238v105H117zM132 92h95v88h-95zM243 92h96v88h-96z"></path>
        <path d="M255 180v-47h42v47M149 180v-37h40v37"></path>
        <path class="dash" d="M22 195h436M42 64h388M97 33v-22M375 33v-22"></path>
      </g>
    </svg>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
  }

  .footer-rail {
    border-right: 1px solid var(--graphite-dark);
  }

  .footer-main {
    position: relative;
    display: grid;
    min-height: 24rem;
    grid-template-columns: minmax(17rem, 0.9fr) minmax(18rem, 0.75fr) minmax(15rem, 0.7fr) minmax(
        20rem,
        1fr
      );
    gap: 2rem;
    padding: 4.5rem var(--page-gutter);
    overflow: hidden;
  }

  .footer-brand,
  .footer-nav,
  .footer-contact {
    position: relative;
    z-index: 2;
  }

  .footer-wordmark {
    color: var(--paper);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .footer-brand p {
    max-width: 20rem;
    margin: 1.25rem 0 0;
    color: var(--graphite-light);
    font-size: 0.8rem;
  }

  .footer-brand small {
    display: block;
    margin-top: 2.5rem;
    color: var(--graphite-light);
    font-size: 0.66rem;
  }

  .footer-nav,
  .footer-contact {
    display: grid;
    align-content: start;
  }

  .footer-nav a,
  .footer-contact a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--graphite-dark);
    color: var(--paper);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: var(--signal);
  }

  .footer-drawing {
    width: 100%;
    align-self: end;
    color: var(--graphite-light);
    opacity: 0.35;
  }

  .footer-drawing .dash {
    stroke-dasharray: 5 7;
  }

  @media (max-width: 73.99rem) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      padding: 4rem var(--mobile-gutter);
    }

    .footer-drawing {
      grid-column: 2;
    }
  }

  @media (max-width: 39.99rem) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-drawing {
      grid-column: 1;
    }
  }
</style>
