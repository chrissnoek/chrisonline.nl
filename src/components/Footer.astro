---
import { SITE, SOCIALS, NAV, CONTACT } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Sitevoettekst">
  <div class="footer-top">
    <nav aria-label="Footernavigatie">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/shopify-migratie">Shopify-migratie</a>
      <a href="/shopify-specialist-noord-holland">Shopify-specialist Noord-Holland</a>
      <a href="/automatisering">Automatisering</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="footer-contact">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      {
        SOCIALS.filter((social) => social.url.startsWith('http')).map((social) => (
          <a href={social.url} target="_blank" rel="me noopener" aria-label={social.name}>
            <Icon name={social.icon} size={20} />
          </a>
        ))
      }
    </div>
  </div>

  <a href="/" class="footer-brand" aria-label={`${SITE.brand}, naar de homepage`}>
    <Logo height={110} inverse />
  </a>

  <div class="footer-bottom">
    <p>Shopify · Design · Develop · Maintain</p>
    <p>
      &copy; {year}
      {SITE.author}. Alle rechten voorbehouden.
      <a href="/privacy">Privacy</a>
      <button type="button" data-cookie-settings>Cookiekeuze</button>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(4rem, 7vw, 7rem) max(1.25rem, calc((100vw - 78rem) / 2)) 2rem;
    background: #0d0d0f;
    color: #ffffff;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer-top nav {
    display: flex;
    max-width: 39rem;
    flex-wrap: wrap;
    gap: 0.55rem 1.6rem;
  }

  .footer-top a {
    color: #c9c9c5;
    font-size: 0.9rem;
    transition: color 180ms ease;
  }

  .footer-top a:hover,
  .footer-top a:focus-visible {
    color: #ff7048;
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand {
    display: block;
    width: 100%;
    margin-top: clamp(5rem, 10vw, 10rem);
    overflow: hidden;
  }

  .footer-brand :global(.brand-lockup) {
    width: 100%;
    height: auto;
    gap: 2vw;
    font-size: clamp(4.2rem, 13vw, 12.5rem);
    letter-spacing: -0.075em;
  }

  .footer-brand :global(.brand-mark) {
    width: clamp(4rem, 10vw, 9rem);
    height: clamp(4rem, 10vw, 9rem);
  }

  .footer-bottom {
    display: flex;
    margin-top: 3rem;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #343438;
    color: #8f8f8b;
    font-size: 0.78rem;
  }

  .footer-bottom p:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-bottom a,
  .footer-bottom button {
    color: #c9c9c5;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  @media (max-width: 700px) {
    .footer-top,
    .footer-bottom {
      flex-direction: column;
    }

    .footer-top nav {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .footer-brand :global(.brand-lockup) {
      font-size: clamp(3.4rem, 16vw, 5.4rem);
    }
  }
</style>
