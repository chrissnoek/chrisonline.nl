---
import { SITE, NAV } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-header" aria-label="Sitekop" class="site-header sticky top-0 z-50">
  <div class="header-inner">
    <a href="/" class="brand-link" aria-label={`${SITE.brand}, naar de homepage`}>
      <Logo height={36} />
    </a>

    <nav class="desktop-nav" aria-label="Hoofdnavigatie">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={
              !item.href.includes('#') && currentPath === item.href.replace(/\/$/, '')
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href="/contact?dienst=shopify" class="header-cta">
        Bespreek je webshop
        <Icon name="arrowUpRight" size={17} />
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} class="block" id="menu-icon-open" />
        <Icon name="close" size={22} class="hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden" hidden>
    <nav class="mobile-nav" aria-label="Mobiele navigatie">
      {
        NAV.map((item) => (
          <a href={item.href} class="mobile-link" data-mobile-link>
            {item.label}
          </a>
        ))
      }
      <a href="/contact?dienst=shopify" class="mobile-cta" data-mobile-link>
        Bespreek je webshop
      </a>
    </nav>
  </div>
</header>

<script>
  // Listeners per paginaweergave: bij elke View Transition wordt de header-DOM
  // vervangen; een AbortController ruimt de oude listeners op i.p.v. ze te
  // laten opstapelen op verweesde elementen.
  let headerAbort: AbortController | undefined;
  let spyObserver: IntersectionObserver | undefined;

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const { signal } = headerAbort;
    spyObserver?.disconnect();
    spyObserver = undefined;

    // Achtergrond verschijnt zodra je scrollt (subtiel, performant via class-toggle).
    const header = document.getElementById('site-header');
    if (header) {
      const onScroll = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true, signal });
    }

    // Scrollspy: markeer de sectielink die nu in beeld is (alleen op pagina's
    // met die secties, dus effectief de homepage).
    const spyLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#site-header nav a[href^="/#"]'),
    );
    const pairs = spyLinks
      .map((link) => {
        const id = link.getAttribute('href')!.split('#')[1];
        const section = id ? document.getElementById(id) : null;
        return section ? ([link, section] as const) : null;
      })
      .filter((p): p is readonly [HTMLAnchorElement, HTMLElement] => p !== null);
    if (pairs.length) {
      spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const link = pairs.find(([, sec]) => sec === entry.target)?.[0];
            if (!link) continue;
            if (entry.isIntersecting) {
              spyLinks.forEach((l) => l.removeAttribute('aria-current'));
              link.setAttribute('aria-current', 'true');
            } else if (link.getAttribute('aria-current')) {
              link.removeAttribute('aria-current');
            }
          }
        },
        // Smalle band rond het midden van de viewport → één actieve sectie.
        { rootMargin: '-40% 0px -55% 0px' },
      );
      pairs.forEach(([, sec]) => spyObserver!.observe(sec));
    }

    // Mobiel menu.
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (toggle && menu) {
      const setOpen = (open: boolean) => {
        menu.hidden = !open;
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Sluit menu' : 'Open menu');
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      };
      toggle.addEventListener('click', () => setOpen(menu.hidden), { signal });
      menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
        link.addEventListener('click', () => setOpen(false), { signal });
      });
      // Sluit op Escape.
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );
      // Sluit bij een klik/tik buiten het menu en de knop.
      document.addEventListener(
        'click',
        (e) => {
          if (menu.hidden) return;
          const t = e.target instanceof Node ? e.target : null;
          if (t && !menu.contains(t) && !toggle.contains(t)) setOpen(false);
        },
        { signal },
      );
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    padding: 0.7rem 1rem 0;
    border: 0;
    background: transparent;
  }

  .header-inner {
    display: flex;
    width: min(100%, 88rem);
    min-height: 4.75rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.55rem 0.7rem 0.55rem 1rem;
    border: 1px solid transparent;
    border-radius: 1.25rem;
    transition:
      min-height 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .brand-link {
    display: inline-flex;
    flex: none;
    transition: opacity 180ms ease;
  }

  .brand-link:hover,
  .brand-link:focus-visible {
    opacity: 0.7;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.55rem 0.85rem;
    color: #565652;
    font-size: 0.85rem;
    font-weight: 540;
    transition: color 180ms ease;
  }

  .nav-link::after {
    position: absolute;
    right: 0.85rem;
    bottom: 0.32rem;
    left: 0.85rem;
    height: 2px;
    background: #ee4b24;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: #111111;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta,
  .mobile-cta {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 0.75rem;
    background: #111111;
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 650;
    line-height: 1;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .header-cta {
    padding: 0.75rem 1rem;
  }

  .header-cta:hover,
  .header-cta:focus-visible {
    background: #2d2d2a;
    transform: translateY(-2px);
  }

  .menu-toggle {
    display: none;
    width: 2.9rem;
    height: 2.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #d5d5cf;
    border-radius: 0.75rem;
    color: #111111;
  }

  .mobile-menu {
    width: min(100%, 88rem);
    margin: 0.35rem auto 0;
    overflow: hidden;
    border: 1px solid #deded9;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 1.5rem 4rem rgba(17, 17, 17, 0.14);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem;
  }

  .mobile-link {
    display: flex;
    min-height: 3.35rem;
    align-items: center;
    padding: 0.7rem 0.85rem;
    border-radius: 0.6rem;
    color: #111111;
    font-size: 1rem;
    font-weight: 560;
  }

  .mobile-link:hover,
  .mobile-link:focus-visible {
    background: #f1f1ed;
  }

  .mobile-cta {
    margin-top: 0.35rem;
    padding: 0.95rem;
  }

  #site-header.is-scrolled {
    padding-top: 0.4rem;
  }

  #site-header.is-scrolled .header-inner {
    min-height: 4rem;
    border-color: rgba(17, 17, 17, 0.1);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 0.75rem 2.4rem rgba(17, 17, 17, 0.08);
    backdrop-filter: saturate(140%) blur(18px);
  }

  @media (max-width: 1023px) {
    .site-header {
      padding-inline: 0.5rem;
    }

    .header-inner {
      min-height: 4.25rem;
      padding-inline: 0.65rem;
      border-radius: 1rem;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-inner,
    .nav-link::after,
    .header-cta {
      transition: none;
    }
  }
</style>
