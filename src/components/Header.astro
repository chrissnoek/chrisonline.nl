---
import { SITE, NAV } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { EN_APP_NAV, type AppLocale } from '../config/app-locales';

interface Props {
  lang?: AppLocale;
  languageHref?: string;
}
const { lang = 'nl', languageHref } = Astro.props;
const english = lang === 'en';
const navigation = english ? EN_APP_NAV : NAV;
const homeHref = english ? '/en/shopify-apps/' : '/';
const ctaHref = english ? 'mailto:info@chrisonline.nl' : '/contact?dienst=shopify';
const ctaLabel = english ? 'App support' : 'Bespreek je webshop';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && currentPath === href.replace(/\/$/, '') ? 'page' : undefined;
---

<header id="site-header" class="site-header" aria-label={english ? 'Site header' : 'Sitekop'}>
  <div class="site-header__bar">
    <div class="site-header__inner shell shell--wide">
      <a
        href={homeHref}
        class="site-header__brand mark-hover"
        aria-label={`${SITE.brand}, ${english ? 'Shopify Apps' : 'naar de homepage'}`}
      >
        <Logo height={30} spin />
      </a>

      <nav class="site-nav" aria-label={english ? 'Main navigation' : 'Hoofdnavigatie'}>
        {
          navigation.map((item) => (
            <a href={item.href} class="site-nav__link" aria-current={isCurrent(item.href)}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        {
          languageHref && (
            <a
              href={languageHref}
              class="site-header__lang"
              hreflang={english ? 'nl' : 'en'}
              lang={english ? 'nl' : 'en'}
              aria-label={english ? 'Deze pagina in het Nederlands' : 'Read this page in English'}
            >
              {english ? 'NL' : 'EN'}
            </a>
          )
        }
        <a href={ctaHref} class="btn btn--ink btn--sm site-header__cta">
          {ctaLabel}
          <Icon name="arrowRight" size={16} />
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="menu-toggle"
          aria-label="Open menu"
          data-open-label="Open menu"
          data-close-label={english ? 'Close menu' : 'Sluit menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="mobile-menu__nav" aria-label={english ? 'Mobile navigation' : 'Mobiele navigatie'}>
      {
        navigation.map((item, index) => (
          <a
            href={item.href}
            class="mobile-menu__link"
            style={`--i:${index}`}
            aria-current={isCurrent(item.href)}
            data-mobile-link
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu__foot" style={`--i:${navigation.length}`}>
      <a href={ctaHref} class="btn btn--primary" data-mobile-link>
        {ctaLabel}
        <Icon name="arrowRight" size={18} />
      </a>
      {
        languageHref && (
          <a
            href={languageHref}
            class="link-arrow"
            hreflang={english ? 'nl' : 'en'}
            data-mobile-link
          >
            {english ? 'Nederlandse website' : 'Shopify Apps in English'}
            <Icon name="arrowRight" size={18} />
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  // Listeners per paginaweergave: bij een View Transition wordt de header-DOM
  // vervangen; een AbortController ruimt de oude listeners op.
  let headerAbort: AbortController | undefined;
  let spyObserver: IntersectionObserver | undefined;

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const { signal } = headerAbort;
    spyObserver?.disconnect();
    spyObserver = undefined;

    const header = document.getElementById('site-header');
    if (!header) return;

    // Vaste achtergrond zodra de pagina scrolt; richting bepaalt zichtbaarheid
    // op mobiel (verbergt bij omlaag scrollen, verschijnt bij omhoog).
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 12);
      header.classList.toggle(
        'is-hidden',
        y > 320 && y > lastY + 4 && !document.body.classList.contains('menu-open'),
      );
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    // Scrollspy voor ankerlinks naar homepage-secties.
    const spyLinks = Array.from(
      header.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="/#"]'),
    );
    const pairs = spyLinks
      .map((link) => {
        const id = link.getAttribute('href')!.split('#')[1];
        const section = id ? document.getElementById(id) : null;
        return section ? ([link, section] as const) : null;
      })
      .filter((p): p is readonly [HTMLAnchorElement, HTMLElement] => p !== null);
    if (pairs.length) {
      spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const link = pairs.find(([, sec]) => sec === entry.target)?.[0];
            if (!link) continue;
            if (entry.isIntersecting) {
              spyLinks.forEach((l) => l.removeAttribute('aria-current'));
              link.setAttribute('aria-current', 'true');
            } else if (link.getAttribute('aria-current')) {
              link.removeAttribute('aria-current');
            }
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      pairs.forEach(([, sec]) => spyObserver!.observe(sec));
    }

    // Mobiel menu.
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      const setOpen = (open: boolean) => {
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute(
          'aria-label',
          open
            ? (toggle.dataset.closeLabel ?? 'Sluit menu')
            : (toggle.dataset.openLabel ?? 'Open menu'),
        );
        document.body.classList.toggle('menu-open', open);
        header.classList.toggle('is-menu-open', open);
        if (open) header.classList.remove('is-hidden');
      };
      toggle.addEventListener('click', () => setOpen(menu.hidden), { signal });
      menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
        link.addEventListener('click', () => setOpen(false), { signal });
      });
      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );
      // Boven de mobiele breakpoint altijd sluiten.
      const mq = window.matchMedia('(min-width: 1100px)');
      mq.addEventListener('change', (e) => e.matches && setOpen(false), { signal });
      signal.addEventListener('abort', () => document.body.classList.remove('menu-open'), {
        once: true,
      });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
  initHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    transition: transform 320ms var(--ease-out-soft);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__bar {
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 260ms ease,
      border-color 260ms ease,
      backdrop-filter 260ms ease;
  }
  .is-scrolled .site-header__bar,
  .is-menu-open .site-header__bar {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(140%) blur(16px);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-h);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    transition: min-height 260ms var(--ease-out-soft);
  }
  .is-scrolled .site-header__inner {
    min-height: calc(var(--header-h) - 0.5rem);
  }

  .site-header__brand {
    display: inline-flex;
    flex: none;
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.5rem 0.8rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 540;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .site-nav__link::after {
    position: absolute;
    right: 0.8rem;
    bottom: 0.42rem;
    left: 0.8rem;
    height: 2px;
    border-radius: 2px;
    background: var(--vermilion);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out-soft);
  }
  .site-nav__link:hover,
  .site-nav__link:focus-visible,
  .site-nav__link[aria-current] {
    color: var(--ink);
  }
  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after,
  .site-nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .site-header__lang {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-header__lang:hover,
  .site-header__lang:focus-visible {
    color: var(--vermilion-ink);
  }

  .menu-toggle {
    display: none;
    width: 2.9rem;
    height: 2.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--ink);
  }
  .menu-toggle__lines {
    position: relative;
    display: block;
    width: 1.2rem;
    height: 0.9rem;
  }
  .menu-toggle__lines i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 300ms var(--ease-out-soft),
      top 300ms var(--ease-out-soft);
  }
  .menu-toggle__lines i:first-child {
    top: 0;
  }
  .menu-toggle__lines i:last-child {
    top: calc(100% - 2px);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__lines i:first-child {
    top: calc(50% - 1px);
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__lines i:last-child {
    top: calc(50% - 1px);
    transform: rotate(-45deg);
  }

  /* Mobiel menu: vult het scherm onder de balk; links komen regel voor regel binnen. */
  .mobile-menu {
    position: fixed;
    inset: calc(var(--header-h) - 0.5rem) 0 0 0;
    z-index: 55;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
    padding: 1.5rem var(--spacing-gutter) 2rem;
    background: var(--paper);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 2.75rem);
    letter-spacing: -0.015em;
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-menu__link[aria-current],
  .mobile-menu__link:hover {
    color: var(--vermilion-ink);
  }
  .mobile-menu__foot {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu__link,
    .mobile-menu__foot {
      animation: enter-up 0.55s var(--ease-out-soft) both;
      animation-delay: calc(var(--i, 0) * 55ms);
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1099px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__bar,
    .site-header__inner,
    .site-nav__link::after {
      transition: none;
    }
  }
</style>
