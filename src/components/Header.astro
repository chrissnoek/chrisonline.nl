---
import { CONTACT, NAV, SITE, SOCIALS } from '../config/site';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header id="site-header" class="site-header" aria-label="Sitekop">
  <div class="header-rail" aria-hidden="true"></div>
  <div class="header-main">
    <a class="wordmark" href="/" aria-label={`${SITE.brand}, naar de homepage`}>
      CHRIS<span>—</span>ONLINE
    </a>

    <nav class="desktop-nav" aria-label="Hoofdnavigatie">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={
              !item.href.includes('#') && currentPath === item.href.replace(/\/$/, '')
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="header-cta" href="/contact">
      <span>Start een project</span>
      <Icon name="arrowUpRight" size={18} />
    </a>

    <button
      id="menu-toggle"
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span>Menu</span>
      <i aria-hidden="true"></i>
    </button>
  </div>
</header>

<dialog id="mobile-navigation" class="mobile-dialog" aria-labelledby="mobile-menu-title">
  <div class="mobile-dialog__top">
    <p id="mobile-menu-title" class="wordmark wordmark--light">CHRIS—ONLINE</p>
    <button class="menu-close" type="button" aria-label="Sluit menu" data-menu-close>
      <span>Sluiten</span>
      <i aria-hidden="true"></i>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Mobiele navigatie">
    {
      NAV.map((item, index) => (
        <a href={item.href} data-menu-link>
          <span class="crosshair" aria-hidden="true" />
          <strong>{item.label}</strong>
          <small>0{index + 1}</small>
        </a>
      ))
    }
  </nav>

  <div class="mobile-dialog__footer">
    <a class="mobile-project-cta" href="/contact" data-menu-link>
      Start een project
      <Icon name="arrowUpRight" size={20} />
    </a>
    <a href={`mailto:${CONTACT.email}`} data-menu-link>{CONTACT.email}</a>
    {
      SOCIALS.filter((social) => social.url.startsWith('http')).map((social) => (
        <a href={social.url} target="_blank" rel="me noopener">
          {social.name}
          <Icon name="arrowUpRight" size={17} />
        </a>
      ))
    }
  </div>
</dialog>

<script>
  let headerAbort: AbortController | undefined;
  let spyObserver: IntersectionObserver | undefined;

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const { signal } = headerAbort;
    spyObserver?.disconnect();

    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const dialog = document.getElementById('mobile-navigation');
    const close = dialog?.querySelector<HTMLButtonElement>('[data-menu-close]');

    if (header) {
      const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true, signal });
    }

    if (toggle instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement) {
      const closeDialog = () => {
        if (dialog.open) dialog.close();
      };

      toggle.addEventListener(
        'click',
        () => {
          dialog.showModal();
          toggle.setAttribute('aria-expanded', 'true');
          document.documentElement.classList.add('menu-open');
          requestAnimationFrame(() => close?.focus());
        },
        { signal },
      );
      close?.addEventListener('click', closeDialog, { signal });
      dialog.addEventListener(
        'cancel',
        (event) => {
          event.preventDefault();
          closeDialog();
        },
        { signal },
      );
      dialog.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape') return;
          event.preventDefault();
          closeDialog();
        },
        { signal },
      );
      dialog.addEventListener(
        'click',
        (event) => {
          if (event.target === dialog) closeDialog();
        },
        { signal },
      );
      dialog.addEventListener(
        'close',
        () => {
          toggle.setAttribute('aria-expanded', 'false');
          document.documentElement.classList.remove('menu-open');
          toggle.focus();
        },
        { signal },
      );
      dialog.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
        link.addEventListener(
          'click',
          (event) => {
            const url = new URL(link.href, window.location.href);
            const target = url.hash ? document.getElementById(url.hash.slice(1)) : null;
            const isCurrentPage = url.pathname === window.location.pathname;

            if (!target || !isCurrentPage) {
              closeDialog();
              return;
            }

            event.preventDefault();
            closeDialog();
            requestAnimationFrame(() => {
              window.history.pushState(null, '', url.hash);
              target.scrollIntoView({
                behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
                  ? 'auto'
                  : 'smooth',
                block: 'start',
              });
            });
          },
          { signal },
        );
      });
    }

    const spyLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#site-header nav a[href^="/#"]'),
    );
    const pairs = spyLinks
      .map((link) => {
        const id = link.getAttribute('href')?.split('#')[1];
        const section = id ? document.getElementById(id) : null;
        return section ? ([link, section] as const) : null;
      })
      .filter((pair): pair is readonly [HTMLAnchorElement, HTMLElement] => pair !== null);

    if (pairs.length) {
      spyObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const active = pairs.find(([, section]) => section === entry.target)?.[0];
            if (!active) continue;
            spyLinks.forEach((link) => link.removeAttribute('aria-current'));
            active.setAttribute('aria-current', 'true');
          }
        },
        { rootMargin: '-42% 0px -52% 0px' },
      );
      pairs.forEach(([, section]) => spyObserver?.observe(section));
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    border-bottom: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    transition:
      min-height 220ms ease,
      box-shadow 220ms ease;
  }

  .site-header.is-scrolled {
    min-height: 4.5rem;
    box-shadow: 0 10px 30px rgb(9 9 9 / 0.07);
    backdrop-filter: blur(14px);
  }

  .header-rail {
    border-right: 1px solid var(--ink);
    background: var(--signal);
  }

  .header-main {
    display: grid;
    min-width: 0;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
    padding: 0 var(--page-gutter);
  }

  .wordmark {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
    font-size: clamp(1rem, 1.35vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark span {
    color: var(--ink);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.8rem);
  }

  .desktop-nav a {
    position: relative;
    min-height: 44px;
    padding: 0.75rem 0;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 550;
    text-decoration: none;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.4rem;
    left: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-cta,
  .menu-toggle {
    min-height: 3rem;
    border: 1px solid var(--signal);
    background: var(--signal);
    color: var(--ink);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding: 0.85rem 1.15rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .header-cta:hover,
  .header-cta:focus-visible {
    background: var(--ink);
    color: var(--signal);
  }

  .menu-toggle {
    display: none;
    width: 6.6rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    font: inherit;
    font-weight: 600;
  }

  .menu-toggle i,
  .menu-close i {
    position: relative;
    width: 1.2rem;
    height: 1.2rem;
  }

  .menu-toggle i::before,
  .menu-toggle i::after,
  .menu-close i::before,
  .menu-close i::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .menu-toggle i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .mobile-dialog {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top)) var(--mobile-gutter)
      max(1rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--ink);
    color: var(--paper);
    overflow: auto;
  }

  .mobile-dialog::backdrop {
    background: rgb(9 9 9 / 0.72);
  }

  .mobile-dialog__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark--light {
    color: var(--paper);
  }

  .menu-close {
    display: inline-flex;
    min-width: 7.5rem;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1rem;
    border: 0;
    background: var(--signal);
    color: var(--ink);
    font: inherit;
    font-weight: 650;
  }

  .menu-close i::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-close i::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .mobile-nav {
    margin-top: clamp(4rem, 10vh, 7rem);
    border-top: 1px solid var(--graphite-dark);
  }

  .mobile-nav a {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--graphite-dark);
    color: var(--paper);
    text-decoration: none;
  }

  .mobile-nav strong {
    font-family: var(--font-sans);
    font-size: clamp(1.4rem, 7vw, 2rem);
    font-weight: 450;
  }

  .mobile-nav small {
    color: var(--graphite-light);
    font-size: 0.72rem;
  }

  .mobile-dialog__footer {
    display: grid;
    gap: 0;
    margin-top: clamp(3rem, 8vh, 6rem);
  }

  .mobile-dialog__footer > a {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--graphite-dark);
    color: var(--paper);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .mobile-dialog__footer .mobile-project-cta {
    min-height: 4.5rem;
    margin-bottom: 1.5rem;
    padding: 0 1.25rem;
    border: 0;
    background: var(--signal);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 650;
  }

  @media (max-width: 73.99rem) {
    .site-header {
      min-height: 4.8rem;
      grid-template-columns: minmax(0, 1fr);
    }

    .header-rail,
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .header-main {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding: 0 var(--mobile-gutter);
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .desktop-nav a::after,
    .header-cta {
      transition: none;
    }
  }
</style>
