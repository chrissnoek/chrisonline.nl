---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { appName } from '../lib/shopify-apps';
import { withUtm } from '../utils/utm';
import { englishAppPath } from '../lib/english-apps';
import type { AppLocale } from '../config/app-locales';

interface Props {
  apps: CollectionEntry<'projects'>[];
  lang?: AppLocale;
  translations?: Record<string, CollectionEntry<'englishApps'>['data']>;
}
const { apps, lang = 'nl', translations = {} } = Astro.props;
const english = lang === 'en';
const hrefFor = (id: string) => (english ? englishAppPath(id) : `/werk/${id}`);
---

<div class="app-grid">
  {
    apps.map((app, index) => (
      <article
        class:list={['app-card reveal-up', apps.length > 2 && index === 0 && 'app-card--featured']}
        style={`--app-accent:${app.data.accent}`}
      >
        <a
          href={hrefFor(app.id)}
          class="app-card__media"
          aria-label={`${english ? 'Explore' : 'Bekijk'} ${appName(app)}`}
        >
          <Image
            src={app.data.cover}
            alt={english ? translations[app.id].coverAlt : app.data.coverAlt}
            widths={[480, 720, 1080]}
            sizes="(max-width: 767px) 100vw, 50vw"
            format="avif"
            quality="high"
            loading="lazy"
            transition:name={`cover-${app.id}`}
          />
        </a>
        <div class="app-card__copy">
          <h3 class="display-sm">
            <a href={hrefFor(app.id)}>{appName(app)}</a>
          </h3>
          <p class="app-card__tagline">
            {english
              ? translations[app.id].tagline
              : (app.data.application?.tagline ?? app.data.summary)}
          </p>
          <p class="app-card__description">
            {english ? translations[app.id].description : app.data.summary}
          </p>
          <div class="app-card__links">
            <a href={hrefFor(app.id)} class="btn btn--ink btn--sm">
              {english ? 'Explore the app' : 'Ontdek de app'} <Icon name="arrowRight" size={17} />
            </a>
            {app.data.url && (
              <a
                href={withUtm(app.data.url)}
                target="_blank"
                rel="noopener"
                class="link-arrow link-arrow--up app-card__store"
                aria-label={`${appName(app)} ${english ? 'in the Shopify App Store (new tab)' : 'in de Shopify App Store (nieuw tabblad)'}`}
              >
                Shopify App Store <Icon name="arrowUpRight" size={16} />
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .app-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2rem;
  }
  .app-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .app-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-stage);
    background:
      radial-gradient(
        120% 90% at 85% 0%,
        color-mix(in srgb, var(--app-accent) 22%, transparent),
        transparent 60%
      ),
      var(--paper-raised);
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  .app-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: var(--shadow-soft);
    transition: transform 700ms var(--ease-out-soft);
  }
  .app-card__media:hover img,
  .app-card__media:focus-visible img {
    transform: translateY(-4px) scale(1.015);
  }
  .app-card__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.6rem 0.15rem 0;
  }
  .app-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .app-card h3 a:hover {
    color: var(--vermilion-ink);
  }
  .app-card__tagline {
    margin-top: 0.65rem;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 540;
    line-height: 1.45;
  }
  .app-card__description {
    max-width: 56ch;
    margin: 0.8rem 0 1.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .app-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.4rem;
    margin-top: auto;
  }
  .app-card__store {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .app-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .app-card--featured .app-card__copy {
    padding: 0;
  }
  @media (max-width: 767px) {
    .app-grid {
      grid-template-columns: 1fr;
    }
    .app-card--featured {
      grid-column: auto;
      display: flex;
      gap: 0;
    }
    .app-card--featured .app-card__copy {
      padding: 1.6rem 0.15rem 0;
    }
    .app-card__media {
      border-radius: 1.1rem;
      padding: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-card__media img {
      transition: none;
    }
  }
</style>
