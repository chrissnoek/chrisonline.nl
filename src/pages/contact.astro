---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { SITE, CONTACT, SOCIALS, BUSINESS } from '../config/site';
import { breadcrumbLd } from '../lib/seo';

const title = 'Contact';
const description =
  'Bespreek je nieuwe Shopify-webshop, redesign, migratie of doorontwikkeling met Chris Snoek. ' +
  'Stuur een bericht of mail direct naar ' +
  CONTACT.email +
  '.';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Contact' }];
const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact met Chris Online',
  description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: 'nl',
  about: { '@id': `${SITE.url}/#business` },
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[contactPageLd, breadcrumbLd(crumbs, Astro.url.pathname)]}
>
  <section class="contact" aria-labelledby="contact-heading">
    <div class="shell">
      <Breadcrumbs items={crumbs} class="enter-up" />

      <div class="contact__grid">
        <div class="contact__intro">
          <h1 id="contact-heading" class="display-lg enter-up" style="--enter-delay: 0.06s">
            Laten we je Shopify-webshop bespreken
          </h1>
          <p class="lead enter-up" style="--enter-delay: 0.14s">
            Vertel kort waar je shop nu staat, wat je verkoopt en wat er beter moet. Ik reageer
            meestal binnen één werkdag met een paar gerichte vragen of een voorstel voor een eerste
            gesprek.
          </p>

          <div class="contact__ways enter-up" style="--enter-delay: 0.22s">
            <a href={CONTACT.bookingUrl} target="_blank" rel="noopener" class="contact__way">
              <span class="contact__way-icon"><Icon name="calendar" size={20} /></span>
              <span>
                <strong>Plan 30 minuten</strong>
                <span>Kies direct een moment voor een (video)gesprek.</span>
              </span>
              <Icon name="arrowUpRight" size={18} />
            </a>
            <a href={`mailto:${CONTACT.email}`} class="contact__way">
              <span class="contact__way-icon"><Icon name="mail" size={20} /></span>
              <span>
                <strong>E-mail</strong>
                <span>{CONTACT.email}</span>
              </span>
              <Icon name="arrowRight" size={18} />
            </a>
          </div>

          <dl class="contact__facts enter-up" style="--enter-delay: 0.3s">
            <div>
              <dt>Studio</dt>
              <dd>{BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion}</dd>
            </div>
            <div>
              <dt>Volg {SITE.brand}</dt>
              <dd>
                {
                  SOCIALS.filter((social) => social.url.startsWith('http')).map((social) => (
                    <a
                      href={social.url}
                      class="text-link"
                      aria-label={`${social.name}, ${social.handle}`}
                      rel="me noopener"
                      target="_blank"
                    >
                      {social.name}
                    </a>
                  ))
                }
              </dd>
            </div>
          </dl>
        </div>

        <div id="contactformulier" class="contact__form enter-up" style="--enter-delay: 0.18s">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Verborgen statisch blueprint-formulier zodat Netlify het bij de build
       gegarandeerd detecteert (de AJAX-submit post naar dezelfde form-naam). -->
  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/bedankt/"
    hidden
  >
    <input type="hidden" name="form-name" value="contact" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <textarea name="message"></textarea>
    <input type="text" name="source_page" />
    <input type="text" name="referrer" />
    <input type="text" name="utm_source" />
    <input type="text" name="utm_medium" />
    <input type="text" name="utm_campaign" />
    <input type="text" name="utm_term" />
    <input name="bot-field" />
  </form>

  <!-- Verborgen blueprint voor de offerte-aanvragen uit de chat. De
       bevestigingskaart in de chat POST't naar /api/quote, die de aanvraag
       server-side doorzet naar dit Netlify-form ("offerte"). Dit form bestaat
       puur zodat Netlify het bij de build detecteert. -->
  <form name="offerte" method="POST" data-netlify="true" action="/bedankt/" hidden>
    <input type="hidden" name="form-name" value="offerte" />
    <input type="text" name="naam" />
    <input type="text" name="bedrijf" />
    <input type="email" name="email" />
    <input type="text" name="projecttype" />
    <input type="text" name="budget" />
    <input type="text" name="timeline" />
    <textarea name="omschrijving"></textarea>
  </form>
</BaseLayout>

<style>
  .contact {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 var(--spacing-section);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 1.05fr);
    gap: clamp(3rem, 7vw, 7rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .contact__intro h1 {
    max-width: 14ch;
  }
  .contact__intro .lead {
    max-width: 30rem;
    margin-top: 1.5rem;
  }

  .contact__ways {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .contact__way {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .contact__way strong {
    display: block;
    font-weight: 600;
  }
  .contact__way > span:nth-child(2) > span {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .contact__way-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.8rem;
    background: var(--vermilion-soft);
    color: var(--vermilion-ink);
  }
  .contact__way > :global(svg:last-child) {
    color: var(--ink-soft);
    transition: transform 240ms var(--ease-out-soft);
  }
  .contact__way:hover strong,
  .contact__way:focus-visible strong {
    color: var(--vermilion-ink);
  }
  .contact__way:hover > :global(svg:last-child) {
    transform: translateX(4px);
  }

  .contact__facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .contact__facts dt {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .contact__facts dd {
    margin-top: 0.2rem;
    font-weight: 500;
  }
  .contact__facts dd a + a {
    margin-left: 0.75rem;
  }

  .contact__form {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius-stage);
    background: var(--paper-deep);
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__form {
      border-radius: 1.25rem;
    }
  }
</style>
