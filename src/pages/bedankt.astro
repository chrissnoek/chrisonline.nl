---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Bedankt" description="Bedankt voor je bericht." noindex>
  <section class="thanks" aria-labelledby="thanks-heading">
    <div class="shell thanks__stage stage">
      <span class="sun" aria-hidden="true"></span>
      <div class="thanks__copy">
        <span class="thanks__mark enter-pop"><Icon name="check" size={30} /></span>
        <h1 id="thanks-heading" class="display-lg enter-up" style="--enter-delay: 0.15s">
          Bedankt voor je bericht!
        </h1>
        <p class="lead enter-up" style="--enter-delay: 0.25s">
          Je bericht is verstuurd. Ik neem zo snel mogelijk contact met je op, meestal binnen één
          werkdag.
        </p>
        <div class="thanks__actions enter-up" style="--enter-delay: 0.35s">
          <a href="/" class="btn btn--ink">
            Terug naar home
            <Icon name="arrowRight" size={18} />
          </a>
          <a href="/kennis" class="link-arrow">
            Kennisbank
            <Icon name="arrowRight" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    padding: 0.5rem 0 var(--spacing-section);
  }
  .thanks__stage {
    display: grid;
    min-height: min(36rem, 70svh);
    place-items: center;
    text-align: center;
  }
  .thanks__copy {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    padding: clamp(3rem, 6vw, 5rem) var(--spacing-gutter);
  }
  .thanks__mark {
    display: grid;
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.5rem;
    place-items: center;
    border-radius: 50%;
    background: var(--vermilion);
    color: #fff;
  }
  .thanks__copy .lead {
    margin-top: 1.25rem;
  }
  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
</style>
