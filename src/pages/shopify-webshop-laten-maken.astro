const faqs = [
  {
    question: 'Wat kost een Shopify-webshop laten maken?',
    answer:
      'De investering wordt vooral bepaald door de hoeveelheid maatwerk, het aantal unieke paginatypen, productvarianten, content, talen en koppelingen. Ik werk daarom niet met een lokprijs die later oploopt. Na een eerste gesprek krijg je een afgebakende scope, de aannames en een voorstel. Shopify-abonnementen, betaaltransacties, eventuele betaalde apps en externe licenties staan daar los en zichtbaar naast.',
