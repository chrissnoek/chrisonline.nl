  {deliverables}
  processTitle="Een werkritme dat ook voor een klein team werkt."
  processIntro="De samenwerking blijft bewust licht: genoeg structuur voor grip, zonder vergaderlaag of log ticketsysteem als doel op zich."
  {process}
  cases={[]}
  {faqs}
  {related}
  serviceName="Shopify-onderhoud en doorontwikkeling"
  serviceType="Shopify-onderhoud"
  areaServed="Nederland"
/>
