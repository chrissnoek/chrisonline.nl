---
import { getCollection } from 'astro:content';
import AppProjectPage from '../../components/projects/AppProjectPage.astro';
import StandardProjectPage from '../../components/projects/StandardProjectPage.astro';
import { appStructuredData } from '../../lib/shopify-apps';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev:
        projects
          .slice(0, index)
          .filter((project) => project.data.projectType === entry.data.projectType)
          .at(-1) ?? null,
      next:
        projects
          .slice(index + 1)
          .find((project) => project.data.projectType === entry.data.projectType) ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
---

{
  entry.data.projectType === 'shopify-app' ? (
    <AppProjectPage entry={entry} prev={prev} next={next} jsonLd={appStructuredData(entry)} />
  ) : (
    <StandardProjectPage entry={entry} prev={prev} next={next} />
  )
}
