---
import { getCollection } from 'astro:content';
import AppProjectPage from '../../components/projects/AppProjectPage.astro';
import StandardProjectPage from '../../components/projects/StandardProjectPage.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const origin = Astro.site!.origin;
const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': data.projectType === 'shopify-app' ? 'SoftwareApplication' : 'CreativeWork',
  name: data.title,
  headline: data.title,
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  about: data.skills.join(', '),
  dateCreated: data.pubDate.toISOString().split('T')[0],
  image: new URL(data.cover.src, Astro.site).href,
  creator: { '@id': `${origin}/#person` },
  ...(data.projectType === 'shopify-app'
    ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Shopify' }
    : {}),
  ...(data.url ? { sameAs: [data.url] } : {}),
};
---

{
  data.projectType === 'shopify-app' ? (
    <AppProjectPage entry={entry} prev={prev} next={next} jsonLd={creativeWorkLd} />
  ) : (
    <StandardProjectPage entry={entry} prev={prev} next={next} />
  )
}
