---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbLd } from '../../lib/seo';
import ribbon from '../../assets/brand/living-ribbon-wide.png';
import specFinch from '../../assets/projects/specfinch/overview.png';
import deliveryPromise from '../../assets/projects/delivery-promise-nl/storefront.png';

const articles = (await getCollection('knowledge')).sort((a, b) => a.data.order - b.data.order);
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const origin = Astro.site!.origin;

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Kennisbank' }];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shopify-kennisbank van Chris Online',
  description:
    'Praktische gidsen over Shopify-conversie, productinformatie, leveringsvertrouwen, performance en meten.',
  url: new URL('/kennis/', Astro.site).href,
  inLanguage: 'nl-NL',
  author: { '@id': `${origin}/#person` },
  hasPart: articles.map((article) => ({
    '@type': 'Article',
    headline: article.data.title,
    url: new URL(`/kennis/${article.id}/`, Astro.site).href,
  })),
};

const decisionSteps = ['Vindbaar', 'Duidelijk', 'Vertrouwd', 'Snel', 'Meetbaar'];
---

<BaseLayout
  title="Shopify-kennisbank: conversie, productdata en performance"
  description="Praktische Shopify-gidsen over vindbaarheid, productinformatie, koopvertrouwen, snelheid en meten, geschreven vanuit ontwerp en development."
  jsonLd={[collectionLd, breadcrumbLd(crumbs, '/kennis/')]}
>
  <section class="knowledge-hero" aria-labelledby="knowledge-title">
    <div class="shell shell--wide">
      <div class="knowledge-hero__stage stage">
        <span class="sun" aria-hidden="true"></span>
        <div class="knowledge-hero__inner">
          <div class="knowledge-hero__copy">
            <Breadcrumbs items={crumbs} class="enter-up" />
            <h1 id="knowledge-title" class="display-xl enter-lines" style="--enter-delay: 0.08s">
              <span class="line" style="--i:0"><span>Kennis voor webshops</span></span>
              <span class="line" style="--i:1"><span>die willen blijven verbeteren.</span></span>
            </h1>
            <p class="lead enter-up" style="--enter-delay: 0.32s">
              Praktische Shopify-gidsen over vindbaarheid, productinformatie, koopvertrouwen en
              snelheid—geschreven vanuit ontwerp en development.
            </p>
            <a href="#gidsen" class="btn btn--ink enter-up" style="--enter-delay: 0.42s">
              Bekijk alle gidsen
              <Icon name="arrowDown" size={18} />
            </a>
          </div>

          <div
            class="decision-map enter-up"
            style="--enter-delay: 0.3s"
            aria-label="Vijf onderdelen van een sterke kooproute"
          >
            <p>Een betere kooproute maakt de volgende beslissing steeds eenvoudiger.</p>
            <ol>
              {
                decisionSteps.map((step, index) => (
                  <li class:list={[index === 2 && 'is-accent']}>
                    <span>{step}</span>
                    {index < decisionSteps.length - 1 && (
                      <Icon name="arrowRight" size={16} class="decision-map__arrow" />
                    )}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="featured section--tight" aria-labelledby="featured-heading">
    <div class="shell">
      <a href={`/kennis/${featured.id}`} class="featured-guide reveal-up">
        <div class="featured-guide__visual">
          <Image
            src={ribbon}
            alt="Oranje levende lijn uit de visuele identiteit van Chris Online."
            widths={[600, 900, 1200]}
            sizes="(max-width: 800px) 100vw, 43vw"
            format="avif"
            quality="mid"
          />
        </div>
        <div class="featured-guide__copy">
          <p class="meta">{featured.data.category} · {featured.data.readingMinutes} min lezen</p>
          <h2 id="featured-heading" class="display-md">{featured.data.title}</h2>
          <p class="featured-guide__intro">{featured.data.intro}</p>
          <span class="link-arrow">
            Lees de gids
            <Icon name="arrowRight" size={18} />
          </span>
        </div>
      </a>
    </div>
  </section>

  <section id="gidsen" class="guide-index section" aria-labelledby="guide-index-heading">
    <div class="shell guide-index__grid">
      <div class="guide-index__intro lift-in">
        <h2 id="guide-index-heading" class="display-md">Gidsen per koopvraag</h2>
        <p class="lead">
          Begin bij de twijfel die je in klantvragen, gedrag of retouren daadwerkelijk terugziet.
        </p>
      </div>
      <div class="guide-list rows reveal-up">
        {
          articles.map((article) => (
            <a href={`/kennis/${article.id}`} class="guide-list__item">
              <span class="guide-list__category meta">{article.data.category}</span>
              <span class="guide-list__title">{article.data.title}</span>
              <span class="guide-list__time meta">{article.data.readingMinutes} min</span>
              <Icon name="arrowRight" size={19} class="guide-list__arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="knowledge-apps section section--deep" aria-labelledby="apps-heading">
    <div class="shell">
      <div class="knowledge-apps__intro lift-in">
        <h2 id="apps-heading" class="display-md">Twee eigen apps voor twee specifieke twijfels</h2>
        <p class="lead">
          Niet iedere conversievraag vraagt om een app. Deze twee producten zijn gebouwd voor
          problemen die herhaalbare controle of berekening nodig hebben.
        </p>
      </div>

      <div class="app-rows">
        <article class="app-row reveal-up">
          <div class="app-row__image frame frame--lift">
            <Image
              src={specFinch}
              alt="SpecFinch-overzicht met actieve datacontracten en de laatste catalogusscan."
              widths={[560, 840, 1120]}
              sizes="(max-width: 799px) 100vw, 39vw"
              format="avif"
              quality="mid"
            />
          </div>
          <div class="app-row__copy">
            <h3 class="display-sm">SpecFinch</h3>
            <p>
              Houdt nieuwe ontbrekende productvelden en metafields apart van bestaande
              catalogusachterstand. Read-only en bepaald door de regels van de merchant.
            </p>
            <div class="app-row__links">
              <a href="/werk/specfinch" class="link-arrow"
                >Bekijk het project <Icon name="arrowRight" size={17} /></a
              >
              <a
                href="https://apps.shopify.com/specfinch"
                target="_blank"
                rel="noopener"
                class="link-arrow link-arrow--up link-arrow--accent"
                >App Store <Icon name="arrowUpRight" size={17} /></a
              >
            </div>
          </div>
        </article>

        <article class="app-row reveal-up">
          <div class="app-row__image frame frame--lift">
            <Image
              src={deliveryPromise}
              alt="Shopify-productpagina met leveringscontext van Delivery Promise NL bij de koopknoppen."
              widths={[560, 840, 1120]}
              sizes="(max-width: 799px) 100vw, 39vw"
              format="avif"
              quality="mid"
            />
          </div>
          <div class="app-row__copy">
            <h3 class="display-sm">Delivery Promise NL</h3>
            <p>
              Berekent een verwachte bezorgdatum of -periode met Nederlandse werkdagen, cutoffs,
              feestdagen en productregels. Duidelijk verwacht, nooit gegarandeerd.
            </p>
            <div class="app-row__links">
              <a href="/werk/delivery-promise-nl" class="link-arrow"
                >Bekijk het project <Icon name="arrowRight" size={17} /></a
              >
              <a
                href="https://apps.shopify.com/delivery-promise-nl"
                target="_blank"
                rel="noopener"
                class="link-arrow link-arrow--up link-arrow--accent"
                >App Store <Icon name="arrowUpRight" size={17} /></a
              >
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CtaBand
    id="knowledge-cta"
    title="Weet je waar klanten afhaken, maar nog niet wat je moet veranderen?"
    text="Ik help het probleem terugbrengen tot een concrete ontwerp- of developmentbeslissing."
    primary={{ label: 'Bespreek je webshop', href: '/contact?dienst=shopify' }}
    compact
  />
</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────── */
  .knowledge-hero {
    padding: 0.5rem 0 0;
  }
  .knowledge-hero__stage {
    min-height: min(34rem, calc(100svh - var(--header-h) - 4rem));
  }
  .knowledge-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 5vw, 5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .knowledge-hero__copy h1 {
    margin-top: 1.75rem;
    color: var(--ink);
    font-size: clamp(2.8rem, 1rem + 4.3vw, 5.8rem);
  }
  .knowledge-hero__copy .lead {
    max-width: 38rem;
    margin-top: 1.5rem;
  }
  .knowledge-hero__copy .btn {
    margin-top: 2rem;
  }

  .decision-map {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .decision-map > p {
    max-width: 24rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .decision-map ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .decision-map li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
  }
  .decision-map li.is-accent span {
    color: var(--vermilion-ink);
  }
  .decision-map :global(.decision-map__arrow) {
    color: var(--ink-faint);
  }

  /* ── Uitgelichte gids ────────────────────────────────────────────────── */
  .featured {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .featured-guide {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    overflow: hidden;
    border-radius: var(--radius-stage);
    background: var(--stage);
    color: var(--stage-ink);
    text-decoration: none;
  }
  .featured-guide__visual {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
  }
  .featured-guide__visual img {
    position: absolute;
    right: -14%;
    bottom: -12%;
    width: 124%;
    max-width: none;
    transition: transform 900ms var(--ease-out-soft);
  }
  .featured-guide:hover .featured-guide__visual img,
  .featured-guide:focus-visible .featured-guide__visual img {
    transform: translate3d(-2%, -2%, 0) scale(1.03);
  }
  .featured-guide__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
  }
  .featured-guide__copy .meta {
    color: var(--stage-soft);
  }
  .featured-guide__copy h2 {
    max-width: 17ch;
    margin-top: 0.8rem;
    color: var(--stage-ink);
  }
  .featured-guide__intro {
    max-width: 35rem;
    margin-top: 1rem;
    color: var(--stage-soft);
    line-height: 1.6;
  }
  .featured-guide .link-arrow {
    margin-top: 1.5rem;
    color: var(--stage-ink);
  }
  .featured-guide:hover .link-arrow {
    color: #ff8d69;
  }
  .featured-guide:hover .link-arrow > :global(svg) {
    transform: translateX(4px);
  }

  /* ── Gidsenindex ─────────────────────────────────────────────────────── */
  .guide-index__grid {
    display: grid;
    grid-template-columns: 0.56fr 1.44fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .guide-index__intro h2 {
    max-width: 14ch;
  }
  .guide-index__intro .lead {
    max-width: 28rem;
    margin-top: 1rem;
    font-size: 1.05rem;
  }
  .guide-list__item {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.2rem;
    padding: 1.35rem 0;
    color: var(--ink);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .guide-list__item:hover,
  .guide-list__item:focus-visible {
    color: var(--vermilion-ink);
  }
  .guide-list__title {
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 560;
    line-height: 1.35;
  }
  .guide-list :global(.guide-list__arrow) {
    flex: none;
    transition: transform 260ms var(--ease-out-soft);
  }
  .guide-list__item:hover :global(.guide-list__arrow),
  .guide-list__item:focus-visible :global(.guide-list__arrow) {
    transform: translateX(4px);
  }

  /* ── Apps ────────────────────────────────────────────────────────────── */
  .knowledge-apps__intro {
    display: grid;
    grid-template-columns: 1fr 0.72fr;
    align-items: end;
    gap: 3rem;
  }
  .knowledge-apps__intro h2 {
    max-width: 14ch;
  }
  .knowledge-apps__intro .lead {
    font-size: 1.05rem;
  }
  .app-rows {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .app-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(19rem, 1.15fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .app-row__image img {
    display: block;
    width: 100%;
  }
  .app-row__copy > p {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .app-row__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  @media (max-width: 899px) {
    .knowledge-hero__inner,
    .featured-guide,
    .guide-index__grid,
    .knowledge-apps__intro,
    .app-row {
      grid-template-columns: 1fr;
    }
    .knowledge-hero__inner {
      gap: 2.5rem;
    }
    .featured-guide__visual {
      min-height: 16rem;
    }
    .guide-list__item {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
    }
    .guide-list__time {
      display: none;
    }
    .knowledge-apps__intro {
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .knowledge-hero__inner {
      padding: 2.25rem 1.25rem;
    }
    .knowledge-hero__copy h1 {
      max-width: none;
      font-size: clamp(2.5rem, 11vw, 3.6rem);
    }
    .decision-map ol {
      flex-direction: column;
      align-items: flex-start;
    }
    .decision-map :global(.decision-map__arrow) {
      transform: rotate(90deg);
    }
    .guide-list__item {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }
    .guide-list__category,
    .guide-list__title {
      grid-column: 1;
    }
    .guide-list :global(.guide-list__arrow) {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
