---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbLd, faqLd } from '../../lib/seo';

export async function getStaticPaths() {
  const articles = (await getCollection('knowledge')).sort((a, b) => a.data.order - b.data.order);
  return articles.map((entry) => ({ params: { id: entry.id }, props: { entry, articles } }));
}

const { entry, articles } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const related = articles.filter((article) => article.id !== entry.id).slice(0, 3);
const origin = Astro.site!.origin;
const path = `/kennis/${entry.id}/`;
const canonical = new URL(path, Astro.site).href;
const formatDate = (date: Date) =>
  date.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' });
const isoDate = (date: Date) => date.toISOString().split('T')[0];

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Kennisbank', href: '/kennis/' },
  { label: data.title },
];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  inLanguage: 'nl-NL',
  mainEntityOfPage: canonical,
  author: { '@id': `${origin}/#person` },
  publisher: { '@id': `${origin}/#business` },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  jsonLd={[articleLd, breadcrumbLd(crumbs, path), ...(data.faqs.length ? [faqLd(data.faqs)] : [])]}
  markdown={`/kennis/${entry.id}.md`}
>
  <article class="article">
    <div class="shell">
      <Breadcrumbs items={crumbs} class="enter-up" />

      <header class="article__header">
        <div>
          <h1 class="display-lg enter-lines" style="--enter-delay: 0.08s">
            <span class="line" style="--i:0"><span>{data.title}</span></span>
          </h1>
          <p class="lead enter-up" style="--enter-delay: 0.3s">{data.intro}</p>
        </div>
        <dl class="article__meta rows enter-up" style="--enter-delay: 0.36s">
          <div><dt>Onderwerp</dt><dd>{data.category}</dd></div>
          <div><dt>Leestijd</dt><dd>{data.readingMinutes} minuten</dd></div>
          <div>
            <dt>Bijgewerkt</dt>
            <dd>
              <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
            </dd>
          </div>
          <div>
            <dt>Ook beschikbaar</dt>
            <dd><a href={`/kennis/${entry.id}.md`} class="text-link">Markdownversie</a></dd>
          </div>
        </dl>
      </header>

      <section
        class="answer enter-up"
        aria-labelledby="short-answer-heading"
        style="--enter-delay: 0.44s"
      >
        <h2 id="short-answer-heading">Kort antwoord</h2>
        <p>{data.answer}</p>
      </section>

      <div class="article__grid">
        <aside class="takeaways" aria-labelledby="takeaways-heading">
          <h2 id="takeaways-heading">Wat je meeneemt</h2>
          <ul class="rows">
            {data.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>
        </aside>

        <div class="prose article__body">
          <Content />
        </div>
      </div>

      {
        data.faqs.length > 0 && (
          <section class="article__faq reveal-up" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="display-md">
              Veelgestelde vragen
            </h2>
            <Faq items={data.faqs} />
          </section>
        )
      }

      <section class="more-guides reveal-up" aria-labelledby="more-guides-heading">
        <div>
          <h2 id="more-guides-heading" class="display-md">Verder verbeteren</h2>
          <p class="lead">Lees verder bij de volgende vraag in de kooproute.</p>
        </div>
        <nav class="rows" aria-label="Meer kennisartikelen">
          {
            related.map((article) => (
              <a href={`/kennis/${article.id}`} class="more-guides__link">
                <span>{article.data.title}</span>
                <Icon name="arrowRight" size={19} />
              </a>
            ))
          }
        </nav>
      </section>
    </div>
  </article>

  <CtaBand
    id="article-cta"
    title="Van inzicht naar een verbetering die in je Shopify-thema werkt."
    text="Ik help met analyse, ontwerp en development—zonder de winkel vol tactieken te stapelen."
    primary={{ label: 'Bespreek je webshop', href: '/contact?dienst=shopify' }}
    compact
  />
</BaseLayout>

<style>
  .article {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .article__header {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    align-items: end;
    gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .article__header h1 {
    max-width: 17ch;
    color: var(--ink);
  }
  .article__header .lead {
    max-width: 46rem;
    margin-top: 1.5rem;
  }

  .article__meta > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    font-size: 0.86rem;
  }
  .article__meta dt {
    color: var(--ink-soft);
  }
  .article__meta dd {
    color: var(--ink);
    font-weight: 560;
  }

  /* Antwoord-eerst: het korte antwoord staat prominent boven de uitleg. */
  .answer {
    display: grid;
    grid-template-columns: 0.42fr 1.58fr;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--radius-stage);
    background: var(--vermilion-soft);
  }
  .answer h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
  }
  .answer p {
    max-width: 48rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2.1rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .article__grid {
    display: grid;
    grid-template-columns: minmax(13rem, 0.46fr) minmax(0, 1.54fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
    margin-top: clamp(4rem, 7vw, 6.5rem);
  }
  .takeaways {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .takeaways h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
  }
  .takeaways ul {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }
  .takeaways li {
    padding: 0.8rem 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .article__body {
    max-width: 46rem;
  }

  .article__faq,
  .more-guides {
    margin-top: clamp(5rem, 9vw, 8rem);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .article__faq {
    display: grid;
    grid-template-columns: 0.55fr 1.45fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .article__faq h2 {
    max-width: 12ch;
  }

  .more-guides {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: clamp(3rem, 7vw, 7rem);
  }
  .more-guides h2 {
    max-width: 12ch;
  }
  .more-guides .lead {
    max-width: 22rem;
    margin-top: 1rem;
    font-size: 1.02rem;
  }
  .more-guides__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    color: var(--ink);
    font-weight: 560;
    line-height: 1.35;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .more-guides__link :global(svg) {
    flex: none;
    transition: transform 260ms var(--ease-out-soft);
  }
  .more-guides__link:hover,
  .more-guides__link:focus-visible {
    color: var(--vermilion-ink);
  }
  .more-guides__link:hover :global(svg),
  .more-guides__link:focus-visible :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 899px) {
    .article__header,
    .answer,
    .article__grid,
    .article__faq,
    .more-guides {
      grid-template-columns: 1fr;
    }
    .article__header {
      gap: 2rem;
    }
    .answer {
      gap: 0.75rem;
    }
    .takeaways {
      position: static;
    }
    .article__faq,
    .more-guides {
      gap: 2rem;
    }
  }

  @media (max-width: 560px) {
    .article__header h1 {
      max-width: none;
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
      overflow-wrap: anywhere;
    }
    .article__meta > div {
      grid-template-columns: 6rem 1fr;
    }
    .answer {
      padding: 1.5rem;
      border-radius: 1.25rem;
    }
  }
</style>
