---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopifyAppGrid from '../components/ShopifyAppGrid.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { getShopifyApps, appName } from '../lib/shopify-apps';
import { breadcrumbLd } from '../lib/seo';
import { SITE } from '../config/site';

const apps = await getShopifyApps();
const pageUrl = `${SITE.url}/shopify-apps/`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Shopify Apps' }];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: 'Shopify Apps van Chris Online',
    url: pageUrl,
    inLanguage: 'nl',
    description: 'Eigen Shopify-apps voor promotiecontrole, productdata en verwachte bezorgdatums.',
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: apps.map((app, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: appName(app),
        url: `${SITE.url}/werk/${app.id}/`,
      })),
    },
  },
  breadcrumbLd(crumbs, '/shopify-apps/'),
];
---

<BaseLayout
  title="Shopify Apps voor promoties, productdata en bezorgdatums"
  description="Ontdek PromoFinch, SpecFinch en Delivery Promise NL. Eigen Shopify-apps van Chris Snoek voor promotiecontrole, productdata en verwachte bezorgdatums."
  jsonLd={jsonLd}
  markdown="/shopify-apps.md"
>
  <div class="apps-page">
    <div class="shell">
      <header class="apps-page__hero">
        <Breadcrumbs items={crumbs} class="enter-up" />
        <h1 class="display-xl enter-up" style="--enter-delay: 0.08s">
          Shopify Apps.<br />Gemaakt voor de praktijk.
        </h1>
        <p class="lead enter-up" style="--enter-delay: 0.16s">
          Eigen apps voor promotiecontrole, betrouwbare productdata en duidelijke
          bezorgverwachtingen. Ontworpen en gebouwd door Chris Snoek.
        </p>
      </header>

      <section
        class="apps-page__catalog enter-up"
        style="--enter-delay: 0.24s"
        aria-label="Shopify Apps van Chris Online"
      >
        <ShopifyAppGrid apps={apps} />
      </section>

      <section class="apps-page__guidance" aria-labelledby="app-guidance-heading">
        <div class="apps-page__guidance-copy lift-in">
          <h2 id="app-guidance-heading" class="display-md">Welke app past bij jouw webshop?</h2>
          <p class="lead">
            Begin bij de vraag die je wilt beantwoorden. Iedere app heeft een eigen taak en is
            zelfstandig te installeren.
          </p>
          <dl class="rows apps-page__list">
            {
              apps.map((app) => (
                <div>
                  <dt>
                    <a href={`/werk/${app.id}`} class="link-arrow">
                      {appName(app)} <Icon name="arrowRight" size={17} />
                    </a>
                  </dt>
                  <dd>{app.data.application?.audience ?? app.data.summary}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="apps-page__help surface surface--deep reveal-up">
          <h3 class="display-sm">Rechtstreeks contact met de maker.</h3>
          <p>Een vraag over de werking of over welke app bij je winkel past? Ik denk met je mee.</p>
          <a href="/contact?dienst=shopify" class="btn btn--ink">
            Stel je vraag <Icon name="arrowRight" size={18} />
          </a>
          <p class="meta">
            Actuele prijzen, proefperiodes en installatie vind je in de Shopify App Store.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .apps-page {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 9vw, 8rem);
  }
  .apps-page__hero {
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }
  .apps-page__hero h1 {
    max-width: 14ch;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .apps-page__hero .lead {
    max-width: 40rem;
    margin-top: 1.5rem;
  }

  .apps-page__guidance {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.8fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: clamp(5rem, 9vw, 8rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .apps-page__guidance-copy h2 {
    max-width: 16ch;
  }
  .apps-page__guidance-copy .lead {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: 1.05rem;
  }
  .apps-page__list {
    margin-top: 2rem;
  }
  .apps-page__list > div {
    padding: 1.1rem 0;
  }
  .apps-page__list dt {
    font-weight: 600;
  }
  .apps-page__list dd {
    max-width: 44rem;
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }

  .apps-page__help {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .apps-page__help p {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .apps-page__help .btn {
    margin-top: 1.5rem;
  }
  .apps-page__help .meta {
    margin-top: 1.5rem;
    font-size: 0.82rem;
  }

  @media (max-width: 899px) {
    .apps-page__guidance {
      grid-template-columns: 1fr;
    }
  }
</style>
