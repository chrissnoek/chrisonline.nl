---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShopifyAppGrid from '../../../components/ShopifyAppGrid.astro';
import Icon from '../../../components/Icon.astro';
import { getEnglishApps, englishAppPath } from '../../../lib/english-apps';
import { appName } from '../../../lib/shopify-apps';
import { SITE, CONTACT } from '../../../config/site';

const apps = await getEnglishApps();
const translations = Object.fromEntries(apps.map((app) => [app.project.id, app.translation.data]));
const url = `${SITE.url}/en/shopify-apps/`;
const description =
  'Discover SpecFinch for Shopify product data monitoring and PromoFinch for discount and gross-margin checks. Independent apps by Chris Snoek, Chris Online.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${url}#page`,
  name: 'Shopify Apps by Chris Online',
  description,
  url,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: apps.map(({ project }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: appName(project),
      url: `${SITE.url}${englishAppPath(project.id)}`,
    })),
  },
};
---

<BaseLayout
  lang="en"
  title="Shopify Apps for Product Data & Promotion Checks"
  description={description}
  jsonLd={[jsonLd]}
  markdown="/en/shopify-apps.md"
>
  <div class="apps-page">
    <div class="shell">
      <header class="apps-page__hero">
        <h1 class="display-xl enter-up">Focused Shopify apps.<br />Built for daily work.</h1>
        <p class="lead enter-up" style="--enter-delay: 0.1s">
          Monitor required product data and check promotion prices. Independent apps designed and
          built by Chris Snoek.
        </p>
      </header>

      <section class="enter-up" style="--enter-delay: 0.2s" aria-labelledby="catalog-heading">
        <h2 id="catalog-heading" class="visually-hidden">Shopify Apps by Chris Online</h2>
        <ShopifyAppGrid
          apps={apps.map((app) => app.project)}
          lang="en"
          translations={translations}
        />
      </section>

      <section class="apps-page__choice" aria-labelledby="choice-heading">
        <div class="apps-page__choice-copy lift-in">
          <h2 id="choice-heading" class="display-md">Start with the problem you need to check.</h2>
          <p class="lead">Each app has a defined job and can be installed independently.</p>
          <dl class="rows apps-page__list">
            <div>
              <dt>
                <a href="/en/shopify-apps/specfinch/" class="link-arrow">
                  SpecFinch <Icon name="arrowRight" size={17} />
                </a>
              </dt>
              <dd>
                Monitor missing required product fields after imports and edits, with new issues
                separated from existing cleanup work.
              </dd>
            </div>
            <div>
              <dt>
                <a href="/en/shopify-apps/promofinch/" class="link-arrow">
                  PromoFinch <Icon name="arrowRight" size={17} />
                </a>
              </dt>
              <dd>
                Check supported percentage promotions against your price and estimated gross-margin
                limits, then monitor campaign changes.
              </dd>
            </div>
          </dl>
          <p class="apps-page__limits">
            Both apps are read-only. Your team reviews findings and makes corrections in Shopify.
            Their product pages explain supported checks and limits.
          </p>
        </div>
        <div class="apps-page__help surface surface--deep reveal-up">
          <h3 class="display-sm">Support from the person who built it.</h3>
          <p>
            Have a question about setup or which app fits your store? Contact Chris Online directly.
          </p>
          <a href={`mailto:${CONTACT.email}`} class="btn btn--ink">
            Contact app support <Icon name="arrowRight" size={18} />
          </a>
          <p class="meta">
            Install through the Shopify App Store. Each listing has current pricing and trial
            details. Both app interfaces are in English.
          </p>
        </div>
      </section>

      <section class="apps-page__guides reveal-up" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="display-md">Understand the check before choosing an app.</h2>
        <dl class="rows apps-page__list">
          <div>
            <dt>
              <a href="/en/guides/find-missing-shopify-product-data/" class="link-arrow">
                Find missing Shopify SKUs, barcodes and metafields <Icon
                  name="arrowRight"
                  size={17}
                />
              </a>
            </dt>
            <dd>A manual audit, CSV limitations and the baseline workflow.</dd>
          </div>
          <div>
            <dt>
              <a href="/en/guides/check-shopify-discount-margins/" class="link-arrow">
                Check Shopify discount prices and gross margins <Icon name="arrowRight" size={17} />
              </a>
            </dt>
            <dd>A worked calculation, missing costs and a campaign review checklist.</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .apps-page {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(5rem, 9vw, 8rem);
  }
  .apps-page__hero {
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }
  .apps-page__hero h1 {
    max-width: 14ch;
  }
  .apps-page__hero .lead {
    max-width: 38rem;
    margin-top: 1.5rem;
  }

  .apps-page__choice {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.8fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: clamp(5rem, 9vw, 8rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .apps-page__choice-copy h2,
  .apps-page__guides h2 {
    max-width: 18ch;
  }
  .apps-page__choice-copy .lead {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: 1.05rem;
  }
  .apps-page__list {
    margin-top: 2rem;
  }
  .apps-page__list > div {
    padding: 1.1rem 0;
  }
  .apps-page__list dt {
    font-weight: 600;
  }
  .apps-page__list dt .link-arrow {
    text-align: left;
  }
  .apps-page__list dd {
    max-width: 44rem;
    margin-top: 0.2rem;
    color: var(--ink-soft);
  }
  .apps-page__limits {
    max-width: 44rem;
    margin-top: 1.75rem;
    color: var(--ink-soft);
  }

  .apps-page__help {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .apps-page__help h3 {
    font-weight: 400;
  }
  .apps-page__help p {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .apps-page__help .btn {
    margin-top: 1.5rem;
  }
  .apps-page__help .meta {
    margin-top: 1.5rem;
    font-size: 0.82rem;
  }

  .apps-page__guides {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 899px) {
    .apps-page__choice {
      grid-template-columns: 1fr;
    }
  }
</style>
