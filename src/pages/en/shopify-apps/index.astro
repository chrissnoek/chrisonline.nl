---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShopifyAppGrid from '../../../components/ShopifyAppGrid.astro';
import Icon from '../../../components/Icon.astro';
import { getEnglishApps, englishAppPath } from '../../../lib/english-apps';
import { appName } from '../../../lib/shopify-apps';
import { SITE, CONTACT } from '../../../config/site';

const apps = await getEnglishApps();
const translations = Object.fromEntries(apps.map((app) => [app.project.id, app.translation.data]));
const url = `${SITE.url}/en/shopify-apps/`;
const description =
  'Discover SpecFinch for Shopify product data monitoring and PromoFinch for discount and gross-margin checks. Independent apps by Chris Snoek, Chris Online.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${url}#page`,
  name: 'Shopify Apps by Chris Online',
  description,
  url,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: apps.map(({ project }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: appName(project),
      url: `${SITE.url}${englishAppPath(project.id)}`,
    })),
  },
};
---

<BaseLayout
  lang="en"
  title="Shopify Apps for Product Data & Promotion Checks"
  description={description}
  jsonLd={[jsonLd]}
  markdown="/en/shopify-apps.md"
>
  <div class="english-apps">
    <div class="apps-container">
      <header class="apps-hero">
        <h1 class="enter-up">Focused Shopify apps.<br />Built for daily work.</h1>
        <p class="enter-up">
          Monitor required product data and check promotion prices. Independent apps designed and
          built by Chris Snoek.
        </p>
      </header>

      <section aria-labelledby="catalog-heading">
        <h2 id="catalog-heading" class="sr-only">Shopify Apps by Chris Online</h2>
        <ShopifyAppGrid
          apps={apps.map((app) => app.project)}
          lang="en"
          translations={translations}
        />
      </section>

      <section class="app-choice" aria-labelledby="choice-heading">
        <h2 id="choice-heading">Start with the problem you need to check.</h2>
        <div class="choice-grid">
          <div>
            <p>Each app has a defined job and can be installed independently.</p>
            <dl>
              <div>
                <dt><a href="/en/shopify-apps/specfinch/">SpecFinch</a></dt><dd>
                  Monitor missing required product fields after imports and edits, with new issues
                  separated from existing cleanup work.
                </dd>
              </div>
              <div>
                <dt><a href="/en/shopify-apps/promofinch/">PromoFinch</a></dt><dd>
                  Check supported percentage promotions against your price and estimated
                  gross-margin limits, then monitor campaign changes.
                </dd>
              </div>
            </dl>
            <p class="app-limits">
              Both apps are read-only. Your team reviews findings and makes corrections in Shopify.
              Their product pages explain supported checks and limits.
            </p>
          </div>
          <div class="app-help">
            <h3>Support from the person who built it.</h3>
            <p>
              Have a question about setup or which app fits your store? Contact Chris Online
              directly.
            </p>
            <a href={`mailto:${CONTACT.email}`}
              >Contact app support <Icon name="arrowRight" size={18} /></a
            >
            <p class="pricing-note">
              Install through the Shopify App Store. Each listing has current pricing and trial
              details. Both app interfaces are in English.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .english-apps {
    background: #f5f5f2;
    color: #111;
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }
  .apps-container {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }
  .apps-hero {
    padding: clamp(2.5rem, 5vw, 5rem) 0 clamp(3rem, 5vw, 5rem);
  }
  h1 {
    max-width: 68rem;
    font-size: clamp(2.65rem, 5.5vw, 5.4rem);
    font-weight: 580;
    letter-spacing: -0.06em;
    line-height: 1.04;
  }
  .apps-hero p {
    max-width: 38rem;
    margin-top: 1.5rem;
    color: #62625e;
    font-size: 1.1rem;
  }
  .app-choice {
    padding-top: clamp(4rem, 7vw, 7rem);
  }
  h2 {
    max-width: 54rem;
    font-size: clamp(2rem, 3.5vw, 3.3rem);
    line-height: 1.1;
    font-weight: 580;
    letter-spacing: -0.045em;
  }
  .choice-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: 2rem;
  }
  .choice-grid p,
  dd {
    color: #62625e;
  }
  dl {
    display: grid;
    gap: 1.7rem;
    margin-top: 2rem;
  }
  dt {
    font-weight: 650;
    margin-bottom: 0.35rem;
  }
  dt a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .app-limits {
    margin-top: 2rem;
  }
  .app-help {
    align-self: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.25rem;
    background: #fff;
  }
  .app-help h3 {
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.035em;
    font-weight: 620;
  }
  .app-help p {
    margin-top: 1rem;
  }
  .app-help a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.8rem;
    margin-top: 1.3rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .app-help .pricing-note {
    font-size: 0.85rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 767px) {
    .apps-container {
      width: min(100% - 2.5rem, 35rem);
    }
    .choice-grid {
      grid-template-columns: 1fr;
    }
    .apps-hero p {
      font-size: 1rem;
    }
  }
</style>
