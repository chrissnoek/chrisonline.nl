---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../../lib/seo';
import { SITE } from '../../../config/site';

const guides = await getCollection('englishGuides');
const description =
  'Practical Shopify guides to checking missing SKUs, barcodes and metafields, and calculating estimated gross margins after percentage discounts.';
const crumbs = [{ label: 'Shopify Apps', href: '/en/shopify-apps/' }, { label: 'Guides' }];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shopify product data and discount guides',
  description,
  url: `${SITE.url}/en/guides/`,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.data.title,
      url: `${SITE.url}/en/guides/${guide.id}/`,
    })),
  },
};
---

<BaseLayout
  lang="en"
  title="Shopify Product Data & Discount Margin Guides"
  description={description}
  jsonLd={[jsonLd, breadcrumbLd(crumbs, '/en/guides/')]}
>
  <section class="guides">
    <div class="shell">
      <Breadcrumbs items={crumbs} lang="en" class="enter-up" />
      <header class="guides__header">
        <h1 class="display-lg enter-lines" style="--enter-delay: 0.08s">
          <span class="line" style="--i:0"><span>Practical checks for your</span></span>
          <span class="line" style="--i:1"><span>Shopify catalog & campaigns.</span></span>
        </h1>
        <p class="lead enter-up" style="--enter-delay: 0.3s">
          Learn the manual workflow, review the inputs and decide when a recurring app check helps.
        </p>
      </header>

      <nav class="guide-list rows reveal-up" aria-label="Practical Shopify guides">
        {
          guides.map((guide) => (
            <a href={`/en/guides/${guide.id}/`} class="guide-list__item">
              <div>
                <h2 class="display-sm">{guide.data.title}</h2>
                <p>{guide.data.intro}</p>
              </div>
              <span class="guide-list__go" aria-hidden="true">
                <Icon name="arrowRight" size={20} />
              </span>
            </a>
          ))
        }
      </nav>

      <a class="link-arrow link-arrow--accent guides__apps reveal-up" href="/en/shopify-apps/"
        >Explore Shopify Apps <Icon name="arrowRight" size={18} /></a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .guides {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 9vw, 8rem);
  }
  .guides__header {
    max-width: 60rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .guides__header h1 {
    color: var(--ink);
  }
  .guides__header .lead {
    max-width: 40rem;
    margin-top: 1.5rem;
  }

  .guide-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .guide-list__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .guide-list__item h2 {
    transition: color 180ms ease;
  }
  .guide-list__item p {
    max-width: 48rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .guide-list__go {
    display: grid;
    width: 2.85rem;
    height: 2.85rem;
    flex: none;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      transform 300ms var(--ease-out-soft);
  }
  .guide-list__item:hover h2,
  .guide-list__item:focus-visible h2 {
    color: var(--vermilion-ink);
  }
  .guide-list__item:hover .guide-list__go,
  .guide-list__item:focus-visible .guide-list__go {
    background: var(--vermilion);
    border-color: var(--vermilion);
    color: #fff;
    transform: translateX(4px);
  }

  .guides__apps {
    margin-top: 2rem;
  }

  @media (max-width: 560px) {
    .guides__header h1 {
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
      overflow-wrap: anywhere;
    }
    .guide-list__item {
      padding: 1.5rem 0;
    }
  }
</style>
