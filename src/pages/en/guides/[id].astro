---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  return (await getCollection('englishGuides')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const canonical = `${SITE.url}/en/guides/${entry.id}/`;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: data.title,
  description: data.description,
  url: canonical,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: canonical,
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#business` },
  about: { '@id': `${SITE.url}/werk/${data.appId}/#software` },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Shopify Apps',
      item: `${SITE.url}/en/shopify-apps/`,
    },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/en/guides/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ],
};
---

<BaseLayout
  lang="en"
  title={data.title}
  description={data.description}
  type="article"
  jsonLd={[articleLd, breadcrumbLd]}
  markdown={`/en/guides/${entry.id}.md`}
>
  <article class="guide">
    <div class="guide-container">
      <a class="guide-back" href="/en/guides/"><Icon name="arrowLeft" size={18} /> All guides</a>
      <header class="guide-header">
        <h1>{data.title}</h1>
        <p class="guide-intro">{data.intro}</p>
        <p class="guide-meta">
          By Chris Snoek, developer of {data.appName}. Updated <time
            datetime={data.updatedDate.toISOString().split('T')[0]}
            >{
              data.updatedDate.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })
            }</time
          >. <a href={`/en/guides/${entry.id}.md`}>Read in Markdown</a>
        </p>
      </header>
      <section class="guide-answer" aria-labelledby="answer-heading">
        <h2 id="answer-heading">Short answer</h2><p>{data.answer}</p>
      </section>
      <div class="guide-grid">
        <aside aria-labelledby="key-points-heading">
          <h2 id="key-points-heading">Key points</h2><ul>
            {data.keyTakeaways.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
        <div class="guide-prose prose-project"><Content /></div>
      </div>
      <section class="guide-product" aria-labelledby="product-heading">
        <h2 id="product-heading">See the checks in {data.appName}.</h2>
        <p>
          Review supported features, limits and real app screenshots before choosing a workflow.
        </p>
        <a href={`/en/shopify-apps/${data.appId}/`}
          >Explore {data.appName} <Icon name="arrowRight" size={18} /></a
        >
      </section>
    </div>
  </article>
</BaseLayout>
<style>
  .guide {
    padding: clamp(2rem, 5vw, 5rem) 0 clamp(5rem, 9vw, 9rem);
    background: #fff;
    color: #111;
  }
  .guide-container {
    width: min(100% - 3rem, 74rem);
    margin-inline: auto;
  }
  .guide-back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #62625e;
  }
  .guide-header {
    max-width: 60rem;
    margin-top: 3rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 4.8rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .guide-intro {
    max-width: 48rem;
    margin-top: 1.5rem;
    color: #565652;
    font-size: 1.2rem;
    line-height: 1.6;
  }
  .guide-meta {
    margin-top: 1.5rem;
    color: #62625e;
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .guide-meta a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .guide-answer {
    margin-top: 3rem;
    padding: clamp(1.5rem, 3vw, 3rem);
    background: #fff0eb;
  }
  .guide-answer h2 {
    font-size: 1rem;
    font-weight: 650;
  }
  .guide-answer p {
    margin-top: 1rem;
    max-width: 60rem;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.5;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: 4rem;
  }
  aside {
    align-self: start;
    border-top: 2px solid #111;
    padding-top: 1rem;
  }
  aside h2 {
    font-weight: 650;
  }
  aside li {
    padding: 1rem 0;
    border-bottom: 1px solid #deded9;
    color: #62625e;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .guide-prose {
    min-width: 0;
  }
  .guide-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .guide-prose :global(ol) {
    list-style: decimal;
    padding-left: 1.4rem;
  }
  .guide-prose :global(ol li + li) {
    margin-top: 0.6rem;
  }
  .guide-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .guide-prose :global(th),
  .guide-prose :global(td) {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #deded9;
    overflow-wrap: anywhere;
  }
  .guide-prose :global(th) {
    background: #f5f5f2;
    font-weight: 650;
  }
  .guide-product {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid #deded9;
  }
  .guide-product h2 {
    font-size: clamp(1.9rem, 3vw, 3rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }
  .guide-product p {
    margin-top: 1rem;
    color: #62625e;
  }
  .guide-product a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    min-height: 2.8rem;
    color: var(--accent-text);
    font-weight: 650;
  }
  @media (max-width: 767px) {
    .guide-container {
      width: min(100% - 2.5rem, 42rem);
    }
    .guide-grid {
      grid-template-columns: 1fr;
    }
    .guide-intro {
      font-size: 1.05rem;
    }
  }
</style>
