---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../../lib/seo';
import { SITE } from '../../../config/site';

export async function getStaticPaths() {
  return (await getCollection('englishGuides')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const path = `/en/guides/${entry.id}/`;
const canonical = `${SITE.url}${path}`;
const crumbs = [
  { label: 'Shopify Apps', href: '/en/shopify-apps/' },
  { label: 'Guides', href: '/en/guides/' },
  { label: data.title },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: data.title,
  description: data.description,
  url: canonical,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.updatedDate.toISOString(),
  inLanguage: 'en',
  mainEntityOfPage: canonical,
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#business` },
  about: { '@id': `${SITE.url}/werk/${data.appId}/#software` },
};
---

<BaseLayout
  lang="en"
  title={data.title}
  description={data.description}
  type="article"
  jsonLd={[articleLd, breadcrumbLd(crumbs, path)]}
  markdown={`/en/guides/${entry.id}.md`}
>
  <article class="guide">
    <div class="shell">
      <Breadcrumbs items={crumbs} lang="en" class="enter-up" />

      <header class="guide__header">
        <h1 class="display-lg enter-lines" style="--enter-delay: 0.08s">
          <span class="line" style="--i:0"><span>{data.title}</span></span>
        </h1>
        <p class="lead enter-up" style="--enter-delay: 0.3s">{data.intro}</p>
        <p class="meta guide__meta enter-up" style="--enter-delay: 0.36s">
          By Chris Snoek, developer of {data.appName}. Updated <time
            datetime={data.updatedDate.toISOString().split('T')[0]}
            >{
              data.updatedDate.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })
            }</time
          >. <a href={`/en/guides/${entry.id}.md`} class="text-link">Read in Markdown</a>
        </p>
      </header>

      <section
        class="answer enter-up"
        aria-labelledby="answer-heading"
        style="--enter-delay: 0.44s"
      >
        <h2 id="answer-heading">Short answer</h2>
        <p>{data.answer}</p>
      </section>

      <div class="guide__grid">
        <aside class="key-points" aria-labelledby="key-points-heading">
          <h2 id="key-points-heading">Key points</h2>
          <ul class="rows">
            {data.keyTakeaways.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
        <div class="prose guide__body"><Content /></div>
      </div>

      <section class="guide__product reveal-up" aria-labelledby="product-heading">
        <div>
          <h2 id="product-heading" class="display-md">See the checks in {data.appName}.</h2>
          <p class="lead">
            Review supported features, limits and real app screenshots before choosing a workflow.
          </p>
        </div>
        <a href={`/en/shopify-apps/${data.appId}/`} class="btn btn--ink"
          >Explore {data.appName} <Icon name="arrowRight" size={18} /></a
        >
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .guide {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(5rem, 9vw, 8rem);
  }
  .guide__header {
    max-width: 60rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .guide__header h1 {
    max-width: 18ch;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .guide__header .lead {
    max-width: 46rem;
    margin-top: 1.5rem;
  }
  .guide__meta {
    margin-top: 1.5rem;
    line-height: 1.7;
  }

  /* Answer first: the short answer sits prominently above the explanation. */
  .answer {
    display: grid;
    grid-template-columns: 0.42fr 1.58fr;
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--radius-stage);
    background: var(--vermilion-soft);
  }
  .answer h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
  }
  .answer p {
    max-width: 50rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem);
    line-height: 1.32;
    text-wrap: pretty;
  }

  .guide__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: clamp(4rem, 7vw, 6.5rem);
  }
  .key-points {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .key-points h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0;
  }
  .key-points ul {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }
  .key-points li {
    padding: 0.9rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .guide__body {
    min-width: 0;
    max-width: 46rem;
  }

  .guide__product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem 3rem;
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .guide__product h2 {
    max-width: 16ch;
  }
  .guide__product .lead {
    max-width: 34rem;
    margin-top: 1rem;
    font-size: 1.02rem;
  }

  @media (max-width: 899px) {
    .answer,
    .guide__grid,
    .guide__product {
      grid-template-columns: 1fr;
    }
    .answer {
      gap: 0.75rem;
    }
    .key-points {
      position: static;
    }
    .guide__product {
      align-items: start;
    }
  }

  @media (max-width: 560px) {
    .guide__header h1 {
      max-width: none;
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
    }
    .answer {
      padding: 1.5rem;
      border-radius: 1.25rem;
    }
  }
</style>
