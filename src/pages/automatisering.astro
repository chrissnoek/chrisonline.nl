---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbLd, faqLd } from '../lib/seo';
import { CONTACT, SITE } from '../config/site';

const contactHref = '/contact?dienst=automatisering#contactformulier';

const automations = [
  {
    title: 'Offertes automatisch opvolgen',
    description:
      'Herinneringen op afgesproken momenten en een overzicht van offertes die jouw aandacht nodig hebben.',
    price: '€ 1.500–2.500',
    time: '± 3 uur p/w terug*',
  },
  {
    title: 'Van werkbon naar conceptfactuur',
    description:
      'Gegevens uit een afgeronde werkbon controleren en klaarzetten voor je boekhouding.',
    price: '€ 2.000–3.500',
    time: '± 4 uur p/w terug*',
  },
  {
    title: 'Mailbox voorsorteren',
    description:
      'Berichten labelen, prioriteren en waar passend een conceptantwoord voorbereiden. Jij houdt de controle.',
    price: '€ 1.250–2.000',
    time: '± 3 uur p/w terug*',
  },
  {
    title: 'Urenregistratie doorzetten',
    description:
      'Ingevoerde uren controleren en zonder dubbel overtypen klaarzetten voor administratie of salarisverwerking.',
    price: '€ 1.500–2.500',
    time: '± 3 uur p/w terug*',
  },
  {
    title: 'Webshop en boekhouding koppelen',
    description: 'Bestellingen, betalingen en btw-gegevens volgens afgesproken regels doorzetten.',
    price: '€ 1.750–3.000',
    time: '± 2 uur p/w terug*',
  },
  {
    title: 'Afspraken bevestigen en herinneren',
    description: 'Klanten automatisch een bevestiging en tijdige herinnering sturen.',
    price: '€ 1.000–1.750',
    time: '± 2 uur p/w terug*',
  },
  {
    title: 'Voorraadwaarschuwingen voorbereiden',
    description: 'Ondergrenzen signaleren en een bestelling klaarzetten die je zelf controleert.',
    price: '€ 2.000–3.500',
    time: '± 2 uur p/w terug*',
  },
  {
    title: 'Na een klus om een review vragen',
    description: 'Na afronding automatisch een vriendelijke uitnodiging versturen.',
    price: '€ 750–1.250',
    time: '± 1 uur p/w terug*',
  },
  {
    title: 'Gemiste oproepen naar een takenlijst',
    description: 'Voicemail laten uitschrijven en als terugbeltaak klaarzetten.',
    price: '€ 1.250–2.000',
    time: '± 2 uur p/w terug*',
  },
];

const steps = [
  {
    title: 'Jij wijst de tijdvreter aan',
    text: 'Vertel welke taak terugkomt, hoeveel tijd die kost en welke programma’s erbij horen. Je hoeft zelf geen technische oplossing te bedenken.',
  },
  {
    title: 'Je krijgt een haalbaar voorstel',
    text: 'Ik breng het proces, de uitzonderingen en benodigde toegang in kaart. Je ziet wat verstandig is, wat het ongeveer kost en waar controle nodig blijft.',
  },
  {
    title: 'We bouwen en testen samen',
    text: 'Na akkoord bouw ik de afgesproken route. Eerst met testdata en duidelijke acceptatiepunten, daarna pas in je dagelijkse proces.',
  },
];

const agreements = [
  {
    title: 'Scope en acceptatie',
    text: 'Vooraf staat vast welke stappen worden gebouwd, welke uitzonderingen buiten scope vallen en hoe we controleren dat het werkt.',
  },
  {
    title: 'Eerst testen, dan live',
    text: 'Financiële boekingen en klantcommunicatie krijgen waar nodig een menselijke controle voordat iets definitief wordt verstuurd.',
  },
  {
    title: 'Zo min mogelijk toegang',
    text: 'Ik vraag alleen toegang tot systemen en gegevens die voor de afgesproken workflow nodig zijn.',
  },
  {
    title: 'Overdracht en lopende kosten',
    text: 'Je ziet vooraf welke accounts, softwarekosten en onderhoudstaken blijven bestaan en wie waarvoor verantwoordelijk is.',
  },
];

const faqs = [
  {
    question: 'Kan ieder administratief klusje worden geautomatiseerd?',
    answer:
      'Nee. Taken met veel uitzonderingen, wisselende invoer of belangrijk menselijk oordeel zijn niet altijd geschikt. Soms is een eenvoudiger proces of betere werkinstructie verstandiger dan software. Dat zeg ik dan ook.',
  },
  {
    question: 'Moet ik overstappen naar andere programma’s?',
    answer:
      'Niet per se. Eerst kijk ik wat met je huidige programma’s mogelijk is. Als een extra hulpmiddel of abonnement nodig is, staat dat apart in het voorstel.',
  },
  {
    question: 'Waar gebruik je AI voor?',
    answer:
      'Alleen waar het nuttig en controleerbaar is, bijvoorbeeld om e-mail of documenten te classificeren, informatie samen te vatten of een concept voor te bereiden. Kritieke beslissingen en definitieve verzendingen blijven waar nodig bij een mens.',
  },
  {
    question: 'Blijf ik zelf controleren wat er gebeurt?',
    answer:
      'Ja. Samen bepalen we welke stappen automatisch mogen en waar eerst jouw akkoord nodig blijft, bijvoorbeeld bij facturen, betalingen of berichten aan klanten.',
  },
  {
    question: 'Wat gebeurt er nadat ik contact opneem?',
    answer:
      'Je ontvangt meestal binnen één werkdag een reactie. Eerst bepalen we of de taak geschikt lijkt. Daarna krijg je de vragen en aannames die nodig zijn voor een concreet voorstel. Je zit nergens aan vast.',
  },
];

const title = 'Bedrijfsprocessen automatiseren';
const description =
  'Laat terugkerende administratie en handmatig regelwerk slim automatiseren. Chris Snoek koppelt je bestaande systemen en bouwt controleerbare workflows voor het mkb.';

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Bedrijfsprocessen automatiseren',
  description,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: 'Nederland',
  url: `${SITE.url}/automatisering`,
};

const crumbs = [{ label: 'Home', href: '/' }, { label: title }];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[serviceLd, faqLd(faqs), breadcrumbLd(crumbs, Astro.url.pathname)]}
>
  <section class="auto-hero" aria-labelledby="automation-title">
    <div class="shell shell--wide">
      <div class="auto-hero__stage stage">
        <span class="sun" aria-hidden="true"></span>

        <div class="auto-hero__copy">
          <Breadcrumbs items={crumbs} class="auto-hero__crumbs enter-up" />
          <a
            href="/#diensten"
            class="link-arrow auto-hero__back enter-up"
            style="--enter-delay: 0.04s"
          >
            <Icon name="arrowLeft" size={16} /> Alle diensten
          </a>
          <p class="kicker enter-up" style="--enter-delay: 0.08s">
            Procesautomatisering & AI voor het mkb
          </p>
          <h1 id="automation-title" class="display-xl enter-up" style="--enter-delay: 0.14s">
            Terugkerend regelwerk? Laat je systemen het voorwerk doen.
          </h1>
          <p class="lead enter-up" style="--enter-delay: 0.22s">
            Offertes opvolgen, werkbonnen overtypen, facturen klaarzetten of een mailbox sorteren.
            Jij laat zien waar tijd weglekt; ik bouw een betrouwbare workflow rond de programma’s
            die je al gebruikt.
          </p>
          <div class="auto-hero__actions enter-up" style="--enter-delay: 0.3s">
            <a href={contactHref} class="btn btn--primary">
              Vraag mijn gratis procescheck aan
              <Icon name="arrowRight" size={18} />
            </a>
            <a href="#werkwijze" class="btn btn--line">Bekijk hoe het werkt</a>
          </div>
          <p class="meta enter-up" style="--enter-delay: 0.36s">
            Gratis eerste procescheck · meestal reactie binnen één werkdag · geen verplichting
          </p>
        </div>

        <div
          class="workflow-window enter-up"
          style="--enter-delay: 0.24s"
          aria-label="Voorbeeld van een geautomatiseerde avondlijst"
        >
          <div class="workflow-window__head">
            <span class="workflow-window__status"><span class="status-dot"></span> Avondlijst</span>
            <span>dinsdag · 18:10</span>
          </div>
          <ol class="workflow-list">
            <li style="--flow-delay: 0.45s">
              <span>18:10</span><strong>Werkbon controleren</strong><em>klaar</em>
            </li>
            <li style="--flow-delay: 0.6s">
              <span>18:12</span><strong>Conceptfactuur maken</strong><em>klaar</em>
            </li>
            <li style="--flow-delay: 0.75s">
              <span>18:13</span><strong>Open offertes signaleren</strong><em>klaar</em>
            </li>
            <li style="--flow-delay: 0.9s">
              <span>18:14</span><strong>Uren doorzetten</strong><em>klaar</em>
            </li>
          </ol>
          <div class="workflow-result">
            <span>Jij controleert alleen de uitzonderingen.</span>
            <strong>avond terug</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-label="Wanneer automatisering past">
    <div class="shell fit-split reveal-up">
      <div class="fit-split__item">
        <h2>
          <span class="fit-icon fit-icon--yes"><Icon name="check" size={19} /></span>
          Vaak geschikt
        </h2>
        <p>
          Een taak komt wekelijks terug, volgt meestal dezelfde stappen en gebruikt informatie die
          al digitaal beschikbaar is.
        </p>
      </div>
      <div class="fit-split__item">
        <h2>
          <span class="fit-icon fit-icon--no" aria-hidden="true">×</span>
          Niet altijd verstandig
        </h2>
        <p>
          Een taak gebeurt zelden, verandert telkens of vraagt bij iedere stap menselijk oordeel.
          Dan adviseer ik iets anders.
        </p>
      </div>
    </div>
  </section>

  <section id="werkwijze" class="section auto-process" aria-labelledby="process-title">
    <div class="shell">
      <SectionHeading
        id="process-title"
        kicker="Zo werkt het"
        title="Eerst het proces begrijpen. Dan pas automatiseren."
        lead="Een goede automatisering begint niet bij een tool, maar bij de manier waarop het werk nu echt loopt."
        split
      />

      <ol class="steps reveal-up">
        {
          steps.map((step) => (
            <li class="step">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="procescheck surface surface--deep reveal-up">
        <p>
          <strong>Wat krijg je bij de eerste procescheck?</strong>
          Een korte beoordeling van de tijdvreter, de belangrijkste vragen en een eerlijk beeld van wat
          wel of niet logisch te automatiseren is.
        </p>
        <a href={contactHref} class="link-arrow link-arrow--accent">
          Vraag de gratis procescheck aan <Icon name="arrowRight" size={17} />
        </a>
      </div>
    </div>
  </section>

  <section id="mogelijkheden" class="section section--deep" aria-labelledby="menu-title">
    <div class="shell">
      <SectionHeading
        id="menu-title"
        kicker="Veelgevraagde automatiseringen"
        title="Kies geen softwarepakket. Begin bij het werk dat je terug wilt."
        lead="Dit zijn indicatieve, eenmalige projecten exclusief btw. Je definitieve voorstel vermeldt de scope, vaste projectprijs en eventuele softwarekosten afzonderlijk."
        split
      />

      <ul class="automations rows reveal-up" aria-describedby="time-disclaimer">
        {
          automations.map((item) => (
            <li class="automation">
              <div class="automation__copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <div class="automation__facts">
                <span class="automation__price">{item.price}</span>
                <span class="automation__time">{item.time}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <p id="time-disclaimer" class="disclaimer meta">
        * De tijdwinstlabels zijn een eerste inschatting op basis van de genoemde taak, geen
        garantie. De uiteindelijke uitkomst hangt af van je proces, systemen, uitzonderingen,
        datatoegang en gewenste controles.
      </p>

      <div class="stage stage--ink ask reveal-up">
        <div>
          <h3>Staat jouw tijdvreter er niet tussen?</h3>
          <p>Beschrijf de terugkerende taak. Ik laat je weten of automatiseren logisch lijkt.</p>
        </div>
        <a href={contactHref} class="btn btn--primary">Vraag mijn gratis procescheck aan</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="calculation-title">
    <div class="shell calc">
      <div class="lift-in">
        <p class="kicker">Controleerbare rekensom</p>
        <h2 id="calculation-title" class="display-md">Reken met aannames die je kunt aanpassen.</h2>
        <p class="lead">
          Dit fictieve voorbeeld laat alleen de eenvoudige waarde van handmatige uren zien. Het is
          geen belofte over jouw werkelijke besparing.
        </p>
        <p class="calc__assumption">
          Uitgangspunt: 7 uur per week, 46 werkweken per jaar en een interne uurwaarde van €45.
        </p>
      </div>

      <div class="calc__card frame frame--lift reveal-up">
        <p class="calc__head">Voorbeeld · 7 uur terugkerend werk per week</p>
        <dl>
          <div><dt>Handmatige tijd per jaar</dt><dd>7 × 46 = 322 uur</dd></div>
          <div><dt>Waarde bij €45 per uur</dt><dd>€ 14.490 per jaar</dd></div>
          <div><dt>Twee indicatieve projecten</dt><dd>€ 3.500–6.000</dd></div>
          <div class="calc__total">
            <dt>Eenvoudige terugverdientijd</dt><dd><strong>ongeveer 3–5 maanden</strong></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--deep" aria-labelledby="agreements-title">
    <div class="shell">
      <SectionHeading
        id="agreements-title"
        kicker="Vooraf duidelijk"
        title="Geen grote beloftes. Wel concrete afspraken."
        lead="Automatisering raakt je dagelijkse werk. Daarom horen grenzen, controles en eigenaarschap bij het voorstel, niet pas bij de oplevering."
        split
      />
      <ul class="agreements reveal-up">
        {
          agreements.map((item) => (
            <li class="agreement">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="shell auto-faq">
      <div class="lift-in">
        <p class="kicker">Veelgestelde vragen</p>
        <h2 id="faq-title" class="display-md">Wat je vooraf wilt weten.</h2>
        <p class="lead">
          Staat je vraag er niet tussen? <a href={contactHref} class="text-link"
            >Leg je situatie aan me voor.</a
          >
        </p>
      </div>
      <div class="reveal-up">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand
    id="automation-cta-title"
    title="Welke terugkerende taak wil jij niet nóg een jaar handmatig doen?"
    text="Vertel kort wat er nu gebeurt, hoeveel tijd het kost en welke programma’s je gebruikt. Ik reageer meestal binnen één werkdag met de eerste vragen en een eerlijke inschatting."
    primary={{ label: 'Vraag mijn gratis procescheck aan', href: contactHref }}
    secondary={{
      label: 'Mail direct',
      href: `mailto:${CONTACT.email}?subject=Vraag over automatisering`,
    }}
    note="Geen verplichting. Geen automatische offerte. Eerst bepalen of automatiseren zinvol is."
  />
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────── */
  .auto-hero {
    padding: 0.5rem 0 0;
  }
  .auto-hero__stage {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 5vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .auto-hero__copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }
  .auto-hero__crumbs {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .auto-hero__back {
    min-height: 2.25rem;
    margin-bottom: 1rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .auto-hero__back:hover :global(svg) {
    transform: translateX(-4px);
  }
  .auto-hero__copy .kicker {
    margin-bottom: 1.1rem;
  }
  .auto-hero__copy h1 {
    max-width: 17ch;
    color: var(--ink);
    font-size: clamp(2.6rem, 1rem + 3.9vw, 5.2rem);
  }
  .auto-hero__copy .lead {
    max-width: 38rem;
    margin-top: 1.5rem;
  }
  .auto-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.1rem;
  }
  .auto-hero__copy .meta {
    margin-top: 1rem;
  }

  /* Avondlijst: een voorbeeld van wat de workflow ’s avonds al klaarzet. */
  .workflow-window {
    position: relative;
    z-index: 2;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }
  .workflow-window::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(120deg, transparent 25%, var(--vermilion-soft), transparent 65%);
    opacity: 0.7;
    transform: translateX(-100%);
  }
  .workflow-window__head,
  .workflow-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }
  .workflow-window__head {
    border-bottom: 1px solid var(--line);
    background: var(--paper-deep);
  }
  .workflow-window__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-weight: 600;
  }
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--vermilion);
    box-shadow: 0 0 0 5px var(--vermilion-soft);
  }
  .workflow-list {
    position: relative;
    margin: 0;
    padding: 0.6rem 1.25rem;
    list-style: none;
  }
  .workflow-list::before {
    content: '';
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 4.42rem;
    width: 1px;
    background: var(--line);
  }
  .workflow-list li {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.85rem;
  }
  .workflow-list li::before {
    content: '';
    position: absolute;
    left: 3.16rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--vermilion);
    border-radius: 50%;
    background: var(--paper-raised);
  }
  .workflow-list span,
  .workflow-list em {
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-style: normal;
  }
  .workflow-list strong {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .workflow-list em {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--vermilion-soft);
    color: var(--vermilion-ink);
    font-weight: 600;
  }
  .workflow-result {
    border-top: 1px solid var(--line);
    background: var(--stage);
    color: var(--stage-soft);
  }
  .workflow-result strong {
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(255, 141, 105, 0.55);
    border-radius: 0.4rem;
    color: #ff8d69;
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
    transform: rotate(-2deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .workflow-window::after {
      animation: workflow-scan 4.5s ease-in-out 1.2s infinite;
    }
    .workflow-list li {
      animation: workflow-row 0.55s var(--ease-out-soft) both;
      animation-delay: var(--flow-delay);
    }
    .status-dot {
      animation: status-pulse 2.5s ease-in-out infinite;
    }
  }
  @keyframes workflow-row {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes workflow-scan {
    0%,
    70% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  @keyframes status-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 5px var(--vermilion-soft);
    }
    50% {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  /* ── Geschikt / niet geschikt ───────────────────────────────────────────── */
  .fit-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 4rem;
  }
  .fit-split__item h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .fit-split__item p {
    max-width: 34rem;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .fit-icon {
    display: grid;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.75rem;
  }
  .fit-icon--yes {
    background: var(--vermilion-soft);
    color: var(--vermilion-ink);
  }
  .fit-icon--no {
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-size: 1.5rem;
  }

  /* ── Werkwijze: drie stappen in leesvolgorde ────────────────────────────── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
